# a class data sharing archive of the classes that signapk loads, which it starts faster with, made by signing
# framework-res.apk of the target files $3 with it in the directory $1
function make_signapk_jsa_in {
	unzip -p "$3" SYSTEM/framework/framework-res.apk > "$1/in.apk"
	java "${signapk_java_args[@]}" -XX:ArchiveClassesAtExit="$2" -Xlog:cds=off -Xlog:cds+dynamic=off -Djava.library.path="$otatools/lib64" -jar "$otatools/framework/signapk.jar" "$key_dir/releasekey.x509.pem" "$key_dir/releasekey.pk8" "$1/in.apk" "$1/out.apk"
}

function make_signapk_jsa {
