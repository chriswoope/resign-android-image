# the OTA was downloaded already to choose the otatools by, unless what was extracted from it was there, and
# discarded since
function download_ota {
	curl_ota
	if ! "$otatools/bin/check_ota_package_signature" "$ota_cert" "$ota_zip"; then
		echo "Failed to verify OTA update signature of $ota_zip!" >&2
		remove_bad_download "$ota_zip"
		exit 1
	fi
	touch "$1"
}

# set debugfs_quote to $1 quoted as one argument of a debugfs command, which splits its arguments at spaces
# except within double quotes, inside which "" stands for a double quote
function debugfs_quote {
	debugfs_quote="\"${1//\"/\"\"}\""
}

function extract_image {
	local out="$1"
	local img="$2"

	debugfs_quote "$(realpath "$out")"
	# with what it prints discarded, since it warns about every file whose owner it can't set; it doesn't fail
	# for any error anyway, so make_extract_fs checks its output before anything modifies the files
	"$debugfs" -R "rdump / $debugfs_quote" "$img" 2>/dev/null
}

function get_avbtool_vbmeta_opts {
	"$otatools"/bin/avbtool info_image --image "$1"|sed -nre 's/^\s*Rollback Index:\s*(.*)/--rollback_index \1/p; s/^\s*Rollback Index Location:\s*(.*)/--rollback_index_location \1/p'
}

# what avbtool tells of image $1 and its footer, which includes the digest of the image, but for the
# version of avbtool that made the footer, which is the one of otatools rather than the one of the build
function get_avb_info {
	"$otatools"/bin/avbtool info_image --image "$1"|grep -v '^Release String:'
}

function get_avbtool_partitions {
	"$otatools"/bin/avbtool info_image --image "$1"|sed -nre 's/^\s*Partition Name:\s*(.*)/\1/p'
}

function make_extract_fs {
	extract_image "$@"
	python3 "$data_dir/target_files_inputs.py" fs-extracted-verify "$2" "$1"

	if test -n "$dev_fast_sign"; then
		find "$1" -type f \( -iname '*.apk' -o -iname '*.apex' -o -iname '*.capex' \) ! -name framework-res.apk -delete
	fi
}

function extract_system {
	find "$2"/system -mindepth 1 -maxdepth 1 -print0|xargs -0 mv --target-directory="$1"
}

function extract_root {
	find "$2"/system -mindepth 1 -maxdepth 1 -print0|xargs -0 rm -rf
	# the directories, which can only be moved when writable, rather than whatever the symbolic links
	# point to on the host
	find "$2" -mindepth 1 -maxdepth 1 -type d -exec chmod u+w -- {} +
	find "$2" -mindepth 1 -maxdepth 1 -print0|xargs -0 mv --target-directory="$1"
	chmod u-w "$1"/config
}

function extract_root_and_system {
	local work="$1"
	shift
	make_extract_fs "$work" "$@"
	make_dir "$outdir/target_files_extracted/SYSTEM" extract_system "$work"
	make_dir "$outdir/target_files_extracted/ROOT" extract_root "$work"
}

function make_extract_ota {
	# the payload is read where it is in the zip
	unzip -q -d "$1" "$ota_zip" -x payload.bin
}

function make_extract_ota_payload {
	with_lock "$ota_zip" make_file "$ota_zip.ok" download_ota
	make_dir "$dir/ota" make_extract_ota

	make_dir "$dir/ota_meta" do_extract_ota_manifest "$ota_zip"

	do_extract_ota_payload "$1" "$ota_zip" "$dir/ota_meta/ab_partitions.txt"
	mkdir -p "$1/META"
	python3 "$data_dir/ota_payload_to_meta.py" -o "$1/META" "$ota_zip"
	discard_download "$ota_zip"
}

function extract_postinstall_config {
	do_extract_ota_manifest "$1" "$ota_zip"
	mv -- "$1/postinstall_config.txt" "$2"
}

# the postinstall config of the OTA, which an ota_meta made before it was extracted along with the rest lacks
function make_postinstall_config {
	with_lock "$ota_zip" make_file "$ota_zip.ok" download_ota
	with_temp_dir "$1.meta" extract_postinstall_config "$1"
	discard_download "$ota_zip"
}

function make_target_files_extracted {
	make_dir "$dir/ota_payload" make_extract_ota_payload

	#mkdir "$1/META"
	#ls -1 "$dir/ota_payload"|sed -re 's/\.img$//'>"$1/META/ab_partitions.txt"
	#get_avbtool_partitions "$dir/ota_payload/vbmeta.img">"$1/META/ab_partitions.txt"

	mkdir -p "$outdir/target_files_extracted"

	if test "$build_method" == vbmeta; then
		mkdir -p "$outdir/target_files_extracted/IMAGES"
		for i in "$dir/ota_payload"/*; do
			i="${i##*/}"
			if test "$i" == vbmeta.img; then
				"$otatools/bin/avbtool" make_vbmeta_image --padding_size 4096 --algorithm "$avb_algorithm" --key "$key_dir/avb.pem" --output "$outdir/target_files_extracted/IMAGES/vbmeta.img" --include_descriptors_from_image "$dir/ota_payload/vbmeta.img" $(get_avbtool_vbmeta_opts "$dir/ota_payload/vbmeta.img")
			elif test -f "$dir/ota_payload/$i"; then
				make_file "$outdir/target_files_extracted/IMAGES/$i" make_hardlink "$dir/ota_payload/$i"
			fi
		done
	fi

	# the images are read by one process each, --threads of them at the same time, since reading them all
	# at once, along with dumping their metadata, can take more memory than there is
	local background_pids=() background_limit="$threads"
	for b in $image_parts; do
		if test "$b" != system && test -e "$dir/ota_payload/$b.img"; then
			d="$(echo "$b"|tr a-z A-Z)"
			background make_dir "$outdir/target_files_extracted/$d" make_extract_fs "$dir/ota_payload/$b.img"
		fi
	done

	if ! test -e "$outdir/target_files_extracted/SYSTEM" || ! test -e "$outdir/target_files_extracted/ROOT"; then
		background with_temp_dir "$outdir/extract_root_and_system" extract_root_and_system "$dir/ota_payload/system.img"
	fi

	if test "$build_method" == resign; then
		# the owner, mode, capabilities and SELinux label of the files, which extracting the files
		# doesn't keep and the images are going to be rebuilt with
		mkdir -p "$outdir/fs_metadata"
		for b in $image_parts; do
			if test -e "$dir/ota_payload/$b.img"; then
				background make_file "$outdir/fs_metadata/$b.json" dump_fs_metadata "$dir/ota_payload/$b.img"
			fi
		done
		background make_dir "$outdir/boot_inputs" make_boot_inputs
	fi

	wait_background

	touch "$1"
}

function dump_fs_metadata {
	python3 "$data_dir/target_files_inputs.py" fs-dump "$2" > "$1"
}

# write to $1 the target files directories and files that the boot images are built from, the
# misc_info.txt entries they are built with and what they are expected to be like once built
function make_boot_inputs {
	local args=() b
	for b in boot init_boot vendor_boot vendor_kernel_boot; do
		# a boot image given with --replace-boot is used as a prebuilt one
		if test -e "$dir/ota_payload/$b.img" && ! [[ $b == boot && -n $replace_boot ]]; then
			args+=("$b" "$dir/ota_payload/$b.img")
		fi
	done
	python3 "$data_dir/target_files_inputs.py" boot-inputs "$1" "${args[@]}"
}

function deapexer {
	"$otatools/bin/deapexer" --blkid_path "$blkid" --debugfs_path "$debugfs" --fsckerofs_path "$fsckerofs" "$@"
}

# remove from an extracted APEX payload the files that apexer adds back itself when it builds one
function remove_apex_manifests {
	local i
	for i in apex_manifest.pb apex_manifest.json lost+found; do
		if test -d "$1/$i"; then
			rmdir "$1/$i"
		else
			rm -f "$1/$i"
		fi
	done
}

# print the name, the type, the mode, the size and either the target or the contents of every file of a
# directory tree, sorted and NUL separated so that any file name works, to compare two trees by
# everything that extracting an APEX payload preserves
function tree_manifest {
	(
		cd "$1"
		find . -mindepth 1 -printf '%p %y %#m %s %l\0'|sort -z
		find . -mindepth 1 -type f -print0|sort -z|xargs -0 -r sha256sum
	)
}

# compress the APEX $2 into $3 from a copy of it in the directory $1, which is in the temporary directory, since
# apex_compression_tool makes a hard link to its input there
function compress_apex_in {
	cp -a "$2" "$1/in.apex"
	"$otatools/bin/apex_compression_tool" compress --apex_compression_tool_path "$otatools/bin:$PATH" --input "$1/in.apex" --output "$3"
}

function patch_apex {
	local work="$1"
	local out="$2"
	local apex="$3"
	local cmd="$4"
	shift 4

	local type args=() modded_apex_r
	type="$(deapexer info --print-type "$apex")"
	if test "$type" == COMPRESSED; then
		deapexer decompress --input "$apex" --output "$work"/original.apex
	else
		ln "$apex" "$work"/original.apex
	fi

	deapexer extract "$work"/original.apex "$work"/payload
	remove_apex_manifests "$work/payload"

	"$cmd" "$work/payload" "$@"

	unzip -q -x -d "$work/apex" "$work"/original.apex

	# apexer takes the SELinux file contexts, the uid, gid and mode of every file and the type of the
	# filesystem to build from the build info of the original APEX, which is the only thing that can
	# restore what extracting the payload dropped: deapexer restores neither the owners nor the
	# extended attributes, so without it the repacked APEX would silently lose every SELinux label
	# (which is how the bpf programs of the tethering APEX are allowed to be loaded) and the setuid
	# bit and owner of files like its bin/for-system/clatd
	if ! test -e "$work/apex/apex_build_info.pb"; then
		echo "$apex has no apex_build_info.pb, so it cannot be repacked without losing the file contexts and ownership of its payload" >&2
		exit 1
	fi

	if test -e "$work/apex/apex_manifest.json"; then
		args+=(--manifest_json "$work/apex/apex_manifest.json")
	fi
	# apexer signs the payload with SHA256_RSA4096 whatever the key, so pass the algorithm of the AVB key
	# on to avbtool, which takes the last --algorithm it is given
	"$otatools/bin/apexer" --force --payload_only --do_not_check_keyname --key "$key_dir"/avb.pem --signing_args "--algorithm $avb_algorithm" --apexer_tool_path "$otatools/bin:$PATH" --manifest "$work/apex/apex_manifest.pb" --build_info "$work/apex/apex_build_info.pb" "${args[@]}" "$work/payload" "$work/apex_payload.img"

	cp "$work/original.apex" "$work/modded.apex"
	modded_apex_r="$(realpath "$work/modded.apex")"
	(cd "$work" && zip -0 "$modded_apex_r" apex_payload.img)
	# apexd mounts the payload out of the APEX where it is, so it has to stay page aligned in it
	"$otatools/bin/zipalign" -f 4096 "$work/modded.apex" "$work/aligned.apex"

	# extracting the repacked APEX again has to give back exactly what apexer was given, so that a
	# payload that lost a file, a symbolic link, a permission bit or a byte on the way makes the build
	# fail rather than the device not boot
	deapexer extract "$work/aligned.apex" "$work/repacked"
	remove_apex_manifests "$work/repacked"
	if ! cmp -s <(tree_manifest "$work/payload") <(tree_manifest "$work/repacked"); then
		echo "Repacking $apex did not preserve its payload:" >&2
		# the manifests are NUL separated to hold any file name, so make them printable to show them
		diff <(tree_manifest "$work/payload"|tr '\0' '\n') <(tree_manifest "$work/repacked"|tr '\0' '\n') >&2 || true
		exit 1
	fi

	# the SELinux label of each file is the one thing that extracting the payload doesn't keep, and it
	# is what allows the bpf programs of the tethering APEX to be loaded at boot, so compare the labels
	# in the images themselves; deapexer can only list an ext4 payload, whose superblock holds the
	# 0x53ef magic at offset 0x438, rather than an erofs or f2fs one
	if test "$(dd if="$work/apex/apex_payload.img" bs=1 skip=$((0x438)) count=2 status=none)" == $'\xef\x53'; then
		if ! diff <(deapexer list -Z "$work/original.apex"|sort) <(deapexer list -Z "$work/aligned.apex"|sort) >&2; then
			echo "Repacking $apex changed the SELinux labels of its payload" >&2
			exit 1
		fi
	fi

	if test "$type" == COMPRESSED; then
		with_temp_dir "${TMPDIR:-/tmp}/compress-apex" compress_apex_in "$work/aligned.apex" "$work/out.apex"
	else
		ln "$work"/aligned.apex "$work/out.apex"
	fi
	ln -f "$work/out.apex" "$out"
}


function patch_adbd {
	# the patched bytes are written into the output, which is the input itself when adbd is patched
	# where it is inside an APEX payload or a ramdisk, and otherwise a copy of it
	if test "$1" != "$2"; then
		cp -a "$2" "$1"
	fi

	# the calls are found by their address in memory, which lld doesn't keep equal to their offset in
	# the file, so the loadable segments are needed to turn one into the other
	local -a seg_off=() seg_addr=() seg_size=()
	local type off addr size
	while read -r type off addr _ size _; do
		if test "$type" == LOAD; then
			seg_off+=("$off")
			seg_addr+=("$addr")
			seg_size+=("$size")
		fi
	done < <(llvm-readelf -lW "$2")
	wait $!

	# non-LLVM objdump fails to annotate calls to the PLT with the symbol name, and LLVM 17 and later
	# print an AArch64 instruction as a single word rather than as four bytes
	local call_re='^\s*([0-9a-f]+):\s*([0-9a-f]{8}|[0-9a-f]{2}( [0-9a-f]{2}){3})\s+bl\s+0x[0-9a-f]+\s+<__android_log_is_debuggable@plt>$'
	local -i patched=0
	local call i
	while read -r call; do
		for i in "${!seg_addr[@]}"; do
			if (( 0x$call >= seg_addr[i] && 0x$call < seg_addr[i] + seg_size[i] )); then
				# mov w0,#0x1
				printf '\x20\x00\x80\x52'|dd of="$1" bs=1 seek=$((0x$call - seg_addr[i] + seg_off[i])) conv=notrunc status=none
				patched+=1
			fi
		done
	done < <(llvm-objdump -d "$2"|sed -nre "s/$call_re/\1/p")
	wait $!

	# an adbd left unpatched builds and boots fine, and only refuses to restart as root on the device,
	# so a change in the disassembly or in adbd must make the build fail instead
	if test "$patched" == 0; then
		echo "Found no call to __android_log_is_debuggable to patch in $2" >&2
		exit 1
	fi
	if llvm-objdump -d "$1"|grep -E "$call_re" >&2; then
		echo "Patching $1 left the calls to __android_log_is_debuggable above in place" >&2
		exit 1
	fi
}

function patch_adbd_in_root {
	local root
	for root in "$@"; do
		patch_adbd "$root/bin/adbd" "$root/bin/adbd"
	done
}

# bodies of the methods replaced below, as instructions for patch_dex.py
dex_return_false=$'const/4 v0, 0\nreturn v0'
dex_return_void='return-void'
# an allocated list first, since the caller of a method that used to return a list it had just built can
# expect to be able to modify it, and the immutable one only if the dex doesn't refer to ArrayList
dex_return_empty_list=$'new-instance v0, Ljava/util/ArrayList;\ninvoke-direct {v0}, Ljava/util/ArrayList;.<init>:()V\nreturn-object v0\nor\ninvoke-static {}, Ljava/util/Collections;.emptyList:()Ljava/util/List;\nmove-result-object v0\nreturn-object v0'

# patch the code in the dex files, or the strings of the resources, of a jar or an APK by binary-patching
# them where they are inside it rather than disassembling and reassembling them with apktool or even taking
# them out of the zip and putting them back, so that nothing but the patched instructions or strings
# changes: $1 is the zip to write, $2 is the zip to patch, which can be the same file, and the remaining
# arguments are the edits to apply, three arguments each, as documented in patch_dex.py
function patch_dex_in_zip {
	local out="$1"
	local in_zip="$2"
	shift 2

	if test "$out" != "$in_zip"; then
		cp -a "$in_zip" "$out"
	fi

	# the edits are passed on stdin since there can be any number of them
	printf '%s\0' "$@"|python3 "$data_dir/patch_dex.py" "$dexpreopt_tools/dexdump" "$out"
}

# make WindowState.isSecureLocked() always return false so that FLAG_SECURE windows (and any other
# app or policy request to block screen capture) are treated as non-secure: this is the single point
# the window manager uses to mark a window's surface as secure, so screenshots, screen recording and
# casting can then always capture every window
patch_window_secure=(method 'WindowState.isSecureLocked:()Z' "$dex_return_false")

# make ActivityRecord.shouldUseAppThemeSnapshot() always return false so that the task snapshot used for
# the recents/app switcher preview is always a real screenshot of the activity. An app can blank that
# preview without setting FLAG_SECURE at all, by calling Activity.setRecentsScreenshotEnabled(false)
# (Activity.setDisablePreviewScreenshots() before Android 13), which only sets the flag that this method
# reads; the method also returns true for activities with a secure window, which patch_window_secure
# already takes care of
patch_recents_screenshot=(method 'ActivityRecord.shouldUseAppThemeSnapshot:()Z' "$dex_return_false")

# make WindowManagerService.notifyScreenshotListeners() always return an empty list so that no app is ever
# told that a screenshot of it was taken. Android 14 added Activity.registerScreenCaptureCallback(), which
# apps use to log the user out or nag them for exercising control over their own device; this method is
# where the window manager both dispatches the callback to the activities on the display and reports back
# which ones it notified, so emptying it stops the notification at its source while leaving registration
# working, so that nothing an app does throws
patch_screenshot_listeners=(method 'WindowManagerService.notifyScreenshotListeners:(I)Ljava/util/List;' "$dex_return_empty_list")

# make WindowManagerService.registerScreenRecordingCallback() always return false so that no app is ever
# told that the screen is being recorded. Android 15 added Activity.registerScreenRecordingCallback(), the
# screen recording counterpart of the screenshot detection neutered by patch_screenshot_listeners, which
# ScreenRecordingCallbackController implements by watching MediaProjection and calling
# onScreenRecordingStateChanged() on every registered callback. The return value is the current recording
# state, so returning false both refuses the registration and reports that no recording is in progress
patch_screen_recording_callback=(method 'WindowManagerService.registerScreenRecordingCallback:(Landroid/window/IScreenRecordingCallback;)Z' "$dex_return_false")

# make SurfaceView.setSecure() a no-op. It is the only way an app can get a secure surface without setting
# FLAG_SECURE on its window: it sets the SurfaceControl.SECURE flag on the SurfaceView's own surface
# directly, in the app's own process, which is why this must be patched in framework.jar rather than
# alongside patch_window_secure in services.jar. The other ways of setting that flag,
# SurfaceControl.Builder.setSecure() and SurfaceControl.Transaction.setSecure(), are hidden API that
# ordinary apps cannot reach.
#
# This is why it is a separate option from --always-screenshot rather than part of it: a player of
# DRM-protected video calls SurfaceView.setSecure(true) precisely because a hardware DRM (Widevine L1)
# secure decoder can only output into a surface whose SurfaceControl is secure, so taking that away makes
# such playback fail or fall back to a software (L3) path with a lower resolution. There is no way to keep
# only half of the flag: it is the same bit that makes the surface accept hardware-protected buffers and
# that excludes it from screen capture. Removing it also doesn't make the protected video capturable
# anyway, since a hardware-protected buffer is unreadable by the compositor no matter what any flag says;
# what it does gain is capturing the surfaces of apps that use setSecure() with ordinary, unprotected
# content, purely to stop the user from taking a screenshot
patch_surface_secure=(method 'SurfaceView.setSecure:(Z)V' "$dex_return_void")

# make injected mock/test-provider locations indistinguishable from real ones. The system server's mock
# location provider marks every Location it injects by calling Location.setIsFromMockProvider(true),
# which is the only thing that sets the HAS_MOCK_PROVIDER_MASK bit later read back by Location.isMock()
# and Location.isFromMockProvider() and carried across the Binder parcel to every app. Replace every one
# of those calls with nops so the bit is never set at the source, leaving nothing for an app to detect;
# what is left behind is the code computing the arguments of the call into registers that nothing reads
# any more, which is harmless. The disassembly of such a call looks like
#     invoke-virtual {v0, v1}, Landroid/location/Location;.setIsFromMockProvider:(Z)V // method@1234
patch_location_mock=(replace 'invoke-virtual(/range)? \{[^}]*\}, Landroid/location/Location;\.setIsFromMockProvider:\(Z\)V.*' '')

# make every app's playback capturable through the AudioPlaybackCapture (MediaProjection) API regardless
# of whether the app opted out. AudioAttributes.capturePolicyToFlags() is the single point that turns a
# capture policy into the FLAG_NO_MEDIA_PROJECTION (0x400) and FLAG_NO_SYSTEM_CAPTURE (0x1000) attribute
# flags that the audio server reads to refuse capture. Both ways of opting out funnel through it: an app
# setting a policy on its own AudioAttributes via setAllowedCapturePolicy(), and the per-process policy
# derived from the app's manifest android:allowAudioPlaybackCapture flag, which AudioService turns into
# flags with this same method. Rewrite it to always clear both flags (i.e. behave as ALLOW_CAPTURE_BY_ALL
# for everyone) so a recording app can capture the output of any app whose audio goes through the software
# mixer, including VoIP/communication apps. Since framework.jar is loaded into every app process, this
# clears the flags in the process that plays the audio, which is where the audio server takes them from.
# (Audio of cellular phone calls travels a hardware path that never reaches the mixer and so cannot be
# captured by any software change.)
# p1 is the flags argument and -0x1401 == ~(0x400 | 0x1000)
patch_audio_capture_policy=(method 'AudioAttributes.capturePolicyToFlags:(II)I' $'const/16 v0, -0x1401\nand-int/2addr p1, v0\nreturn p1')

# apply dex patches to one of the jars in /system/framework: $1 is the target_files directory being
# built, $2 is the name of the jar and the remaining arguments are the edits to apply to it.
# Unlike the jars inside an APEX, these jars aren't APK-signed (their integrity comes from AVB), so they
# can be patched directly like a plain system file; what was compiled from them and against them is
# compiled again, or removed with --no-dex2oat, and their fs-verity metadata made again, once the target
# files are put together, see recompile-preopt, stale-preopt and fsverity-update in target_files_inputs.py
function patch_framework_jar {
	local out="$1"
	local jar="$2"
	shift 2

	if ! test -e "$outdir/target_files_extracted/SYSTEM/framework/$jar"; then
		echo "$jar not found in the system image, cannot patch it" >&2
		exit 1
	fi

	mkdir -p "$out/SYSTEM/framework"
	patch_dex_in_zip {"$out","$outdir/target_files_extracted"}/SYSTEM/framework/"$jar" "$@"
}

function patch_service_connectivity {
	local jar="$1/javalib/service-connectivity.jar"
	if ! test -e "$jar"; then
		echo "service-connectivity.jar not found in the tethering APEX" >&2
		exit 1
	fi

	# make BpfNetMaps$Dependencies.isLoopbackChecksEnabled() return false so that the loopback checks
	# introduced in Android 17 are never enforced
	patch_dex_in_zip "$jar" "$jar" method 'BpfNetMaps$Dependencies.isLoopbackChecksEnabled:()Z' "$dex_return_false"
}

# set dex2oat_runner to the command that the dex2oat of the dexpreopt tools is to be run with, if any, having
# checked that it works and reproduces what dexpreopt compiled in the target files directory $1. In gVisor,
# whose platforms that take the GS register for themselves make the runtime in dex2oat abort as it starts, it
# is run with qemu-user, which emulates the register, if it doesn't work as it is
function dex2oat_runner {
	dex2oat_runner=
	# not in a pipeline, whose status would be the one of dmesg being killed by grep having found the line
	if grep -q '^\[ *[0-9.]*\] Starting gVisor\.\.\.$' < <(dmesg 2>/dev/null); then
		local log="$outdir/dex2oat-gvisor.log"
		if python3 "$data_dir/target_files_inputs.py" preopt-check "$1" "$dexpreopt_tools" "" > "$log" 2>&1; then
			cat "$log"
			return
		fi
		echo "dex2oat doesn't work in this gVisor sandbox, see $log, so it is run with qemu-user" >&2
		if ! which qemu-x86_64 >/dev/null; then
			sudo apt-get -y install qemu-user
		fi
		dex2oat_runner="$(which qemu-x86_64)"
	fi
	python3 "$data_dir/target_files_inputs.py" preopt-check "$1" "$dexpreopt_tools" "$dex2oat_runner"
}

function make_target_files_intermediates_base {
	make_file "$outdir/target_files_extracted.done" make_target_files_extracted

	# the files are patched at the same time, since each of them takes a while
	local background_pids=()
	# the paths in the target files of the APKs and jars whose dex code is patched, going on into the
	# payload of an APEX for the jars in one, which makes what was compiled from them and against them
	# stale; the Updater is left out since only its resources are
	local patched_dex=()

	if test "$update_url" != "$orig_update_url"; then
		mkdir -p "$1/SYSTEM/priv-app/Updater"
		# the URL is replaced as the bytes it is, which are as many, where the resources are in the APK
		background patch_dex_in_zip {"$1","$outdir/target_files_extracted"}/SYSTEM/priv-app/Updater/Updater.apk resource-string "$orig_update_url" "$update_url"
	fi

	if test -n "$adb_root"; then
		for i in SYSTEM/apex/com.android.adbd.apex SYSTEM/apex/com.android.adbd.capex; do
			if test -e "$outdir/target_files_extracted/$i"; then
				mkdir -p "$1/SYSTEM/apex"
				background with_temp_dir "$outdir/patch-adbd-apex" patch_apex {"$1","$outdir/target_files_extracted"}/"$i" patch_adbd_in_root
			fi
		done
		if test -e "$outdir/target_files_extracted/SYSTEM/bin/adbd"; then
			mkdir -p "$1/SYSTEM/bin"
			background patch_adbd {"$1","$outdir/target_files_extracted"}/SYSTEM/bin/adbd
		fi
	fi

	if test -n "$adb_keys_content"; then
		# adbd only ever looks for keys in /adb_keys and in /data/misc/adb/adb_keys, and the latter is
		# wiped along with the user data and can only be written by a device that boots far enough to
		# show the authorization dialog, so the keys go in the former, which on a system-as-root device
		# is a file at the root of the system image. The SELinux policy of the build labeling it is how
		# we check that this Android version still reads the file
		if ! grep -qE '^/adb_keys\s' "$outdir/target_files_extracted/SYSTEM/etc/selinux/plat_file_contexts"; then
			echo "The SELinux file contexts have no entry for /adb_keys, so adbd would not be allowed to read it" >&2
			exit 1
		fi
		mkdir -p "$1/ROOT"
		# in the unlikely case that the build ships keys of its own, keep them
		if test -e "$outdir/target_files_extracted/ROOT/adb_keys"; then
			cat "$outdir/target_files_extracted/ROOT/adb_keys" > "$1/ROOT/adb_keys"
		fi
		printf '%s' "$adb_keys_content" >> "$1/ROOT/adb_keys"
	fi

	if test -n "$adb_at_boot"; then
		# the USB-C port setting of GrapheneOS is stored in a property, whose name is checked here so
		# that a rename doesn't silently leave the data lines cut for the whole of the boot to debug
		if ! grep -q -w persist.security.usb_mode "$outdir/target_files_extracted/SYSTEM/etc/selinux/plat_property_contexts"; then
			echo "Warning: the SELinux property contexts have no entry for persist.security.usb_mode, so this build may take the USB-C port mode from something else" >&2
		fi
		mkdir -p "$1/SYSTEM/etc/init"
		# init parses every .rc file in /system/etc/init
		cat > "$1/SYSTEM/etc/init/resign-adb.rc" <<'EOF'
# ADB at boot, added by resign-android-image --adb-at-boot

# turn ADB on as early as possible, so that a boot that hangs before the system server is up can be
# debugged as well
on early-init
    setprop sys.usb.config adb

on property:ro.persistent_properties.ready=true
    # the USB-C port setting of GrapheneOS, set once the persistent properties have been read from
    # /data since they would override it otherwise: 3 is "charging-only when locked, except before
    # first unlock", while the default of 2 cuts the USB data lines whenever the device is locked,
    # which includes the whole of a boot that never reaches an unlock. This is meant to override the
    # setting chosen in Settings at every boot, and to be written to /data like any change of it,
    # where it stays after going back to a build without --adb-at-boot: a boot that can't be debugged
    # because of a setting chosen since is what --adb-at-boot is there to rule out
    setprop persist.security.usb_mode 3

# turn USB debugging on the way a debuggable build does: init mirrors persist.sys.usb.config into
# sys.usb.config at boot, and the system server enables USB debugging from it, so ADB stays on after
# either takes over. This also turns on the adb_enabled setting, so USB debugging shows as on in
# Settings, and turning it off there only lasts until the next boot
on property:ro.persistent_properties.ready=true
    setprop persist.sys.usb.config adb
EOF
	fi

	if test -n "$cross_profile_localhost"; then
		local patched=
		for i in SYSTEM/apex/com.android.tethering.apex SYSTEM/apex/com.android.tethering.capex; do
			if test -e "$outdir/target_files_extracted/$i"; then
				mkdir -p "$1/SYSTEM/apex"
				background with_temp_dir "$outdir/patch-tethering-apex" patch_apex {"$1","$outdir/target_files_extracted"}/"$i" patch_service_connectivity
				patched_dex+=("$i/javalib/service-connectivity.jar")
				patched=1
			fi
		done
		if test -z "$patched"; then
			echo "Failed to find the tethering APEX containing service-connectivity.jar" >&2
			exit 1
		fi
	fi

	# collect the dex edits to apply to each of the jars in /system/framework and run each jar's edits in
	# a single pass, since separate passes would each start from the original jar and clobber the others'
	# output
	local services_jar_patches=()
	local framework_jar_patches=()
	if test -n "$always_screenshot"; then
		services_jar_patches+=("${patch_window_secure[@]}" "${patch_recents_screenshot[@]}" "${patch_screenshot_listeners[@]}" "${patch_screen_recording_callback[@]}")
	fi
	if test -n "$always_screenshot_surfaceview"; then
		framework_jar_patches+=("${patch_surface_secure[@]}")
	fi
	if test -n "$no_location_ismock"; then
		services_jar_patches+=("${patch_location_mock[@]}")
	fi
	if test -n "$record_anything"; then
		framework_jar_patches+=("${patch_audio_capture_policy[@]}")
	fi
	if test "${#services_jar_patches[@]}" != 0; then
		background patch_framework_jar "$1" services.jar "${services_jar_patches[@]}"
		patched_dex+=(SYSTEM/framework/services.jar)
	fi
	if test "${#framework_jar_patches[@]}" != 0; then
		background patch_framework_jar "$1" framework.jar "${framework_jar_patches[@]}"
		patched_dex+=(SYSTEM/framework/framework.jar)
	fi

	wait_background

	# the files patched above are skipped, which makes cp -n fail in coreutils 9.2 to 9.4, while --update=none,
	# which skips them as silently as -n did before and does again since, only exists since 9.3
	local no_clobber=--update=none
	if ! cp --update=none --version >/dev/null 2>&1; then
		no_clobber=-n
	fi
	cp -a "$no_clobber" -l --target-directory="$1" "$outdir/target_files_extracted"/*

	if test "$build_method" == resign; then
		cp -a "$no_clobber" -l --target-directory="$1" "$outdir/boot_inputs/target_files"/*
		# the runtime rejects compiled code that no longer matches what it was compiled from or against
		# and odrefresh only compiles the boot image and the system server jars again when the files
		# compiled from them are missing, so a stale boot image leaves every process without one: it is
		# compiled again, or removed for the device to compile it
		if test "${#patched_dex[@]}" != 0; then
			if test -n "$dex2oat"; then
				dex2oat_runner "$outdir/target_files_extracted"
				python3 "$data_dir/target_files_inputs.py" recompile-preopt "$1" "$outdir/target_files_extracted" "$dexpreopt_tools" "$dex2oat_runner" "$threads" "${patched_dex[@]}"
			else
				python3 "$data_dir/target_files_inputs.py" stale-preopt "$1" "${patched_dex[@]}"
			fi
		fi
		# the images are built out of these files by the signing
		apply_modifications "$1"
		# with the fs-verity metadata of the files that CompOS compiles from, as the build makes it, for
		# the files changed or removed above
		python3 "$data_dir/target_files_inputs.py" fsverity-update "$1"
	fi
}


function make_misc_info {
	if false; then
	cat ->"$1" <<EOF
recovery_api_version=99999
fstab_version=2
ab_update=true
verity=true
avb_enable=true
lz4_ramdisks=true
avb_avbtool=avbtool
EOF
	else
		# TODO: properly create this instead of copying one from a raven build from source and hoping it works
		grep -vE 'selinux_fc=|vintf_enforce=|^building_|^avb_building_' "$data_dir/misc_info-raven.txt" > "$1"
		# and the dynamic partitions as the payload has them, since the last value of an entry is the
		# one that counts and those of the build misc_info-raven.txt comes from are not the same
		cat "$dir/ota_payload/META/misc_info.txt" "$dir/ota_payload/META/dynamic_partitions_info.txt" >> "$1"
		if test -e "$dir/ota_payload/init_boot.img"; then
			echo "init_boot=true" >> "$1"
			echo "init_boot_size=$(stat -c "%s" -- "$dir/ota_payload/init_boot.img")" >> "$1"
		fi
	fi

	if test "$build_method" == resign; then
		# have the signing build the filesystem images out of their files, as it does for a normal
		# build, and give them the same hashtree footer as the original images
		local dynamic=" $(sed -nre 's/^dynamic_partition_list=//p' "$dir/ota_payload/META/dynamic_partitions_info.txt") "
		local b
		for b in $image_parts; do
			if test -e "$dir/ota_payload/$b.img"; then
				printf '%s\n' "building_${b}_image=true" "${b}_fs_type=ext4" "${b}_selinux_fc=file_contexts.bin" "${b}_disable_sparse=true" >> "$1"
				python3 "$data_dir/target_files_inputs.py" avb-args "$b" "$dir/ota_payload/$b.img" >> "$1"
				# the size of a dynamic partition is the size of its image, while the AVB footer of the
				# image of any other partition must be at the end of the partition
				if [[ $dynamic != *" $b "* ]]; then
					echo "${b}_size=$(stat -c %s -- "$dir/ota_payload/$b.img")" >> "$1"
				fi
			fi
		done

		# and the boot images and vbmeta, with the dtbo and pvmfw images taken as prebuilt ones that the
		# build adds a footer to
		cat "$outdir/boot_inputs/misc_info.txt" >> "$1"
		if test -e "$dir/ota_payload/dtbo.img"; then
			python3 "$data_dir/target_files_inputs.py" avb-args dtbo "$dir/ota_payload/dtbo.img" >> "$1"
		fi
		if test -e "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw.img"; then
			echo has_pvmfw=true >> "$1"
			python3 "$data_dir/target_files_inputs.py" avb-args pvmfw "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw.img" >> "$1"
		fi
		if test -n "$replace_boot"; then
			python3 "$data_dir/target_files_inputs.py" avb-args boot "$dir/ota_payload/boot.img" >> "$1"
		fi
		check_vbmeta_partitions
		printf '%s\n' avb_building_vbmeta_image=true "avb_vbmeta_args=--padding_size 4096 $(get_avbtool_vbmeta_opts "$dir/ota_payload/vbmeta.img"|tr '\n' ' ')" >> "$1"
		# the fingerprints in the AVB properties that the images are given, which are those of the
		# original images, have the build number of the version, as the ones of the build.prop files do
		if test -n "$build_number_sed"; then
			sed -i -re "/^avb_[a-z0-9_]+_args=/ $build_number_sed" "$1"
		fi
	fi
}

# check that vbmeta only verifies partitions that the signing builds the images of, as for a normal build
function check_vbmeta_partitions {
	if [[ $("$otatools/bin/avbtool" info_image --image "$dir/ota_payload/vbmeta.img") == *"Chain Partition descriptor"* ]]; then
		echo "vbmeta chains to other vbmeta images, which is not supported" >&2
		exit 1
	fi
	local p
	for p in $(get_avbtool_partitions "$dir/ota_payload/vbmeta.img"); do
		if ! [[ " $signed_images " == *" $p "* ]]; then
			echo "vbmeta verifies $p, which there is no way to build the image of" >&2
			exit 1
		fi
	done
}

# write the fs_config and file_contexts files that the images are going to be built with, so that the
# files have the metadata they have in the original images, and the metadata the built images are
# expected to have to $1
function make_fs_config {
	local args=() b
	for b in $image_parts; do
		if test -e "$outdir/fs_metadata/$b.json"; then
			args+=("$b" "$outdir/fs_metadata/$b.json")
		fi
	done
	python3 "$data_dir/target_files_inputs.py" fs-config "$outdir/target_files_intermediates" "$1" "${args[@]}"
}

function make_dynamic_partitions_info {
	cp "$dir"/ota_payload/META/dynamic_partitions_info.txt "$1"
}

# print the line of certs.txt of the certificate $1, in hex DER, of the key $2
function print_cert_line {
	local digest
	digest="$(xxd -p -r <<< "$1"|sha256sum)"
	printf '%s %s %s\n' "${digest%% *}" "$1" "$2"
}

function make_certs_mac {
	local f i v k shared=
	find "$outdir"/target_files_intermediates -name '*mac_permissions.xml' -print0|while IFS= read -r -d '' f; do
		while read -r i v; do
			case "$v" in
				# the first one of all the files is taken for the shared key, the others for the test key
				base) if test -z "$shared"; then k=shared; shared=1; else k=testkey; fi ;;
				network_stack) k=networkstack ;;
				media|platform|bluetooth) k="$v" ;;
				*) continue ;;
			esac
			print_cert_line "$i" "$k"
		done < <({ grep --only-matching -E 'signature="[^"]*"><seinfo value="[^"]*"' "$f" || test "$?" == 1; }|sed -re 's/^signature="([^"]*)".* value="([^"]*)"/\1 \2/')
		wait $!
	done|sort -u > "$1"
}

function make_certs {
	(
		cat "$outdir/certs_mac.txt"
		# TODO: any better way of getting the shared key?
		for k in testkey shared platform media networkstack bluetooth; do
			if ! grep -q "$k" "$outdir/certs_mac.txt"; then
				i="$(if test "$k" == testkey; then
					bsdtar -x -f "$outdir"/target_files_extracted/SYSTEM/etc/security/otacerts.zip -O keys/releasekey.x509.pem
				elif test "$k" == shared; then
					"$otatools/bin/apksigner" verify --print-certs-pem "$outdir"/target_files_extracted/PRODUCT/priv-app/Contacts/Contacts.apk
				else
					echo "Missing original key hash for $k in mac_permissions" >&2
					exit 1
				fi|openssl x509 -in /dev/stdin -inform PEM -outform DER|xxd -p -c 999999999)"
				test -n "$i" || exit 1
				print_cert_line "$i" "$k"
			fi
		done
	)|sort|uniq>"$1"
}

function make_product_security {
	while read h c k; do echo "$c"|xxd -p -r|openssl x509 -in /dev/stdin -inform DER -outform PEM > "$1/$k.x509.pem"; done < "$outdir"/certs.txt
}


function make_apk_keys {
	python3 "$data_dir/target_files_inputs.py" apk-keys "$outdir/target_files_extracted" "$outdir/certs.txt" "$1"
}

function make_otakeys {
	touch "$1"
}

function make_hardlink {
	rm -f "$1"
	ln "$2" "$1"
}

# the payload versions that the update_engine of the build takes, which the build copies into the target files,
# for an incremental OTA from them to be made with
function make_update_engine_config {
	cp "$aosp/system/update_engine/update_engine.conf" "$1"
}

# Check the replacement with the same verifier as rebuilt boot images. Only explicitly allowed
# ramdisk contents and additions may differ; the kernel, header and existing metadata must match.
function make_replaced_boot {
	local extra=() b
	if test -n "$replace_boot_allow_new_files"; then
		extra+=(--allow-new-files)
	fi
	# whose ramdisks the kernel unpacks the one of boot over, so that a file new to it can replace one of
	# theirs, like those of the recovery in vendor_boot, which must then be allowed to change explicitly
	for b in vendor_boot vendor_kernel_boot init_boot; do
		if test -e "$dir/ota_payload/$b.img"; then
			extra+=(--loaded-with "$dir/ota_payload/$b.img")
		fi
	done
	printf '%s\0' "${replace_boot_allow_change[@]}"|python3 "$data_dir/target_files_inputs.py" boot-verify "$replace_boot" "$2" --allow-additions "${extra[@]}"
	cp -- "$replace_boot" "$1"
}

# the public key of the payload of the virt APEX of the original images, which pvmfw has embedded to
# verify it with, and which the signing replaces with the key it signs the APEX with
function make_pvmfw_embedded_avbpubkey {
	local apex
	apex="$(find "$outdir/target_files_extracted" -regextype posix-extended -regex '.*/apex/com\.([^./]+\.)?android\.virt\.c?apex' -print -quit)"
	if test -z "$apex"; then
		echo "Failed to find the virt APEX, whose key pvmfw embeds" >&2
		exit 1
	fi
	if [[ $apex == *.capex ]]; then
		unzip -p "$apex" original_apex|bsdtar -x -O -f - apex_pubkey > "$1"
	else
		unzip -p "$apex" apex_pubkey > "$1"
	fi
}

function make_target_files_intermediates {
	make_dir "$outdir/target_files_intermediates" make_target_files_intermediates_base
	make_file "$outdir/certs_mac.txt" make_certs_mac
	make_file "$outdir/certs.txt" make_certs
	make_dir "$outdir/product_security" make_product_security
	mkdir -p "$outdir/target_files_intermediates/META"
	make_dir "$outdir/apk_keys" make_apk_keys
	for i in apkcerts.txt apexkeys.txt; do
		make_file "$outdir/target_files_intermediates/META/$i" make_hardlink "$outdir/apk_keys/$i"
	done
	make_file "$outdir/target_files_intermediates/META/dynamic_partitions_info.txt" make_dynamic_partitions_info
	make_file "$outdir/target_files_intermediates/META/otakeys.txt" make_otakeys
	make_file "$outdir/target_files_intermediates/META/update_engine_config.txt" make_update_engine_config
	mkdir -p "$outdir/target_files_intermediates/PREBUILT_IMAGES"
	for i in dtbo boot init_boot; do
		# unless it is built from the files of its ramdisk
		if test -e "$dir/ota_payload/$i.img" && ! test -e "$outdir/boot_inputs/target_files/${i^^}"; then
			if test "$i" == boot && test -n "$replace_boot"; then
				make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/$i.img" make_replaced_boot "$dir/ota_payload/$i.img"
			else
				make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/$i.img" make_hardlink "$dir/ota_payload/$i.img"
			fi
		fi
	done
	if test "$build_method" == rebuild; then
		cp -f "$dir/ota_meta/ab_partitions.txt" "$outdir/target_files_intermediates/META/ab_partitions.txt"
#	else
#		echo dummy_partition_name_so_resign_fails_to_build_images > "$outdir/target_files_intermediates/META/ab_partitions.txt"
	fi
	if test "$build_method" == resign; then
		# The configs live in the disposable intermediate tree, while fs_expected survives signing.
		# Regenerate both whenever that tree needs completing; its .done marker covers this step.
		mkdir -p "$outdir/fs_expected"
		make_fs_config "$outdir/fs_expected"
		# pvmfw may only be in the factory images, since it doesn't have to be updated by OTAs
		local pvmfw="$dir/ota_payload/pvmfw.img"
		if ! test -e "$pvmfw" && [[ " $(get_avbtool_partitions "$dir/ota_payload/vbmeta.img"|tr '\n' ' ') " == *" pvmfw "* ]]; then
			extract_factory_image
			pvmfw="$dir/factory_image/pvmfw.img"
		fi
		if test -e "$pvmfw"; then
			make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw.img" make_hardlink "$pvmfw"
			make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw_embedded.avbpubkey" make_pvmfw_embedded_avbpubkey
		fi
	fi
	# after the prebuilt images, which it depends on
	make_file "$outdir/target_files_intermediates/META/misc_info.txt" make_misc_info
	touch "$1"
}

# zip the target files directory $2 into $1 with the files stored uncompressed, with soong_zip as a
# normal build does, which is several times faster than zip
function zip_target_files {
	local zip="$(realpath "$1")"
	rm -f "$zip"
	(
		cd "$2"
		# the list of the files is read as a response file, in which a single quoted name can hold any
		# character, but for the images: soong_zip reads every file it stores into memory whole, which takes
		# a few times the size of one as big as system.img, more than a small machine has
		find . -mindepth 1 ! \( -path './IMAGES/*' -type f \) -printf '%P\0'|sed -z "s/'/'\\\\''/g; s/^/'/; s/\$/'/"|tr '\0' '\n'|"$otatools/bin/soong_zip" -d -L 0 -o "$zip" -C . -r /dev/stdin
		# so they are added by zipfile, which copies them a block at a time, with the time soong_zip gives its
		# files and the mode it gives them, 755 for an executable file and 644 for any other
		find . -path './IMAGES/*' -type f -printf '%P\0'|python3 -c '
import os, shutil, stat, sys, zipfile
with zipfile.ZipFile(sys.argv[1], "a") as z:
    date_time = z.infolist()[0].date_time
    for name in sys.stdin.buffer.read().split(b"\0")[:-1]:
        info = zipfile.ZipInfo.from_file(name, os.fsdecode(name))
        info.date_time = date_time
        info.external_attr = (stat.S_IFREG | (0o755 if info.external_attr >> 16 & stat.S_IXUSR else 0o644)) << 16
        with open(name, "rb") as src, z.open(info, "w") as dest:
            shutil.copyfileobj(src, dest)
' "$zip"
	)
}

function make_target_files_intermediates_zip {
	make_file "$outdir/target_files_intermediates.done" make_target_files_intermediates
	# along with the file marking it as made, for it to be made again if what is made from it is discarded as
	# well and needed again, as the target files are after the signing
	discard "$outdir/target_files_extracted" "$outdir/target_files_extracted.done"

	zip_target_files "$1" "$outdir/target_files_intermediates"
}

# sign the target files into $2 in the directory $1
function make_target_files_signed_zip_in {
	make_file "$outdir/target_files_intermediates.zip" make_target_files_intermediates_zip
	discard "$outdir/target_files_intermediates" "$outdir/target_files_intermediates.done"

	if test "$build_method" == vbmeta; then
		rm -f "$2"
		ln "$outdir/target_files_intermediates.zip" "$2"
	else
		local from to generate_release_sh
		from="$(realpath "$outdir/target_files_intermediates.zip")"
		to="$(realpath "$2")"
		# the archive can only be used by the Java runtime that made it, with the signapk.jar it was made with;
		# another run sharing it may have found it unusable and removed it as well
		if test -e "$signapk_jsa" && ! java "${signapk_java_args[@]}" -Xshare:on -XX:SharedArchiveFile="$signapk_jsa" -cp "$otatools/framework/signapk.jar" -version 2>/dev/null; then
			rm -f -- "$signapk_jsa"
		fi
		make_file "$signapk_jsa" make_signapk_jsa "$from"
		mkdir -p "$1/build/make/target/product"
		ln -s "$(realpath "$outdir/product_security")" "$1/build/make/target/product/security"
		ln -s "$(realpath "$key_dir")" "$1/keys"
		cd "$1"
		# added to the arguments of sign_target_files_apks in the release script, which gets them as its own
		local sign_args=(-k build/make/target/product/security/bluetooth=keys/bluetooth)
		# signing the APKs and APEXes in parallel, which the releasetools before those of Android 17 can't do
		if grep -q '"threads="' "$otatools/releasetools/sign_target_files_apks.py"; then
			sign_args+=(--threads "$threads")
		fi
		# sign_target_files_apks splits the Java options like a shell does, so each one is single quoted
		local java_args= arg
		for arg in "${signapk_java_args[@]}" -XX:SharedArchiveFile="$signapk_jsa"; do
			java_args+=" '${arg//\'/\'\\\'\'}'"
		done
		sign_args+=(--java_args "$java_args")
		generate_release_sh="$aosp/script/generate-release.sh"
		if ! test -e "$generate_release_sh"; then
			generate_release_sh="$aosp/script/release.sh"
		fi

		local sign_cmd
		sign_cmd="$(sed -nre '/^sign_target_files_apks/h; x; /./ {x; /\\$/p; /\\$/! s/.*//;}; x' "$generate_release_sh"|sed -re 's/(-d "\$KEY_DIR")/\1 "$@"/')"
		# the arguments are added after the key directory, where a change to the release script would otherwise
		# leave them out without an error, of the only command there is to sign with
		if [[ $sign_cmd != 'sign_target_files_apks '*'-d "$KEY_DIR" "$@"'* || $sign_cmd == *$'\n'sign_target_files_apks* ]]; then
			echo "There is no single sign_target_files_apks command with -d \"\$KEY_DIR\" to add the arguments after in $generate_release_sh" >&2
			exit 1
		fi
		printf '%s\n%s\n' "$sign_cmd" '"$RESIGN_FROM" "$RESIGN_TO"'|RESIGN_FROM="$from" RESIGN_TO="$to" KEY_DIR=keys AVB_ALGORITHM="$avb_algorithm" PYTHONUNBUFFERED=1 bash -x -s -- "${sign_args[@]}"
		# check that the sign tools signed all the files they are for, with the payloads they are
		# in repacked as they were
		python3 "$data_dir/target_files_inputs.py" apex-verify "$from" "$to"
	fi
}

function make_target_files_signed_zip {
	with_temp_dir "$outdir/sign_target_files" make_target_files_signed_zip_in "$@"
}

function make_target_files_signed {
	make_file "$outdir/target_files_intermediates.zip" make_target_files_intermediates_zip
	make_file "$outdir/target_files_signed.zip" make_target_files_signed_zip

	# only what is taken from the signed target files, rather than the gigabytes of the files the
	# images are built from, and each image, which the signing compressed, in a process of its own
	local zip="$outdir/target_files_signed.zip"
	unzip -q -o "$zip" 'META/*' '*/build.prop' -d "$1"
	local images=() image
	mapfile -t images < <(unzip -Z1 "$zip" 'IMAGES/*')
	wait $!
	# created beforehand, since unzip fails when another one creates a directory after it found it
	# missing
	local -A dirs=()
	for image in "${images[@]}"; do
		dirs[$1/${image%/*}]=
	done
	printf '%s\0' "${!dirs[@]}"|xargs -0 mkdir -p --
	printf '%s\n' "${images[@]}"|xargs -d '\n' -P "$threads" -I {} unzip -q -o "$zip" {} -d "$1"
}

# make the compat change with ID $2 enabled only for the apps targeting SDK version $3 or later, in
# whichever compat config of the target files directory $1 declares it, which is not always the same
# one, nor always with the same attributes
function set_compat_change_sdk {
	local configs=()
	mapfile -t configs < <(grep -lE "<compat-change [^>]*id=\"$2\"" "$1"/SYSTEM/etc/compatconfig/*.xml)
	if test "${#configs[@]}" == 0; then
		echo "No compat config declares the compat change $2" >&2
		exit 1
	fi
	sed -i -re "s|(<compat-change\s+(description=\"[^\"]*\"\s+)?enableSinceTargetSdk=\")[0-9]+(\"\s+id=\"$2\")|\1$3\3|" "${configs[@]}"
	if ! grep -qE "enableSinceTargetSdk=\"$3\"\s+id=\"$2\"" "${configs[@]}"; then
		echo "Failed to make the compat change $2 in ${configs[*]} enabled since SDK version $3" >&2
		exit 1
	fi
}

# the directory of the files of the partition $2 (as named in target files) in the target files
# directory $1, which is inside the one of the partition it is mounted from when it's not built on
# its own
declare -A nested_partition_dirs=([SYSTEM_EXT]=SYSTEM/system_ext [PRODUCT]=SYSTEM/product [ODM]=VENDOR/odm)
function partition_dir {
	partition_dir="$1/$2"
	if ! test -d "$partition_dir" && test -n "${nested_partition_dirs[$2]:-}"; then
		partition_dir="$1/${nested_partition_dirs[$2]}"
	fi
}

# run the find action that follows on the property files in the directory $1
function find_props {
	find "$1" \( -name build.prop -o -name prop.default \) -type f "${@:2}"
}

# make the changes that the options ask for to the properties in the files whose paths are NUL separated
# on the standard input
function edit_props {
	xargs -0 -r sed -i -re "$prop_sed"
}

# make the changes that the options ask for to the files in the target files directory $1
function apply_modifications {
	# the signing appends a newline to the build.prop files, so they are left with a single one for
	# them to end with the empty line they end with in the original images
	find_props "$1" -print0|xargs -0 sed -i -z -re 's/\n*$/\n/'
	# the property that --adb-at-boot-any-key-INSECURE clears is checked for so that its absence, or a
	# rename, doesn't silently leave authorization on
	if test -n "$adb_any_key" && test -z "$(find_props "$1" -exec grep -l '^ro\.adb\.secure=' {} +)"; then
		echo "Warning: no build.prop sets ro.adb.secure, so --adb-at-boot-any-key-INSECURE may not disable ADB key authorization" >&2
	fi
	# the properties are changed in the ramdisks as well, the prop.default of the recovery included:
	# there ro.debuggable=1 also has the recovery start a root shell on the serial console, next to the
	# recovery itself, and ro.adb.secure=0 has its adbd accept any host
	if test -n "$prop_sed"; then
		find_props "$1" -print0|edit_props
	fi
	# the rules to add to the SELinux policy, a line each
	local sepolicy=
	su=
	if test -n "$recovery_adb_root"; then
		# replace all calls to __android_log_is_debuggable with the constant 1
		own_file "$1/VENDOR_BOOT/RAMDISK/system/bin/adbd"
		patch_adbd {,}"$1/VENDOR_BOOT/RAMDISK/system/bin/adbd"
	fi

	if test -n "$adb_root"; then
		sepolicy+=$'(allow adbd adbd (process (setcurrent)))\n'
		su=1
	fi

	if false; then
		#sepolicy+=$'(typetransition dumpstate su_exec process su)\n'

		# this would be needed to let shell su to root if we supported a "su" binary, in addition to actually adding the binary
		sepolicy+=$'(typetransition shell su_exec process su)\n'

		su=1
	fi

	if test -n "$su"; then
		# su.cil generated like this starting from userdebug target_files from ci.android.com
		# sed -re 's/(expandtypeattribute .* )true/\1false/' SYSTEM/etc/selinux/plat_sepolicy.cil > plat_sepolicy_noexpand.cil
		# secilc -G -N -m plat_sepolicy_noexpand.cil -o plat_sepolicy_noexpand.policy && checkpolicy -C -M -b plat_sepolicy_noexpand.policy -o dis.cil
		# grep -w su dis.cil|sed -re 's/^(\(typeattributeset [^ ]*) .*\)$/\1 (su))/'|grep -v 'su_exec process su' > su.cil

		# TODO: we are filtering some permissions arbitrarily, we should use a better way to filter them
		sepolicy+="$(sed -e 's/ nlmsg_getneigh//; s/ get_attestation_key//; s/ migrate_any_key//; s/ su_userfaultfd//' "$data_dir/su.cil"|grep -v '\[userfaultfd\]')"$'\n'
	fi
	if test -n "$allowbackup"; then
		# IGNORE_ALLOW_BACKUP_IN_D2D and IGNORE_FULL_BACKUP_CONTENT_IN_D2D
		set_compat_change_sdk "$1" 183147249 1
		set_compat_change_sdk "$1" 180523564 1
	fi
	if test -n "$adb_backup"; then
		# RESTRICT_ADB_BACKUP
		set_compat_change_sdk "$1" 171032338 99
	fi
	if test -n "$hosts_url"; then
		# the entries mapping a host name, which can have hyphens and underscores but isn't an address, to
		# 127.0.0.1, other than the localhost ones that the hosts file has already, from a list that may
		# have DOS line endings; one with none is taken for not being a hosts file rather than left out
		local hosts
		hosts="$(curl --fail "$hosts_url"|sed -nre 's/\r$//; /^127\.0\.0\.1 \.*localhost\.*$/d; /^127\.0\.0\.1 [0-9.]*[a-zA-Z_-][0-9a-zA-Z._-]*$/p')"
		if test -z "$hosts"; then
			echo "$hosts_url has no host names mapped to 127.0.0.1 to add to the hosts file" >&2
			exit 1
		fi
		own_file "$1/SYSTEM/etc/hosts"
		printf '%s\n' "$hosts" >> "$1/SYSTEM/etc/hosts"
	fi
	if test -n "$sepolicy"; then
		# init loads the precompiled policy only while the hashes stored next to it match those of the
		# policy of the system partitions, and otherwise compiles the policy at every boot, so compile it
		# here instead, from the CIL files that init would compile it from
		selinux="$1/SYSTEM/etc/selinux"
		vendor_selinux="$1/VENDOR/etc/selinux"
		partition_dir "$1" SYSTEM_EXT
		system_ext_selinux="$partition_dir/etc/selinux"
		partition_dir "$1" PRODUCT
		product_selinux="$partition_dir/etc/selinux"
		partition_dir "$1" ODM
		odm_selinux="$partition_dir/etc/selinux"
		precompiled="$odm_selinux/precompiled_sepolicy"
		if ! test -e "$precompiled"; then
			precompiled="$vendor_selinux/precompiled_sepolicy"
		fi
		# the version of the policy format, from the header of the precompiled policy
		policy_version="$(od -An -tu4 --endian=little -j16 -N4 "$precompiled")"
		read -r mapping_version < "$vendor_selinux/plat_sepolicy_vers.txt"
		# and the version of the genfs labels, which the vendor only has since Android 15 QPR2, and has empty
		# unless the device sets it
		genfs_version=
		if test -e "$vendor_selinux/genfs_labels_version.txt"; then
			genfs_version="$(< "$vendor_selinux/genfs_labels_version.txt")"
		fi
		cil=()
		for i in "$selinux/plat_sepolicy.cil" "$selinux/mapping/$mapping_version.cil" "$selinux/mapping/$mapping_version.compat.cil" \
			"$system_ext_selinux/system_ext_sepolicy.cil" "$system_ext_selinux/mapping/$mapping_version.cil" "$system_ext_selinux/mapping/$mapping_version.compat.cil" \
			"$product_selinux/product_sepolicy.cil" "$product_selinux/mapping/$mapping_version.cil" \
			"$vendor_selinux/plat_pub_versioned.cil" "$vendor_selinux/vendor_sepolicy.cil" "$odm_selinux/odm_sepolicy.cil"; do
			if test -e "$i"; then
				cil+=("$i")
			fi
		done
		if test -n "$genfs_version" && test -e "$selinux/plat_sepolicy_genfs_$genfs_version.cil"; then
			cil+=("$selinux/plat_sepolicy_genfs_$genfs_version.cil")
		fi
		secilc=("$otatools/bin/secilc" -m -M true -G -N -c "${policy_version// /}" -f /dev/null "${cil[@]}")
		# compiling the policy before changing it must reproduce the precompiled one exactly
		if ! "${secilc[@]}" -o /dev/stdout|cmp -s - "$precompiled"; then
			echo "Compiling the unmodified SELinux policy from ${cil[*]} doesn't reproduce $precompiled" >&2
			exit 1
		fi

		# we remove all neverallows because they have no runtime effect after policy compilation (unless validation fails, but in that case the device fails to boot), and it's too hard to fix them
		# TODO: fix the neverallows...
		sed -i -re '/^\(neverallow /d' "$1/SYSTEM/etc/selinux/plat_sepolicy.cil"

		# we must filter out rules for types that don't exist in the policy
		declare -A se_types
		while read i; do
			se_types["$i"]=1
		done < <(sed -nre 's/^\((type|typeattribute|role) ([^ )]*).*\)$/\2/p' "$1/SYSTEM/etc/selinux/plat_sepolicy.cil" |sort|uniq)

		printf '%s' "$sepolicy"|sed -re 'h; s/[()]//g; s/\S* (\S*) (\S*).*/\1|\2|/; /\|/! s/.*/||/; G; s/\n//;'|while IFS='|' read a b r; do
			ok=1
			for i in $a $b; do
				if test "$i" != su && test "$i" != self && test -z "${se_types[$i]:-}"; then
					ok=
				fi
			done
			if test -n "$ok"; then
				echo "$r"
			fi
		done >> "$1/SYSTEM/etc/selinux/plat_sepolicy.cil"

		"${secilc[@]}" -o "$precompiled.own"
		mv -f -- "$precompiled.own" "$precompiled"
		# the hash of the platform policy and of the mapping file, as the build makes it with the mapping
		# file of the version of the platform, which is the version of the vendor partition built with it
		hash="$(cat -- "$selinux/plat_sepolicy.cil" "$selinux/mapping/$mapping_version.cil"|sha256sum)"
		for i in "$selinux/plat_sepolicy_and_mapping.sha256" "$precompiled.plat_sepolicy_and_mapping.sha256"; do
			echo "${hash%% *}" > "$i.own"
			mv -f -- "$i.own" "$i"
		done
	fi
}

function make_target_files_base {
	if test "$build_method" == resign; then
		make_dir "$outdir/target_files_signed" make_target_files_signed
		discard "$outdir/target_files_signed.zip" "$outdir/target_files_intermediates.zip"

		cp -a "$outdir/target_files_signed/META" "$1/META"

		outr="$(realpath "$1")"
		(cd "$outdir/target_files_signed" && find . -name build.prop -print0|xargs -0 cp -a --parents --target-directory="$outr")

		make_file "$dir/ota_meta/postinstall_config.txt" make_postinstall_config
		# the partitions of the OTA, which the signing isn't given for it not to require the images of all of
		# them, and what runs once they are written, as the upstream OTA has them, while the other files of META
		# are those that the signing made for the images it built
		for i in ab_partitions.txt postinstall_config.txt; do
			ln -f "$dir/ota_meta/$i" "$1/META/$i"
		done

		rm -f "$1/META/care_map.pb"
	else
		echo "Should not have called make_target_files" >&2
		exit 1
	fi
}

# vbmeta: ota_payload -> [copy ota_payload images and make new vbmeta] -> target_files_intermediate -> target_files_intermediate.zip -> [ln] -> target_files_signed.zip -> [ln] -> target_files.zip
# resign: ota_payload -> [extract files and their metadata from images, modify] -> target_files_intermediate -> target_files_intermediate.zip -> [sign and build images] -> target_files_signed.zip -> [integrate with the other ota_payload images] -> target_files -> target_files.zip
# rebuild: ota_payload -> [unpack all images] -> target_files_intermediate -> target_files_intermediate.zip -> [sign] -> target_files_signed.zip -> [rename] -> target_files.zip

function read_prop {
	local i
	for i in "" /etc; do
		local p="$1$i/build.prop"
		if test -e "$p"; then
			while IFS== read k v; do
				if test "$k" == "$2"; then
					echo "$v"
					exit 0
				fi
			done < "$p"
		fi
	done
	exit 1
}

function make_care_map {
	local care_map_txt=
	while read b; do
		ok=
		for i in $image_parts; do
			if test "$b" == "$i"; then
				ok=1
			fi
		done
		if test -n "$ok" && test -e "$outdir/target_files/IMAGES/$b.img"; then
			d="$(echo "$b"|tr a-z A-Z)"
			prop=
			print=
			for i in fingerprint thumbprint; do
				local p="ro.$b.build.$i"
				if print="$(read_prop "$outdir/target_files/$d" "$p")"; then
					prop="$p"
					break
				fi
			done

			if test -z "$prop"; then
				echo "Cannot find fingerprint for partition $b while building the care map" >&2
				prop=unknown
				print=unknown
			fi

			size="$("$otatools"/bin/avbtool info_image --image "$outdir/target_files/IMAGES/$b.img"|sed -nre 's/^\s*Original image size:\s*([0-9]+).*/\1/p')"
			blocks="$(($size / 4096))"

			local entry
			printf -v entry '%s\n' "$b" "2,0,$blocks" "$prop" "$print"
			care_map_txt+="$entry"
		fi
	done < "$outdir/target_files/META/ab_partitions.txt"

	"$otatools/bin/care_map_generator" <(printf '%s' "$care_map_txt") "$1"
}

# check that the image $2 of the boot partition $4, which the signing built from the files of its ramdisk,
# is made like the original one $3, since the recovery, which the next OTA is sideloaded with, is one of
# them: only the OTA certificates, which the signing replaces and the recovery is checked to trust the
# release key with, and adbd with --recovery-adb-root may be anything, while the property files must be
# the original ones with the changes that the options ask for, which are made to copies of them in $1
function verify_built_boot {
	local ramdisk="$outdir/boot_inputs/target_files/${4^^}/RAMDISK" expected
	expected="$(realpath "$1")"
	if test -n "$prop_sed"; then
		(cd "$ramdisk" && find_props . -print0|xargs -0 -r cp --parents --target-directory="$expected")
		find_props "$expected" -print0|edit_props
	fi
	{
		find "$ramdisk" -name otacerts.zip -type f -printf '%P\0'
		if test -n "$recovery_adb_root" && test "$4" == vendor_boot; then
			printf '%s\0' system/bin/adbd
		fi
	}|python3 "$data_dir/target_files_inputs.py" boot-verify "$2" "$3" --expected "$1"
}

# take the image of partition $2 that the signing built, checking that it is made like the original one, which
# for a prebuilt one that the signing only added a footer to again means the same footer but for the build number
# of the version in the fingerprints of its AVB properties
function take_signed_image {
	local img="$outdir/target_files_signed/IMAGES/$2.img"
	local orig="$dir/ota_payload/$2.img"
	if test -e "$outdir/fs_expected/$2.json"; then
		python3 "$data_dir/target_files_inputs.py" fs-verify "$img" "$outdir/fs_expected/$2.json"
	elif test -d "$outdir/boot_inputs/target_files/${2^^}"; then
		with_temp_dir "$outdir/boot_expected_$2" verify_built_boot "$img" "$orig" "$2"
	elif test "$2" == vbmeta; then
		if ! diff <(get_avbtool_partitions "$orig"|sort) <(get_avbtool_partitions "$img"|sort) >&2 || test "$(get_avbtool_vbmeta_opts "$orig")" != "$(get_avbtool_vbmeta_opts "$img")"; then
			echo "The built vbmeta doesn't verify the same partitions with the same rollback index as the original one" >&2
			exit 1
		fi
	elif test "$2" == boot && test -n "$replace_boot"; then
		# Signing may only change the AVB footer of the already checked replacement.
		python3 "$data_dir/target_files_inputs.py" boot-verify "$img" "$replace_boot" </dev/null
	elif test "$2" == pvmfw; then
		: # the signing replaced the key embedded in it, and checked that it found the one to replace
	elif ! diff <(get_avb_info "$orig"|sed -re "$build_number_sed") <(get_avb_info "$img") >&2; then
		echo "The prebuilt $2.img was changed by adding a footer to it again" >&2
		exit 1
	fi
	ln "$img" "$1"
}

function make_target_files_zip {
	# what was made from the target files made before, which is only made when missing, including what --keep
	# kept of it and what failed its check, would otherwise be taken for made from these: the factory images
	# made with --factory-image as well, which the factory zip is made from, and which are made again if asked for
	rm -rf -- "$outdir/ota_unchecked.zip" "$outdir/factory_image" "$outdir/factory_unchecked" "$outdir/factory"

	if test "$build_method" == resign; then
		# which is discarded once the target files are made, while the files marking what was made from it are kept, so
		# it is made again for the target files that are made again
		make_dir "$dir/ota_payload" make_extract_ota_payload
		make_dir "$outdir/target_files" make_target_files_base

		mkdir -p "$outdir/target_files/IMAGES"
		for i in "$dir/ota_payload"/*; do
			i="${i##*/}"
			local done=
			for j in $signed_images; do
				if test "$i" == "$j.img"; then
					done=1
				fi
			done
			if test -z "$done" && test -f "$dir/ota_payload/$i"; then
				make_file "$outdir/target_files/IMAGES/$i" make_hardlink "$dir/ota_payload/$i"
			fi
		done

		for b in $signed_images; do
			if test -e "$dir/ota_payload/$b.img" || test -e "$outdir/target_files_signed/IMAGES/$b.img"; then
				make_file "$outdir/target_files/IMAGES/$b.img" take_signed_image "$b"
			fi
		done

		discard "$outdir/target_files_signed"

		# the bootloader boots neither the system nor the recovery unless vbmeta is signed with the AVB key
		# and every image it verifies has the digest that it has for it
		if ! "$otatools/bin/avbtool" verify_image --image "$outdir/target_files/IMAGES/vbmeta.img" --key "$key_dir/avb.pem" >&2; then
			echo "The images don't verify with vbmeta and the AVB key!!!" >&2
			exit 1
		fi
		# and that the recovery trusts the release key and accepts the next updates, as for the OTA and the
		# factory images, since the target files are the output when neither is asked for
		with_temp_dir "$outdir/check_target_files" check_images "$outdir/target_files/IMAGES" "$outdir/target_files/IMAGES/system.img"

		make_file "$outdir/target_files/META/care_map.pb" make_care_map

		zip_target_files "$1" "$outdir/target_files"
	else
		make_file "$outdir/target_files_signed.zip" make_target_files_signed_zip
		discard "$outdir/target_files_intermediates.zip"
		rm -f "$1"
		ln "$outdir/target_files_signed.zip" "$1"
	fi
}

# needs out_target_files.zip, whose dynamic_partitions_info.txt has disable_ublk=true, as ota_from_target_files
# --disable_ublk would add, when the payload of the upstream OTA is made with it
function make_ota_unchecked {
	"$otatools/bin/ota_from_target_files" -k "$key_dir/releasekey" "$outdir/target_files.zip" "$1"
}

# check that the otacerts.zip $2 of the $1 holds the certificate of the release key, which it writes to $3,
# and nothing else: the recovery trusts every certificate in it, and one that it can't load keeps it from
# loading the others
function check_otacerts {
	local entries
	entries="$(unzip -Z1 "$2")"
	if test "$entries" != keys/releasekey.x509.pem; then
		echo "The otacerts.zip of the $1 holds ${entries//$'\n'/ } rather than only keys/releasekey.x509.pem!!!" >&2
		exit 1
	fi
	unzip -p "$2" keys/releasekey.x509.pem > "$3"
	if ! cmp -s "$3" "$key_dir/releasekey.x509.pem"; then
		echo "The otacerts.zip of the $1 has wrong key!!!" >&2
		exit 1
	fi
}

# make sure we have the correct key in recovery so that we can sideload another update, otherwise we can get locked out the device...
# and that vbmeta is signed with the AVB key that the bootloader is locked with, and that the system is
# the one of the version being built, with the timestamp that the updater compares: the images are those
# in the directory $2 but for the system image $3. It sets recovery_date_utc and recovery_device to the
# build timestamp and the device of the recovery
function check_images {
	local system="$3"
	local vbmeta="$2/vbmeta.img"
	# the recovery boots with the ramdisks of all of them, the generic one included, and any of them
	# could hold certificates that the others' are unpacked over
	local boot_images=() b
	for b in vendor_boot vendor_kernel_boot boot init_boot; do
		if test -e "$2/$b.img"; then
			boot_images+=("$2/$b.img")
		fi
	done
	python3 "$data_dir/target_files_inputs.py" ramdisk-file system/etc/security/otacerts.zip "${boot_images[@]}" > "$1/recovery_otacerts.zip"
	check_otacerts recovery "$1/recovery_otacerts.zip" "$1/recovery_releasekey.x509.pem"
	# the key of the certificate that the recovery ends up with, which make_keys checks the one of before
	# every build, has to be one that the recovery can load
	python3 "$data_dir/target_files_inputs.py" recovery-cert-check "$1/recovery_releasekey.x509.pem"
	debugfs_quote "$1/system_otacerts.zip"
	"$debugfs" -R "dump /system/etc/security/otacerts.zip $debugfs_quote" "$system" >&2
	check_otacerts system "$1/system_otacerts.zip" "$1/system_releasekey.x509.pem"
	local vbmeta_key avb_key
	vbmeta_key="$("$otatools/bin/avbtool" info_image --image "$vbmeta"|sed -nre 's/^Public key \(sha1\):\s*//p')"
	read -r avb_key _ < <(sha1sum < "$key_dir/avb_pkmd.bin")
	if test "$vbmeta_key" != "$avb_key"; then
		echo "vbmeta is not signed with the AVB key!!!" >&2
		exit 1
	fi
	local k v incremental= date_utc=
	while IFS== read -r k v; do
		case "$k" in
			ro.build.version.incremental) incremental="$v" ;;
			ro.build.date.utc) date_utc="$v" ;;
		esac
	done < <("$debugfs" -R "cat /system/build.prop" "$system" 2>/dev/null)
	if test "$incremental" != "$out_build"; then
		echo "The system is of build $incremental rather than $out_build" >&2
		exit 1
	fi
	if test -n "$build_date_utc" && test "$date_utc" != "$build_date_utc"; then
		echo "The build timestamp of the system is $date_utc rather than $build_date_utc, the one synthesized for version $out_build" >&2
		exit 1
	fi
	# the recovery refuses a package of another device or older than itself, while the next releases are
	# only newer than the system, so it must be of this device with the build timestamp of the system
	python3 "$data_dir/target_files_inputs.py" ramdisk-file prop.default "${boot_images[@]}" > "$1/recovery_prop.default"
	local -A recovery_props=()
	while IFS== read -r k v || test -n "$k"; do
		# the last value of a property is the one it gets
		if [[ -n $k && $k != '#'* ]]; then
			recovery_props["$k"]="$v"
		fi
	done < "$1/recovery_prop.default"
	recovery_date_utc="${recovery_props[ro.build.date.utc]:-}"
	# which init sets, unless it is set already, to the first one set of those of the partitions in the
	# order it is given
	recovery_device="${recovery_props[ro.product.device]:-}"
	local sources source
	IFS=, read -ra sources <<< "${recovery_props[ro.product.property_source_order]:-product,odm,vendor,system_ext,system}"
	for source in "${sources[@]}"; do
		if test -z "$recovery_device"; then
			recovery_device="${recovery_props[ro.product.$source.device]:-}"
		fi
	done
	if ! [[ $date_utc =~ ^[0-9]+$ ]] || test "$recovery_date_utc" != "$date_utc" || test "$recovery_device" != "$device"; then
		echo "The recovery is of device $recovery_device with build timestamp $recovery_date_utc rather than of $device with the one of the system, $date_utc!!!" >&2
		exit 1
	fi
}

function check_ota {
	mkdir "$1/ota_payload"
	ota_payload_offset "$outdir/ota_unchecked.zip"
	# which skips the partitions that the payload doesn't have
	"$otatools/bin/ota_extractor" -payload "$outdir/ota_unchecked.zip" -payload_offset "$ota_payload_offset" -output_dir "$1/ota_payload" -partitions boot,init_boot,vendor_boot,vendor_kernel_boot,system,vbmeta >&2
	check_images "$1" "$1/ota_payload" "$1/ota_payload/system.img"
	# the recovery that the OTA installs verifies the signature of the next OTA to sideload, and the one of its
	# payload, with the certificates of its otacerts.zip, so it must accept this OTA, which the next ones are
	# signed like
	if ! "$otatools/bin/check_ota_package_signature" "$1/recovery_releasekey.x509.pem" "$outdir/ota_unchecked.zip" >&2; then
		echo "The recovery in the OTA doesn't accept the OTA!!!" >&2
		exit 1
	fi
	# nor one of another device or older than itself, as it would refuse the next ones if they were made
	# like this one and it isn't
	local metadata k v post_timestamp= pre_device=
	metadata="$(unzip -p "$outdir/ota_unchecked.zip" META-INF/com/android/metadata)"
	while IFS== read -r k v; do
		case "$k" in
			post-timestamp) post_timestamp="$v" ;;
			pre-device) pre_device="$v" ;;
		esac
	done <<< "$metadata"
	if ! [[ $post_timestamp =~ ^[0-9]+$ && "|$pre_device|" == *"|$recovery_device|"* ]] || test "$post_timestamp" -lt "$recovery_date_utc"; then
		echo "The recovery in the OTA, of device $recovery_device with build timestamp $recovery_date_utc, doesn't accept an OTA for $pre_device with build timestamp $post_timestamp!!!" >&2
		exit 1
	fi
	echo "CHECK SUCCESSFUL"
}

function make_ota {
	# the metadata of the OTA made before
	rm -rf -- "$outdir/out_meta"
	make_file "$outdir/ota_unchecked.zip" make_ota_unchecked

	result="$(with_temp_dir "$outdir/check_ota" check_ota)"
	if test "$result" == "CHECK SUCCESSFUL"; then
		ln "$outdir/ota_unchecked.zip" "$1"
	else
		printf '%s\n' "$result" "OTA key check failed!!!" >&2
		exit 1
	fi
}

function download_factory {
	curl --fail "$factory_url.zip" -C - -o "$factory_zip_dir/$factory_name.zip"
	curl --fail "$factory_url.zip.sig" -C - -o "$factory_zip_dir/$factory_name.zip.sig"
	if test "$(head -n 1 "$factory_zip_dir/$factory_name.zip.sig")" == "-----BEGIN SSH SIGNATURE-----"; then
		if ! ssh-keygen -Y verify -f "$allowed_signers" -I "$factory_identity" -n "factory images" -s "$factory_zip_dir/$factory_name.zip.sig" < "$factory_zip_dir/$factory_name.zip"; then
			echo "Failed to verify factory image signature of $factory_zip_dir/$factory_name.zip with ssh-keygen!" >&2
			remove_bad_download "$factory_zip_dir/$factory_name.zip" "$factory_zip_dir/$factory_name.zip.sig"
			exit 1
		fi
	else
		if ! ( cd "$factory_zip_dir" && $signify -Cqp "$factory_key" -x "$factory_name.zip.sig" ); then
			echo "Failed to verify factory image signature of $factory_zip_dir/$factory_name.zip with signify!" >&2
			remove_bad_download "$factory_zip_dir/$factory_name.zip" "$factory_zip_dir/$factory_name.zip.sig"
			exit 1
		fi
	fi
	touch "$1"
}

# download the factory images and verify them, unless that is done already
function make_factory_download {
	mkdir -p "$factory_zip_dir"
	with_lock "$factory_zip_dir/$factory_name.zip" make_file "$factory_zip_ok" download_factory
}

function do_unzip_img2simg {
	unzip -q -p "$3" "$4" > "$1"/img
	"$otatools/bin/img2simg" "$1"/img "$2" 4096
}

function do_ln_dir {
	ln "$2"/* "$1"
}

# extract the factory images into $dir/factory, listing their files in $dir/factory.list, and put the images
# into $dir/factory_image, which the factory images of the builds before the install ones have in a zip of their
# own, whose files are listed in $dir/factory_image.list
function extract_factory_image {
	if ! test -e "$dir/factory_image" || ! test -e "$dir/factory.list" || { test -z "$factory_optimized" && ! test -e "$dir/factory_image.list"; }; then
		if ! test -e "$dir/factory" || ! test -e "$dir/factory.list"; then
			make_factory_download

			make_dir "$dir/factory" do_unzip "$factory_zip_dir/$factory_name.zip"
			make_file "$dir/factory.list" do_unzip_list "$factory_zip_dir/$factory_name.zip"
			discard_download "$factory_zip_dir/$factory_name.zip"
		fi

		if test -n "$factory_optimized"; then
			make_dir "$dir/factory_image" do_ln_dir "$dir/factory/$factory_name"
		else
			make_dir "$dir/factory_image" do_unzip "$dir/factory/$factory_name/image-$device-$build.zip"
			make_file "$dir/factory_image.list" do_unzip_list "$dir/factory/$factory_name/image-$device-$build.zip"
			discard "$dir/factory/$factory_name/image-$device-$build.zip"
		fi
	fi
}

# build the super image $2 of the target files, extracted into the directory $1 as build_super_image extracts them
# itself, with the geometry of the super partition of the factory images, which the target files don't have since
# the OTA that they are made from doesn't either: only a build of the factory images downloads them
function make_super_image {
	unzip -q "$outdir/target_files.zip" 'IMAGES/*' 'META/*' '*/build.prop' -d "$1"
	# on a line of its own, since the misc_info.txt that the signing writes doesn't end with a newline
	{
		echo
		python3 "$data_dir/super_geometry.py" "$otatools" "$dir/factory_image"
	} >> "$1/META/misc_info.txt"
	"$otatools/bin/build_super_image" "$1" "$2"
}

# needs out_target_files.zip
function make_factory_image {
	extract_factory_image

	local super_names=()
	local super_files=()

	if test -e "$dir/factory_image/super_1.img" || test -e "$dir/factory_image/super.img"; then
		with_temp_dir "$outdir/super_target_files" make_super_image "$1/super.img"
		# which only warns when it doesn't build it because an image of a partition in it is missing
		if ! test -e "$1/super.img"; then
			echo "build_super_image didn't build super.img" >&2
			exit 1
		fi

		if test -e "$dir/factory_image/super_1.img"; then
			# split into pieces of at most the size of a download of the device, like the upstream ones, which the
			# fastboot script of the factory images checks the device for
			local max_download_size
			max_download_size="$(sed -nre 's/^check-var max-download-size (0x[0-9a-fA-F]+)\s*$/\1/p' "$dir/factory_image/script.txt")"
			if ! [[ $max_download_size =~ ^0x[0-9a-fA-F]+$ ]]; then
				echo "$dir/factory_image/script.txt doesn't check for a single max-download-size, which super was split for" >&2
				exit 1
			fi
			simg2simg "$1/super.img" "$1/super" "$((max_download_size))"
			rm -f "$1/super.img"

			local supers=("$1"/super.[0-9]*)
			local super_count="${#supers[@]}"

			for ((i = 1; i <= super_count; i++)); do
				mv "$1/super.$(($i - 1))" "$1/super_$i.img"
				super_names+=("super, $i/$super_count")
				super_files+=("super_$i.img")
			done
		else
			super_names=("super")
			super_files=("super.img")
		fi
	fi

	for i in "$dir/factory_image"/*; do
		i="${i##*/}"
		if test "$i" == avb_pkmd.bin; then
			cp -a "$key_dir/avb_pkmd.bin" "$1"
		elif test "$i" == flash-all.sh; then
			{
				local super_inserted=
				while IFS= read -r line; do
					if [[ "${#super_files[@]}" != 0 && ( "$line" == "echo Flashing super"* || "$line" == "fastboot flash super super"* ) ]]; then
						if test -z "$super_inserted"; then
							for ((j = 0; j < ${#super_files[@]}; j++)); do
								echo "echo Flashing ${super_names[$j]}"
								echo "fastboot flash super ${super_files[$j]}"
							done
							super_inserted=1
						fi
					else
						echo "$line"
					fi
				done < "$dir/factory_image/$i"
			} > "$1/$i"
			chmod --reference="$dir/factory_image/$i" -- "$1/$i"
		elif test "$i" == flash-all.bat; then
			{
				local super_inserted= skip_errorlevel= skip_blank=
				while IFS= read -r line; do
					if [[ "${#super_files[@]}" != 0 && "$line" == "echo Flashing super"* ]]; then
						if test -z "$super_inserted"; then
							for ((j = 0; j < ${#super_files[@]}; j++)); do
								echo "echo Flashing ${super_names[$j]}"
								echo "fastboot flash super ${super_files[$j]}"
								echo "if %errorlevel% neq 0 call:pakExit"
								echo
							done
							super_inserted=1
						fi
						continue
					fi
					if [[ "${#super_files[@]}" != 0 && "$line" == "fastboot flash super super"* ]]; then
						skip_errorlevel=1
						continue
					fi
					if test -n "$skip_errorlevel" && [[ "$line" == *"errorlevel"* ]]; then
						skip_errorlevel=
						skip_blank=1
						continue
					fi
					if test -n "$skip_blank" && [[ "$line" =~ ^[[:space:]]*$ ]]; then
						skip_blank=
						continue
					fi
					echo "$line"
				done < "$dir/factory_image/$i"
			} > "$1/$i"
		elif test "$i" == script.txt; then
			{
				local super_inserted=
				while IFS= read -r line; do
					if [[ "${#super_files[@]}" != 0 && "$line" == flash\ super\ super* ]]; then
						if test -z "$super_inserted"; then
							for ((j = 0; j < ${#super_files[@]}; j++)); do
								echo "flash super ${super_files[$j]}"
							done
							super_inserted=1
						fi
					else
						echo "$line"
					fi
				done < "$dir/factory_image/$i"
			} > "$1/$i"
		elif unzip -q -l "$outdir/target_files.zip" "IMAGES/$i" >/dev/null; then
			simg=
			for j in $image_parts; do
				if test "$i" == "$j.img"; then
					simg=1
				fi
			done
			if test -n "$simg"; then
				with_temp_dir "$outdir/target_files-img-$i" do_unzip_img2simg "$1/$i" "$outdir/target_files.zip" "IMAGES/$i"
			else
				unzip -q -p "$outdir/target_files.zip" "IMAGES/$i" > "$1/$i"
			fi
		elif [[ "${#super_files[@]}" != 0 && $i == super*.img ]]; then
			: # already done before
		else
			ln "$dir/factory_image/$i" "$1/$i"
		fi
	done

}

function make_factory_unchecked {
	local out="$1/$out_factory_name"
	mkdir "$out"

	make_dir "$outdir/factory_image" make_factory_image

	if test -n "$factory_optimized"; then
		ln "$outdir/factory_image"/* "$out"
	else
		local zip="$(realpath "$out/image-$device-$out_build.zip")"
		# files in the zip must be in the proper order, which zip takes the names in, one per line, from its input,
		# failing on a name that isn't there rather than silently leaving it out
		(cd "$outdir/factory_image" && zip -q -MM "$zip_opt" "$zip" -@) < "$dir/factory_image.list"

		for i in "$dir/factory/$factory_name"/*; do
			i="${i##*/}"
			if test "$i" == avb_pkmd.bin; then
				cp -a "$key_dir/avb_pkmd.bin" "$out"
			elif test "$i" == "image-$device-$build.zip"; then
				:
			else
				ln "$dir/factory/$factory_name/$i" "$out"
			fi
		done
	fi

	if test "$out_build" != "$build"; then
		# the flashing scripts refer to the build number, e.g. in the image zip name
		# (sed -i replaces the file, so the linked originals are unaffected)
		for i in flash-all.sh flash-all.bat script.txt; do
			if test -e "$out/$i"; then
				sed -i -e "s/$build/$out_build/g" "$out/$i"
			fi
		done
	fi
}

function make_factory {
	make_dir "$outdir/factory_unchecked" make_factory_unchecked

	result="$(with_temp_dir "$outdir/check_factory" check_factory)"
	if test "$result" == "CHECK SUCCESSFUL"; then
		mkdir -p "$1/$out_factory_name"
		ln --target-directory="$1/$out_factory_name" "$outdir/factory_unchecked/$out_factory_name"/*
		# which only has more links to the same files, and otherwise keeps the gigabytes of the images once
		# they are discarded from here
		rm -rf -- "$outdir/factory_unchecked"
	else
		printf '%s\n' "$result" "Factory key check failed!!!" >&2
		exit 1
	fi
}

function check_factory {
	mkdir "$1"/factory_image >&2
	if test -n "$factory_optimized"; then
		ln "$outdir/factory_unchecked/$out_factory_name"/* "$1/factory_image"
		if test -e "$1/factory_image/super_1.img"; then
			local super_images=()
			mapfile -d '' -t super_images < <(printf '%s\0' "$1/factory_image"/super_*.img|sort -zV)
			wait $!
			"$otatools/bin/simg2img" "${super_images[@]}" "$1/super.img" >&2
		else
			"$otatools/bin/simg2img" "$1/factory_image/super.img" "$1/super.img" >&2
		fi
		mkdir "$1/lpunpack"
		"$otatools"/bin/lpunpack -p system_a "$1/super.img" "$1/lpunpack" >&2
		mv "$1/lpunpack/system_a.img" "$1/system.img"
	else
		unzip -x -d "$1/factory_image" "$outdir/factory_unchecked/$out_factory_name/image-$device-$out_build.zip" system.img vbmeta.img '*boot.img' >&2
		"$otatools/bin/simg2img" "$1/factory_image/system.img" "$1/system.img"  >&2
	fi
	# the key that the bootloader is locked with after flashing
	if ! cmp "$outdir/factory_unchecked/$out_factory_name/avb_pkmd.bin" "$key_dir/avb_pkmd.bin" >&2; then
		echo "The factory image doesn't have the AVB key to lock the bootloader with!!!" >&2
		exit 1
	fi

	check_images "$1" "$1/factory_image" "$1/system.img"
	echo "CHECK SUCCESSFUL"
}


function make_factory_zip {
	make_dir "$outdir/factory" make_factory
	discard "$outdir/factory_image"

	local zip="$(realpath "$1")"
	rm -f "$zip"
	# the signature of the zip made before
	rm -f -- "$out_factory.sig"

	# the names of the files, in the order of the original zip, which zip takes one per line from its input,
	# failing on a name that isn't there rather than silently leaving it out
	{
		local super_inserted= entry i
		while IFS= read -r entry; do
			# the build number appears in the directory name and in the image zip name
			entry="${entry//"$build"/"$out_build"}"
			if [[ -e "$outdir/factory/$out_factory_name"/super_1.img || -e "$outdir/factory/$out_factory_name"/super.img ]] && [[ ${entry##*/} == super*.img ]]; then
				# the super image, or the pieces it was split into, in their order, in place of the upstream ones
				if test -z "$super_inserted"; then
					if test -e "$outdir/factory/$out_factory_name/super.img"; then
						printf '%s\n' "$out_factory_name/super.img"
					fi
					for ((i = 1; ; i++)); do
						if ! test -e "$outdir/factory/$out_factory_name/super_$i.img"; then
							break
						fi
						printf '%s\n' "$out_factory_name/super_$i.img"
					done
					super_inserted=1
				fi
			else
				printf '%s\n' "$entry"
			fi
		done < "$dir/factory.list"
	}|(cd "$outdir/factory" && zip -q -MM "$zip_opt" "$zip" -@)
}

function make_factory_zip_sig {
	if test "$sign_factory_images" == signify; then
		# only the digest is computed in the directory of the zip, for it to name the zip without the path to it,
		# since the paths may be relative to the current directory
		(cd "$outdir/out" && sha256sum --tag "$out_factory_name.zip")|$signify -S -s "$key_dir/factory.sec" -e -m - -x "$1"
	elif test "$sign_factory_images" == ssh-keygen; then
		ssh-keygen -Y sign -n "factory images" -f "$key_dir/id_ed25519" < "$out_factory" > "$1"
	fi
}


out_ota="$outdir/out/$device-ota_update-$out_build.zip"
out_factory="$outdir/out/$out_factory_name.zip"

# the outputs asked for, which are made, along with the target files that they are made from, unless they
# are all there; the target files alone are made when none is asked for
outputs=()
if test -n "$build_ota"; then
	outputs+=("$out_ota")
fi
if test -n "$build_factory"; then
	outputs+=("$outdir/factory")
fi
if test -n "$build_factory_zip"; then
	outputs+=("$out_factory")
fi
outputs_missing=
for i in "${outputs[@]}"; do
	if ! test -e "$i"; then
		outputs_missing=1
	fi
done

if test "${#outputs[@]}" == 0 || test -n "$outputs_missing"; then
	mkdir -p "$outdir/out"
	if test -n "$parallel"; then
		# the factory images are downloaded while the target files are made, and the download is waited
		# for rather than stopped, since killing it would leave its curl writing to the file that
		# making the factory zip goes on to download into; making the target files waits for it if it needs
		# the factory images too, for a pvmfw that is only in them
		background make_factory_download
		background make_file "$outdir/target_files.zip" make_target_files_zip
		wait_background
	else
		make_file "$outdir/target_files.zip" make_target_files_zip
	fi
	# along with the images of the OTA, which only the target files are made from
	discard "$outdir/target_files" "$outdir/target_files_signed.zip" "$dir/ota_payload"

	if test -n "$parallel"; then
		background make_file "$out_ota" make_ota
		background make_file "$out_factory" make_factory_zip
		wait_background
	else
		if test -n "$build_ota"; then
			make_file "$out_ota" make_ota
		fi
		if test -n "$build_factory"; then
			make_dir "$outdir/factory" make_factory
		fi
		if test -n "$build_factory_zip"; then
			make_file "$out_factory" make_factory_zip
		fi
	fi
	# which the factory images and the target files, for a pvmfw that is only in them, were made from
	discard "$dir/factory" "$dir/factory.list" "$dir/factory_image" "$dir/factory_image.list"
fi
# With no OTA or factory output requested, the target files are the output to keep.
if test "${#outputs[@]}" != 0; then
	discard "$outdir/target_files.zip"
fi
# unless it is the factory image asked for with --factory-image
if test -z "$build_factory"; then
	discard "$outdir/factory"
fi

if test -n "$build_factory_zip" && test -n "$sign_factory_images"; then
	make_file "$out_factory.sig" make_factory_zip_sig
fi

if test -n "$build_ota"; then
	function make_metadata {
		ln "$out_ota" "$1/ota.zip"
		local generate_metadata="$aosp/script/generate-metadata"
		if ! test -e "$generate_metadata"; then
			generate_metadata="$aosp/script/generate-metadata.py"
		fi
		if ! test -e "$generate_metadata"; then
			generate_metadata="$aosp/script/generate_metadata.py"
		fi
		"$generate_metadata" "$1/ota.zip"
		rm -f "$1/ota.zip"
	}

	make_dir "$outdir/out_meta" make_metadata

	# replacing those of the OTA made before
	ln -f --target-directory="$outdir/out" "$outdir/out_meta"/*
fi
