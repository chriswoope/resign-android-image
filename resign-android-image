	fi

	base_url="https://releases.grapheneos.org"
	if test "$build" -ge 2024082000; then
		factory_name="$device-install-$build"
		out_factory_word=install
		factory_optimized=1
	else
		factory_name="$device-factory-$build"\
		out_factory_word=factory
		factory_optimized=
	fi
	if [[ $device == @(rango|mustang|blazer|frankel) ]]; then
		max_download_size=$((0x10000000))
	else
		max_download_size=$((0xf900000))
	fi
	factory_url="$base_url/$factory_name"
	ota_url="$base_url/$device-ota_update-$build"
	factory_key="$data_dir/grapheneos-factory.pub"
	factory_identity="contact@grapheneos.org"
	factory_allowed_signers="$data_dir/grapheneos-allowed_signers"
	ota_cert="$data_dir/grapheneos-otacerts/$device.pem"
else
	echo "Unsupported OS: $os"
	exit 1
fi

# the OTA and the factory images are downloaded into the work directory and discarded once extracted,
# unless there is a cache to keep them in, so that they are downloaded and verified only once for any
# number of work directories; the verified ones are marked by a file next to them
if test -n "$download_cache"; then
	mkdir -p "$download_cache"
	ota_zip="$download_cache/${ota_url##*/}.zip"
	factory_zip_dir="$download_cache"
	factory_zip_ok="$download_cache/$factory_name.zip.ok"
else
	ota_zip="$dir/ota.zip"
	factory_zip_dir="$dir/factory_zip"
	factory_zip_ok="$dir/factory_zip.ok"
fi

function discard_download
{
	if test -z "$download_cache"; then
		discard "$@"
	fi
}

# TODO: use Selenium and headless Chromium to automatically download this
otatools="$(realpath "$var_dir/otatools")"
function make_otatools {
	if ! test -e  "$otatools.zip"; then
		otatools_help_and_exit
	fi
	do_unzip "$1" "$otatools.zip"
}

make_dir "$otatools" make_otatools
if test "$android" -ge 130; then
	if ! grep -qE 'Android-1[3-9]' "$otatools/releasetools/common.py"; then
		echo "Outdated otatools: building an Android 13+ image with an otatools version from before Android 13" >&2
		otatools_help_and_exit
	fi
fi

function download_aapt2 {
	curl -C - -o "$otatools.aapt2.zip" https://dl.google.com/dl/android/maven2/com/android/tools/build/aapt2/8.3.0-10880808/aapt2-8.3.0-10880808-linux.jar
	bsdtar -O -x -f "$otatools.aapt2.zip" aapt2 > "$1" || exit 1
	chmod +x "$1"
}

function make_aapt2_wrapper {
	cat - > "$1" <<"EOF"
#!/bin/bash
aapt2="$(dirname "$0")/aapt2.maven"
if test "$1" == dump && test "$2" == badging; then
	exec "$aapt2" "$@"|sed -re 's/^minS(dkVersion:.*)/s\1\nminS\1/'
else
	exec "$aapt2" "$@"
fi
EOF
	chmod +x "$1"
}

# replace aapt2 with Maven version so that it can actually parse Android 14 QPR2 apks
# and wrap it so that it outputs sdkVersion= in addition to minSdkVersion= since sign_target_files_apks expects that
if test -e "$otatools/bin/aapt2" && ! test -e "$otatools/bin/aapt2.otatools"; then
	mv "$otatools/bin/aapt2" "$otatools/bin/aapt2.otatools"
fi
make_file "$otatools/bin/aapt2.maven" download_aapt2
make_file "$otatools/bin/aapt2" make_aapt2_wrapper

function make_deapexer_wrapper {
	cat - > "$1" <<"EOF"
#!/bin/bash
set -euo pipefail
deapexer="$0.otatools"
# the options that come before the command
opts=()
while [[ $# -ge 2 && $1 == --* ]]; do
	opts+=("$1" "$2")
	shift 2
done
# deapexer can only list the files of an ext4 payload, while the signing lists the files of every
# APEX to find the APKs to sign in it, so list those of an erofs one by extracting them
if [[ $# == 2 && $1 == list ]] && python3 -c 'import struct, sys, zipfile
with zipfile.ZipFile(sys.argv[1]).open("apex_payload.img") as f:
    sys.exit(struct.unpack_from("<I", f.read(1028), 1024)[0] != 0xE0F5E1E2)' "$2" 2>/dev/null; then
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' EXIT
	# the signing takes what the command prints on stderr as part of the list as well
	if ! log="$("$deapexer" "${opts[@]}" extract "$2" "$tmp/payload" 2>&1)"; then
		printf '%s\n' "$log" >&2
		exit 1
	fi
	cd "$tmp/payload"
	find . \( -type d -printf '%p/\n' \) -o -printf '%p\n'
else
	exec "$deapexer" "${opts[@]}" "$@"
fi
EOF
	chmod +x "$1"
}

# wrap deapexer so that it can list the files of an erofs APEX payload, like the one of the virt APEX,
# written again every time so that a change to the wrapper takes effect
if ! test -e "$otatools/bin/deapexer.otatools"; then
	mv "$otatools/bin/deapexer" "$otatools/bin/deapexer.otatools"
fi
with_temp "$otatools/bin/deapexer" "mktemp -u" mv make_deapexer_wrapper

export PATH="$otatools/bin:$PATH"
export ANDROID_HOST_OUT="$otatools"

debugfs="$otatools/bin/debugfs_static"
if ! test -x "$debugfs"; then
	debugfs=/sbin/debugfs
fi

blkid="$otatools/bin/blkid_static"
if ! test -x "$blkid"; then
	# by path, like debugfs, since /sbin is only in the PATH of root and of sudo
	blkid=/sbin/blkid
fi

fsckerofs="$otatools/bin/fsck.erofs"
if ! test -x "$fsckerofs"; then
	fsckerofs="$(which fsck.erofs)"
fi

aosp="$var_dir/aosp-$os"
mkdir -p "$aosp/build"
git_clone_ref "$aosp/script" "$git_ref" "$git/script" &
git_clone_ref "$aosp/build/make" "$git_ref" "$git/platform_build" &

wait

for i in CleanSpec.mk buildspec.mk.default core envsetup.sh target tools; do
	if ! test -e "$aosp/build/$i"; then
		ln -s "make/$i" "$aosp/build/$i"
	fi
done

function gen_key {
	openssl genrsa -f4 4096 > "$1"
}

subject='/CN=GrapheneOS/'
function make_pem {
	openssl req -new -x509 -sha256 -key "$2" -out "$1" -days 10000 -subj "$subject"
}

function make_pk8 {
	openssl pkcs8 -in "$2" -topk8 -outform DER -out "$1" -nocrypt
}

function gen_avb_pem {
	openssl genrsa 4096 | openssl pkcs8 -topk8 -nocrypt -out "$1"
}

function make_avb_pkmd {
	"$otatools/bin/avbtool" extract_public_key --key "$2" --output "$1"
}

function gen_signify_key {
	$signify -G -n -p "$1/key.pub" -s "$1/key.sec"
	if ! test -s "$1/key.sec" || ! test -s "$1/key.pub"; then
		echo "Failed to generate keys" >&2
		exit 1
	fi
	mv "$1/key.sec" "$2"
	mv "$1/key.pub" "$3"
}

function gen_ssh_key {
	ssh-keygen -t ed25519 -P '' -f "$1"
}

function make_keys {
	mkdir -p "$key_dir"
	keys="releasekey platform shared media networkstack"
	if test "$android" -ge 130; then
		keys="$keys bluetooth"
	fi
	for i in $keys; do
		if test -n "$generate_keys"; then
			make_file "$key_dir/$i.key" gen_key
		elif ! test -e "$key_dir/$i.key"; then
			echo "Key $key_dir/$i.key not found, use --generate-keys to generate keys automatically" >&2
			exit 1
		fi
		make_file "$key_dir/$i.x509.pem" make_pem "$key_dir/$i.key"
		make_file "$key_dir/$i.pk8" make_pk8 "$key_dir/$i.key"
	done
	if test -n "$generate_keys"; then
		make_file "$key_dir/avb.pem" gen_avb_pem
	elif ! test -e "$key_dir/avb.pem"; then
		echo "Key $key_dir/avb.pem not found, use --generate-keys to generate keys automatically" >&2
		exit 1
	fi
	make_file "$key_dir/avb_pkmd.bin" make_avb_pkmd "$key_dir/avb.pem"
	if test "$sign_factory_images" == signify; then
		if test -n "$generate_keys"; then
			with_temp_dir "$key_dir/factory" gen_signify_key "$key_dir/factory.sec" "$key_dir/factory.pub"
		elif ! test -e "$key_dir/factory.sec"; then
			echo "Key $key_dir/factory.sec not found, use --generate-keys to generate keys automatically" >&2
			exit 1
		elif ! test -e "$key_dir/factory.pub"; then
			echo "Public key $key_dir/factory.pub not found, but secret key $key_dir/factory.sec is present: either delete the private key or regenerate the public key from the private key manually" >&2
			exit 1
		fi
	elif test "$sign_factory_images" == ssh-keygen; then
		if test -n "$generate_keys"; then
			make_file "$key_dir/id_ed25519" gen_ssh_key
		elif ! test -e "$key_dir/id_ed25519"; then
			echo "Key $key_dir/id_ed25519 not found, use --generate-keys to generate keys automatically" >&2
			exit 1
		fi
	fi
}
