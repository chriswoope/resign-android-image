}

function gen_key {
	openssl genrsa -f4 4096 > "$1"
}

subject='/CN=GrapheneOS/'
function make_pem {
	openssl req -new -x509 -sha256 -key "$2" -out "$1" -days 10000 -subj "$subject"
}

function make_pk8 {
	openssl pkcs8 -in "$2" -topk8 -outform DER -out "$1" -nocrypt
}

function gen_avb_pem {
	openssl genrsa "${avb_algorithm##*_RSA}" | openssl pkcs8 -topk8 -nocrypt -out "$1"
}

function make_avb_pkmd {
	"$otatools/bin/avbtool" extract_public_key --key "$2" --output "$1"
}

# the key pair generators write the private key to $1, which make_file moves into place once they are
# done, and the public key to $2
function gen_signify_key {
	# which it only writes to files named like keyname.pub and keyname.sec
	$signify -G -n -p "$1.pub" -s "$1.sec"
	mv -- "$1.pub" "$2"
	mv -- "$1.sec" "$1"
}

function gen_ssh_key {
	ssh-keygen -t ed25519 -P '' -f "$1"
	mv -- "$1.pub" "$2"
}

# in a subshell, so that the umask only applies to the keys, which only the user can read then, whatever
# tool writes them and however it makes the files it writes
function make_keys (
	umask 077
	mkdir -p "$key_dir"
	local keys="releasekey platform shared media networkstack bluetooth"
	# which are only generated all together: a key generated next to others that devices already trust, like an
	# AVB key next to the release key, makes updates that they install and then can't boot, recovery included
	local files=() missing=()
	for i in $keys; do
		files+=("$key_dir/$i.key")
	done
	files+=("$key_dir/avb.pem")
	for i in "${files[@]}"; do
		if ! test -e "$i"; then
			missing+=("$i")
		fi
	done
	if test -n "$generate_keys" && test "${#missing[@]}" != 0 && test "${#missing[@]}" != "${#files[@]}"; then
		echo "--generate-keys only generates all the keys together, but only ${missing[*]} are missing: devices trusting the others would install updates signed with new ones and fail to boot them, so put them back, or make them yourself if new ones are really what you want" >&2
		exit 1
	fi
	for i in $keys; do
		if test -n "$generate_keys"; then
			make_file "$key_dir/$i.key" gen_key
		elif ! test -e "$key_dir/$i.key"; then
			echo "Key $key_dir/$i.key not found, use --generate-keys to generate keys automatically" >&2
			exit 1
		fi
		make_file "$key_dir/$i.x509.pem" make_pem "$key_dir/$i.key"
		make_file "$key_dir/$i.pk8" make_pk8 "$key_dir/$i.key"
		# which are only made when missing, so they can be left from another key: a recovery trusting a
		# certificate that the OTAs are not signed with would refuse every update
		local public
		public="$(openssl pkey -in "$key_dir/$i.key" -pubout)"
		if test "$(openssl x509 -in "$key_dir/$i.x509.pem" -noout -pubkey)" != "$public" || test "$(openssl pkey -inform DER -in "$key_dir/$i.pk8" -pubout)" != "$public"; then
			echo "$key_dir/$i.x509.pem or $key_dir/$i.pk8 doesn't have the public key of $key_dir/$i.key: devices trust only the key their images were signed with, so put that key back, or delete them to have them made from the new one" >&2
			exit 1
		fi
	done
	# A matching key pair is not enough: recovery rejects unsupported certificate/key parameters.
	python3 "$data_dir/target_files_inputs.py" recovery-cert-check "$key_dir/releasekey.x509.pem"
	if test -n "$generate_keys"; then
		make_file "$key_dir/avb.pem" gen_avb_pem
	elif ! test -e "$key_dir/avb.pem"; then
		echo "Key $key_dir/avb.pem not found, use --generate-keys to generate keys automatically" >&2
		exit 1
	fi
	make_file "$key_dir/avb_pkmd.bin" make_avb_pkmd "$key_dir/avb.pem"
	# likewise, since a bootloader locked with a key that vbmeta isn't signed with boots neither the system
	# nor the recovery
	if ! "$otatools/bin/avbtool" extract_public_key --key "$key_dir/avb.pem" --output -|cmp -s - "$key_dir/avb_pkmd.bin"; then
		echo "$key_dir/avb_pkmd.bin doesn't have the public key of $key_dir/avb.pem: a bootloader locked with it only boots images signed with the key it was made from, so put that key back, or delete it to have it made from the new one" >&2
		exit 1
	fi
	# and its number of bits, the first field of the public key, has to be the one of the algorithm
	local avb_key_bits
	avb_key_bits="$(od -An -tu4 --endian=big -N4 "$key_dir/avb_pkmd.bin")"
	avb_key_bits="${avb_key_bits//[!0-9]/}"
	if test "$avb_key_bits" != "${avb_algorithm##*_RSA}"; then
		echo "$key_dir/avb.pem is a $avb_key_bits bit key, while the images are signed with $avb_algorithm, which the images in the virt APEX can only be signed again with, so it has to be a ${avb_algorithm##*_RSA} bit RSA key" >&2
		exit 1
	fi
	if test "$sign_factory_images" == signify; then
		if test -n "$generate_keys"; then
			make_file "$key_dir/factory.sec" gen_signify_key "$key_dir/factory.pub"
		elif ! test -e "$key_dir/factory.sec"; then
			echo "Key $key_dir/factory.sec not found, use --generate-keys to generate keys automatically" >&2
			exit 1
		fi
		if ! test -e "$key_dir/factory.pub"; then
			echo "Public key $key_dir/factory.pub not found, but secret key $key_dir/factory.sec is present: either delete the private key or regenerate the public key from the private key manually" >&2
			exit 1
		fi
	elif test "$sign_factory_images" == ssh-keygen; then
		if test -n "$generate_keys"; then
			make_file "$key_dir/id_ed25519" gen_ssh_key "$key_dir/id_ed25519.pub"
		elif ! test -e "$key_dir/id_ed25519"; then
			echo "Key $key_dir/id_ed25519 not found, use --generate-keys to generate keys automatically" >&2
			exit 1
		fi
	fi
)
make_keys

