# set ota_payload_offset to the offset of the payload in the A/B OTA zip $1, which its metadata gives,
# for the payload to be read where it is rather than extracted
function ota_payload_offset {
	ota_payload_offset="$(unzip -p "$1" META-INF/com/android/metadata|sed -nre 's/^ota-property-files=(.*,)?payload\.bin:([0-9]+):.*/\2/p')"
	if test -z "$ota_payload_offset"; then
		echo "The metadata of $1 doesn't give the offset of its payload" >&2
		exit 1
	fi
}

# extract the images of the partitions of the payload of OTA zip $2, whose names are in file $3, into
# directory $1, in parallel since ota_extractor extracts the partitions it is given one after the other
function do_extract_ota_payload {
	ota_payload_offset "$2"
	xargs -d '\n' -a "$3" -P "$threads" -I {} "$otatools/bin/ota_extractor" -payload "$2" -payload_offset "$ota_payload_offset" -output_dir "$1" -partitions {}
}

function do_extract_ota_manifest {
	python3 "$data_dir/extract_android_ota_manifest/extract_android_ota_manifest.py" "$2" "$1"
