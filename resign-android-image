# signapk writes an APK through a ZipOutputStream, which writes the fields of the zip headers a byte at a
# time, to an unbuffered FileOutputStream, making a system call for each byte: buffer the CountingOutputStream
# that everything it writes goes through, which makes it several times faster and writes the same bytes
# make the signapk.jar $2 in the directory $1
function make_signapk_jar_in {
	local src="$aosp/build/make/tools/signapk/src/com/android/signapk/CountingOutputStream.java"
	local patched="$1/CountingOutputStream.java"
	sed -re 's/^(\s*mBase = )base;$/\1new java.io.BufferedOutputStream(base);/' "$src" > "$patched"
	if cmp -s "$src" "$patched"; then
		echo "There is no assignment of the stream to write to in $src" >&2
		exit 1
	fi
	# javac, which the Java runtime has without the JDK
	java -m jdk.compiler/com.sun.tools.javac.Main -d "$1/classes" "$patched"
	cp "$otatools/framework/signapk.jar.otatools" "$2"
	(cd "$1/classes" && zip -q -X -D -r "$2" com)
}

function make_signapk_jar {
	with_temp_dir "$1.build" make_signapk_jar_in "$1"
}

make_file "$otatools/framework/signapk.jar" make_signapk_jar

# the Java options that sign_target_files_apks runs signapk with, which replace its default ones, the maximum
# heap size among them
signapk_java_args=(-Xmx4096m)
