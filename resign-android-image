# print the name, the type, the mode, the size and either the target or the contents of every file of a
# directory tree, sorted and NUL separated so that any file name works, to compare two trees by
# everything that extracting an APEX payload preserves
function tree_manifest {
	(
		cd "$1"
		find . -mindepth 1 -printf '%p %y %#m %s %l\0'|sort -z
		find . -mindepth 1 -type f -print0|sort -z|xargs -0 -r sha256sum
	)
}

function patch_apex {
	local work="$1"
	local out="$2"
	local apex="$3"
	local cmd="$4"
	shift 4

	type="$(deapexer info --print-type "$apex")"
	if test "$type" == COMPRESSED; then
		deapexer decompress --input "$apex" --output "$work"/original.apex
	else
		ln "$apex" "$work"/original.apex
	fi

	deapexer extract "$work"/original.apex "$work"/payload
	remove_apex_manifests "$work/payload"

	"$cmd" "$work/payload" "$@"

	unzip -q -x -d "$work/apex" "$work"/original.apex

	# apexer takes the SELinux file contexts, the uid, gid and mode of every file and the type of the
	# filesystem to build from the build info of the original APEX, which is the only thing that can
	# restore what extracting the payload dropped: deapexer restores neither the owners nor the
	# extended attributes, so without it the repacked APEX would silently lose every SELinux label
	# (which is how the bpf programs of the tethering APEX are allowed to be loaded) and the setuid
	# bit and owner of files like its bin/for-system/clatd
	if ! test -e "$work/apex/apex_build_info.pb"; then
		echo "$apex has no apex_build_info.pb, so it cannot be repacked without losing the file contexts and ownership of its payload" >&2
		exit 1
	fi

	args=()
	if test -e "$work/apex/apex_manifest.json"; then
		args+=(--manifest_json "$work/apex/apex_manifest.json")
	fi
	# apexer always signs the payload with SHA256_RSA4096, which fails with a 2048 bit AVB key, so
	# pass the algorithm of the key on to avbtool, which takes the last --algorithm it is given
	"$otatools/bin/apexer" --force --payload_only --do_not_check_keyname --key "$key_dir"/avb.pem --signing_args "--algorithm $(get_avb_algorithm)" --apexer_tool_path "$otatools/bin:$PATH" --manifest "$work/apex/apex_manifest.pb" --build_info "$work/apex/apex_build_info.pb" "${args[@]}" "$work/payload" "$work/apex_payload.img"

	cp "$work/original.apex" "$work/modded.apex"
	modded_apex_r="$(realpath "$work/modded.apex")"
	(cd "$work" && zip -0 "$modded_apex_r" apex_payload.img)
	# apexd mounts the payload out of the APEX where it is, so it has to stay page aligned in it
	"$otatools/bin/zipalign" -f 4096 "$work/modded.apex" "$work/aligned.apex"

	# extracting the repacked APEX again has to give back exactly what apexer was given, so that a
	# payload that lost a file, a symbolic link, a permission bit or a byte on the way makes the build
	# fail rather than the device not boot
	deapexer extract "$work/aligned.apex" "$work/repacked"
	remove_apex_manifests "$work/repacked"
	if ! cmp -s <(tree_manifest "$work/payload") <(tree_manifest "$work/repacked"); then
		echo "Repacking $apex did not preserve its payload:" >&2
		# the manifests are NUL separated to hold any file name, so make them printable to show them
		diff <(tree_manifest "$work/payload"|tr '\0' '\n') <(tree_manifest "$work/repacked"|tr '\0' '\n') >&2 || true
		exit 1
	fi

	# the SELinux label of each file is the one thing that extracting the payload doesn't keep, and it
	# is what allows the bpf programs of the tethering APEX to be loaded at boot, so compare the labels
	# in the images themselves; deapexer can only list an ext4 payload, whose superblock holds the
	# 0x53ef magic at offset 0x438, rather than an erofs or f2fs one
	if test "$(dd if="$work/apex/apex_payload.img" bs=1 skip=$((0x438)) count=2 status=none)" == $'\xef\x53'; then
		if ! diff <(deapexer list -Z "$work/original.apex"|sort) <(deapexer list -Z "$work/aligned.apex"|sort) >&2; then
			echo "Repacking $apex changed the SELinux labels of its payload" >&2
			exit 1
		fi
	fi

	if test "$type" == COMPRESSED; then
		# apex_compression_tool tries to make an hardlink from the input to /tmp, so we need to copy it to /tmp
		aligned_tmp="$(mktemp)"
		cp -a "$work"/aligned.apex "$aligned_tmp"
		"$otatools/bin/apex_compression_tool" compress --apex_compression_tool_path "$otatools/bin:$PATH" --input "$aligned_tmp" --output "$work/out.apex"
	else
		ln "$work"/aligned.apex "$work/out.apex"
	fi
	ln -f "$work/out.apex" "$out"
}


function patch_apk_raw {
	local out_zip="$1/zip.zip"
	local files="$1/files"
	local out="$2"
	local in_zip="$3"
	local cmd="$4"
	shift 4

	mkdir -p "$files"
	unzip -x -d "$files" "$in_zip"
	"$cmd" "$files" "$@"
	out_zip_r="$(realpath "$out_zip")"
	bsdtar -tf "$in_zip"|(cd "$files" && zip -0 -@ "$out_zip_r")
	rm -f "$out"
	"$otatools/bin/zipalign" -f -p 4 "$out_zip" "$out"
}

function patch_adbd {
	# the patched bytes are written into the output, which is the input itself when adbd is patched
	# where it is inside an APEX payload or a ramdisk, and otherwise a copy of it
	if test "$1" != "$2"; then
		cp -a "$2" "$1"
	fi

	# the calls are found by their address in memory, which lld doesn't keep equal to their offset in
	# the file, so the loadable segments are needed to turn one into the other
	local -a seg_off=() seg_addr=() seg_size=()
	local type off addr size
	while read -r type off addr _ size _; do
		if test "$type" == LOAD; then
			seg_off+=("$off")
			seg_addr+=("$addr")
			seg_size+=("$size")
		fi
	done < <(llvm-readelf -lW "$2")
	wait $!

	# non-LLVM objdump fails to annotate calls to the PLT with the symbol name, and LLVM 17 and later
	# print an AArch64 instruction as a single word rather than as four bytes
	local call_re='^\s*([0-9a-f]+):\s*([0-9a-f]{8}|[0-9a-f]{2}( [0-9a-f]{2}){3})\s+bl\s+0x[0-9a-f]+\s+<__android_log_is_debuggable@plt>$'
	local -i patched=0
	local call i
	while read -r call; do
		for i in "${!seg_addr[@]}"; do
			if (( 0x$call >= seg_addr[i] && 0x$call < seg_addr[i] + seg_size[i] )); then
				# mov w0,#0x1
				printf '\x20\x00\x80\x52'|dd of="$1" bs=1 seek=$((0x$call - seg_addr[i] + seg_off[i])) conv=notrunc status=none
				patched+=1
			fi
		done
	done < <(llvm-objdump -d "$2"|sed -nre "s/$call_re/\1/p")
	wait $!

	# an adbd left unpatched builds and boots fine, and only refuses to restart as root on the device,
	# so a change in the disassembly or in adbd must make the build fail instead
	if test "$patched" == 0; then
		echo "Found no call to __android_log_is_debuggable to patch in $2" >&2
		exit 1
	fi
	if llvm-objdump -d "$1"|grep -E "$call_re" >&2; then
		echo "Patching $1 left the calls to __android_log_is_debuggable above in place" >&2
		exit 1
	fi
}

function patch_adbd_in_root {
	for dir in "$@"; do
		patch_adbd "$dir/bin/adbd" "$dir/bin/adbd"
	done
}

# bodies of the methods replaced below, as instructions for patch_dex.py
dex_return_false=$'const/4 v0, 0\nreturn v0'
dex_return_void='return-void'
# an allocated list first, since the caller of a method that used to return a list it had just built can
# expect to be able to modify it, and the immutable one only if the dex doesn't refer to ArrayList
dex_return_empty_list=$'new-instance v0, Ljava/util/ArrayList;\ninvoke-direct {v0}, Ljava/util/ArrayList;.<init>:()V\nreturn-object v0\nor\ninvoke-static {}, Ljava/util/Collections;.emptyList:()Ljava/util/List;\nmove-result-object v0\nreturn-object v0'

# patch the code in the dex files of a jar or an APK by binary-patching them where they are inside it
# rather than disassembling and reassembling them with apktool or even taking them out of the zip and
# putting them back, so that nothing but the patched instructions changes: $1 is the zip to write, $2 is
# the zip to patch, which can be the same file, and the remaining arguments are the edits to apply, three
# arguments each, as documented in patch_dex.py
function patch_dex_in_zip {
	local out="$1"
	local in_zip="$2"
	shift 2

	if test "$out" != "$in_zip"; then
		cp -a "$in_zip" "$out"
	fi

	# the edits are passed on stdin since there can be any number of them
	printf '%s\0' "$@"|python3 "$data_dir/patch_dex.py" "$out"
}

# make WindowState.isSecureLocked() always return false so that FLAG_SECURE windows (and any other
# app or policy request to block screen capture) are treated as non-secure: this is the single point
# the window manager uses to mark a window's surface as secure, so screenshots, screen recording and
# casting can then always capture every window
patch_window_secure=(method 'WindowState.isSecureLocked:()Z' "$dex_return_false")

# make ActivityRecord.shouldUseAppThemeSnapshot() always return false so that the task snapshot used for
# the recents/app switcher preview is always a real screenshot of the activity. An app can blank that
# preview without setting FLAG_SECURE at all, by calling Activity.setRecentsScreenshotEnabled(false)
# (Activity.setDisablePreviewScreenshots() before Android 13), which only sets the flag that this method
# reads; the method also returns true for activities with a secure window, which patch_window_secure
# already takes care of
patch_recents_screenshot=(method 'ActivityRecord.shouldUseAppThemeSnapshot:()Z' "$dex_return_false")

# make WindowManagerService.notifyScreenshotListeners() always return an empty list so that no app is ever
# told that a screenshot of it was taken. Android 14 added Activity.registerScreenCaptureCallback(), which
# apps use to log the user out or nag them for exercising control over their own device; this method is
# where the window manager both dispatches the callback to the activities on the display and reports back
# which ones it notified, so emptying it stops the notification at its source while leaving registration
# working, so that nothing an app does throws
patch_screenshot_listeners=(method 'WindowManagerService.notifyScreenshotListeners:(I)Ljava/util/List;' "$dex_return_empty_list")

# make WindowManagerService.registerScreenRecordingCallback() always return false so that no app is ever
# told that the screen is being recorded. Android 15 added Activity.registerScreenRecordingCallback(), the
# screen recording counterpart of the screenshot detection neutered by patch_screenshot_listeners, which
# ScreenRecordingCallbackController implements by watching MediaProjection and calling
# onScreenRecordingStateChanged() on every registered callback. The return value is the current recording
# state, so returning false both refuses the registration and reports that no recording is in progress
patch_screen_recording_callback=(method 'WindowManagerService.registerScreenRecordingCallback:(Landroid/window/IScreenRecordingCallback;)Z' "$dex_return_false")

# make SurfaceView.setSecure() a no-op. It is the only way an app can get a secure surface without setting
# FLAG_SECURE on its window: it sets the SurfaceControl.SECURE flag on the SurfaceView's own surface
# directly, in the app's own process, which is why this must be patched in framework.jar rather than
# alongside patch_window_secure in services.jar. The other ways of setting that flag,
# SurfaceControl.Builder.setSecure() and SurfaceControl.Transaction.setSecure(), are hidden API that
# ordinary apps cannot reach.
#
# This is why it is a separate option from --always-screenshot rather than part of it: a player of
# DRM-protected video calls SurfaceView.setSecure(true) precisely because a hardware DRM (Widevine L1)
# secure decoder can only output into a surface whose SurfaceControl is secure, so taking that away makes
# such playback fail or fall back to a software (L3) path with a lower resolution. There is no way to keep
# only half of the flag: it is the same bit that makes the surface accept hardware-protected buffers and
# that excludes it from screen capture. Removing it also doesn't make the protected video capturable
# anyway, since a hardware-protected buffer is unreadable by the compositor no matter what any flag says;
# what it does gain is capturing the surfaces of apps that use setSecure() with ordinary, unprotected
# content, purely to stop the user from taking a screenshot
patch_surface_secure=(method 'SurfaceView.setSecure:(Z)V' "$dex_return_void")

# make injected mock/test-provider locations indistinguishable from real ones. The system server's mock
# location provider marks every Location it injects by calling Location.setIsFromMockProvider(true),
# which is the only thing that sets the HAS_MOCK_PROVIDER_MASK bit later read back by Location.isMock()
# and Location.isFromMockProvider() and carried across the Binder parcel to every app. Replace every one
# of those calls with nops so the bit is never set at the source, leaving nothing for an app to detect;
# what is left behind is the code computing the arguments of the call into registers that nothing reads
# any more, which is harmless. The disassembly of such a call looks like
#     invoke-virtual {v0, v1}, Landroid/location/Location;.setIsFromMockProvider:(Z)V // method@1234
patch_location_mock=(replace 'invoke-virtual(/range)? \{[^}]*\}, Landroid/location/Location;\.setIsFromMockProvider:\(Z\)V.*' '')

# make every app's playback capturable through the AudioPlaybackCapture (MediaProjection) API regardless
# of whether the app opted out. AudioAttributes.capturePolicyToFlags() is the single point that turns a
# capture policy into the FLAG_NO_MEDIA_PROJECTION (0x400) and FLAG_NO_SYSTEM_CAPTURE (0x1000) attribute
# flags that the audio server reads to refuse capture. Both ways of opting out funnel through it: an app
# setting a policy on its own AudioAttributes via setAllowedCapturePolicy(), and the per-process policy
# derived from the app's manifest android:allowAudioPlaybackCapture flag, which AudioService turns into
# flags with this same method. Rewrite it to always clear both flags (i.e. behave as ALLOW_CAPTURE_BY_ALL
# for everyone) so a recording app can capture the output of any app whose audio goes through the software
# mixer, including VoIP/communication apps. Since framework.jar is loaded into every app process, this
# clears the flags in the process that plays the audio, which is where the audio server takes them from.
# (Audio of cellular phone calls travels a hardware path that never reaches the mixer and so cannot be
# captured by any software change.)
# p1 is the flags argument and -0x1401 == ~(0x400 | 0x1000)
patch_audio_capture_policy=(method 'AudioAttributes.capturePolicyToFlags:(II)I' $'const/16 v0, -0x1401\nand-int/2addr p1, v0\nreturn p1')

# make every app backupable regardless of whether its manifest says android:allowBackup="false", by
# replacing (applicationInfo.flags & FLAG_ALLOW_BACKUP) with the flag itself wherever Seedvault tests it,
# so that the test always passes. 0x8000 doesn't fit in the literal of an and-int instruction, so it is
# always loaded into a register first and the and can always be turned into a move of that register:
#     iget v2, v4, Landroid/content/pm/ApplicationInfo;.flags:I // field@0123
#     const v3, #float 0.000000 // #00008000
#     and-int/2addr v2, v3
# The Seedvault of recent builds doesn't test the flag any more, leaving nothing to patch
patch_seedvault=(replace-if-found $'iget (v[0-9]+), v[0-9]+, Landroid/content/pm/ApplicationInfo;\\.flags:I.*\nconst(?:/[0-9a-z]+)? (v[0-9]+), .*#0*8000\nand-int/2addr \\1, \\2' 'move \1, \2')

# for --adb-until-unlock, have the system server come up believing that USB ADB is enabled, so that ADB
# keeps working once it takes the USB gadget over from init, which it otherwise immediately takes the
# ADB function away from.
# AdbService.systemReady() sets the field holding that belief from the persist.sys.usb.config property
# and then writes what it decided to the adb_enabled setting, so turning ADB on the way the framework
# expects would enable USB debugging in /data for good; assigning the field alone touches neither, so
# ADB is on for as long as this boot lasts, which is all that debugging a boot needs, and the next boot
# starts from whatever the settings say again. The original body also restores wireless debugging from
# its own property, which is lost: it has to be enabled again in the settings after every boot
patch_adb_until_unlock=(method 'AdbService.systemReady:()V' $'const/4 v0, 1\niput-boolean v0, p0, Lcom/android/server/adb/AdbService;.mIsAdbUsbEnabled:Z\nreturn-void')

# apply dex patches to one of the jars in /system/framework: $1 is the target_files directory being
# built, $2 is the name of the jar and the remaining arguments are the edits to apply to it.
# Unlike the jars inside an APEX, these jars aren't APK-signed (their integrity comes from AVB), so they
# can be patched directly like a plain system file; the stale precompiled artifacts under
# /system/framework/oat no longer match the rewritten jar, so the runtime discards them and runs the
# patched dex instead
function patch_framework_jar {
	local out="$1"
	local jar="$2"
	shift 2

	if ! test -e "$outdir/target_files_extracted/SYSTEM/framework/$jar"; then
		echo "$jar not found in the system image, cannot patch it" >&2
		exit 1
	fi

	mkdir -p "$out/SYSTEM/framework"
	patch_dex_in_zip {"$out","$outdir/target_files_extracted"}/SYSTEM/framework/"$jar" "$@"
}

function patch_service_connectivity {
	local jar="$1/javalib/service-connectivity.jar"
	if ! test -e "$jar"; then
		echo "service-connectivity.jar not found in the tethering APEX" >&2
		exit 1
	fi

	# make BpfNetMaps$Dependencies.isLoopbackChecksEnabled() return false so that the loopback checks
	# introduced in Android 17 are never enforced
	patch_dex_in_zip "$jar" "$jar" method 'BpfNetMaps$Dependencies.isLoopbackChecksEnabled:()Z' "$dex_return_false"
}

function patch_updater {
	for i in "$1/res/values/strings.xml" "$1/resources.arsc"; do
		if test -e "$i"; then
			sed -i -e "s|$orig_update_url|$update_url|g" "$i"
		fi
	done
}

function make_target_files_intermediates_base {
	make_file "$outdir/target_files_extracted.done" make_target_files_extracted

	# the files are patched at the same time, since each of them takes a while
	local background_pids=()

	if test "$update_url" != "$orig_update_url"; then
		mkdir -p "$1/SYSTEM/priv-app/Updater"
		background with_temp_dir "$outdir/patch-updater" patch_apk_raw {"$1","$outdir/target_files_extracted"}/SYSTEM/priv-app/Updater/Updater.apk patch_updater
	fi

	if test -n "$adb_root"; then
		for i in SYSTEM/apex/com.android.adbd.apex SYSTEM/apex/com.android.adbd.capex; do
			if test -e "$outdir/target_files_extracted/$i"; then
				mkdir -p "$1/SYSTEM/apex"
				background with_temp_dir "$outdir/patch-adbd-apex" patch_apex {"$1","$outdir/target_files_extracted"}/"$i" patch_adbd_in_root
			fi
		done
		if test -e "$outdir/target_files_extracted/SYSTEM/bin/adbd"; then
			mkdir -p "$1/SYSTEM/bin"
			background patch_adbd {"$1","$outdir/target_files_extracted"}/SYSTEM/bin/adbd
		fi
	fi

	if test -n "$adb_keys_content"; then
		# adbd only ever looks for keys in /adb_keys and in /data/misc/adb/adb_keys, and the latter is
		# wiped along with the user data and can only be written by a device that boots far enough to
		# show the authorization dialog, so the keys go in the former, which on a system-as-root device
		# is a file at the root of the system image. The SELinux policy of the build labeling it is how
		# we check that this Android version still reads the file
		if ! grep -qE '^/adb_keys\s' "$outdir/target_files_extracted/SYSTEM/etc/selinux/plat_file_contexts"; then
			echo "The SELinux file contexts have no entry for /adb_keys, so adbd would not be allowed to read it" >&2
			exit 1
		fi
		mkdir -p "$1/ROOT"
		# in the unlikely case that the build ships keys of its own, keep them
		if test -e "$outdir/target_files_extracted/ROOT/adb_keys"; then
			cat "$outdir/target_files_extracted/ROOT/adb_keys" > "$1/ROOT/adb_keys"
		fi
		printf '%s' "$adb_keys_content" >> "$1/ROOT/adb_keys"
	fi

	if test -n "$adb_at_boot"; then
		# the USB-C port setting of GrapheneOS is stored in a property, whose name is checked here so
		# that a rename doesn't silently leave the data lines cut for the whole of the boot to debug
		if ! grep -q -w persist.security.usb_mode "$outdir/target_files_extracted/SYSTEM/etc/selinux/plat_property_contexts"; then
			echo "Warning: the SELinux property contexts have no entry for persist.security.usb_mode, so this build may take the USB-C port mode from something else" >&2
		fi
		mkdir -p "$1/SYSTEM/etc/init"
		# init parses every .rc file in /system/etc/init
		cat > "$1/SYSTEM/etc/init/resign-adb.rc" <<'EOF'
# ADB at boot, added by resign-android-image --adb-at-boot or --adb-until-unlock

# turn ADB on as early as possible, so that a boot that hangs before the system server is up can be
# debugged as well
on early-init
    setprop sys.usb.config adb

on property:ro.persistent_properties.ready=true
    # the USB-C port setting of GrapheneOS, set once the persistent properties have been read from
    # /data since they would override it otherwise: 3 is "charging-only when locked, except before
    # first unlock", while the default of 2 cuts the USB data lines whenever the device is locked,
    # which includes the whole of a boot that never reaches an unlock
    setprop persist.security.usb_mode 3
EOF
		if test -z "$adb_until_unlock"; then
			cat >> "$1/SYSTEM/etc/init/resign-adb.rc" <<'EOF'

# turn USB debugging on the way a debuggable build does: init mirrors persist.sys.usb.config into
# sys.usb.config at boot, and the system server enables USB debugging from it, so ADB stays on after
# either takes over. This also turns on the adb_enabled setting, so USB debugging shows as on in
# Settings, and turning it off there only lasts until the next boot
on property:ro.persistent_properties.ready=true
    setprop persist.sys.usb.config adb
EOF
		else
			cat >> "$1/SYSTEM/etc/init/resign-adb.rc" <<'EOF'

# only the non-persistent sys.usb.config is set, so that nothing is written to /data and the
# framework, which reads persist.sys.usb.config once at boot to decide whether USB debugging is on,
# keeps using and showing the setting chosen in Settings: services.jar is patched so that the system
# server keeps ADB on regardless. It is set again once the persistent properties have been read from
# /data, since the rule that mirrors persist.sys.usb.config into sys.usb.config has just turned ADB
# back off
on boot
    setprop sys.usb.config adb

# the device has been unlocked, so the boot worked and the debugging access is not needed any more
on property:sys.user.0.ce_available=true
    stop adbd
EOF
		fi
	fi

	if test -n "$cross_profile_localhost"; then
		local patched=
		for i in SYSTEM/apex/com.android.tethering.apex SYSTEM/apex/com.android.tethering.capex; do
			if test -e "$outdir/target_files_extracted/$i"; then
				mkdir -p "$1/SYSTEM/apex"
				background with_temp_dir "$outdir/patch-tethering-apex" patch_apex {"$1","$outdir/target_files_extracted"}/"$i" patch_service_connectivity
				patched=1
			fi
		done
		if test -z "$patched"; then
			echo "Failed to find the tethering APEX containing service-connectivity.jar" >&2
			exit 1
		fi
	fi

	# collect the dex edits to apply to each of the jars in /system/framework and run each jar's edits in
	# a single pass, since separate passes would each start from the original jar and clobber the others'
	# output
	local services_jar_patches=()
	local framework_jar_patches=()
	if test -n "$always_screenshot"; then
		services_jar_patches+=("${patch_window_secure[@]}" "${patch_recents_screenshot[@]}" "${patch_screenshot_listeners[@]}" "${patch_screen_recording_callback[@]}")
	fi
	if test -n "$always_screenshot_surfaceview"; then
		framework_jar_patches+=("${patch_surface_secure[@]}")
	fi
	if test -n "$no_location_ismock"; then
		services_jar_patches+=("${patch_location_mock[@]}")
	fi
	if test -n "$record_anything"; then
		framework_jar_patches+=("${patch_audio_capture_policy[@]}")
	fi
	if test -n "$adb_until_unlock"; then
		services_jar_patches+=("${patch_adb_until_unlock[@]}")
	fi
	if test "${#services_jar_patches[@]}" != 0; then
		background patch_framework_jar "$1" services.jar "${services_jar_patches[@]}"
	fi
	if test "${#framework_jar_patches[@]}" != 0; then
		background patch_framework_jar "$1" framework.jar "${framework_jar_patches[@]}"
	fi

	if test -n "$allowbackup"; then
		if test -e "$outdir/target_files_extracted/SYSTEM/priv-app/Seedvault/Seedvault.apk"; then
			mkdir -p "$1/SYSTEM/priv-app/Seedvault"
			background patch_dex_in_zip {"$1","$outdir/target_files_extracted"}/SYSTEM/priv-app/Seedvault/Seedvault.apk "${patch_seedvault[@]}"
		fi
	fi

	wait_background

	cp -a -n -l --target-directory="$1" "$outdir/target_files_extracted"/*

	if test "$build_method" == resign; then
		cp -a -n -l --target-directory="$1" "$outdir/boot_inputs/target_files"/*
		if test -n "$allowbackup"; then
			# its precompiled code no longer matches the patched APK
			rm -rf "$1/SYSTEM/priv-app/Seedvault/oat"
		fi
		# the images are built out of these files by the signing
		apply_modifications "$1"
	fi
}


function make_misc_info {
	if false; then
	cat ->"$1" <<EOF
recovery_api_version=99999
fstab_version=2
ab_update=true
verity=true
avb_enable=true
lz4_ramdisks=true
avb_avbtool=avbtool
EOF
	else
		# TODO: properly create this instead of copying one from a raven build from source and hoping it works
		grep -vE 'selinux_fc=|vintf_enforce=|^building_|^avb_building_' "$data_dir/misc_info-raven.txt" > "$1"
		# and the dynamic partitions as the payload has them, since the last value of an entry is the
		# one that counts and those of the build misc_info-raven.txt comes from are not the same
		cat "$dir/ota_payload/META/misc_info.txt" "$dir/ota_payload/META/dynamic_partitions_info.txt" >> "$1"
		if test -e "$dir/ota_payload/init_boot.img"; then
			echo "init_boot=true" >> "$1"
			echo "init_boot_size=$(stat -c "%s" -- "$dir/ota_payload/init_boot.img")" >> "$1"
		fi
	fi

	if test "$build_method" == resign; then
		# have the signing build the filesystem images out of their files, as it does for a normal
		# build, and give them the same hashtree footer as the original images
		local dynamic=" $(sed -nre 's/^dynamic_partition_list=//p' "$dir/ota_payload/META/dynamic_partitions_info.txt") "
		local b
		for b in $image_parts; do
			if test -e "$dir/ota_payload/$b.img"; then
				printf '%s\n' "building_${b}_image=true" "${b}_fs_type=ext4" "${b}_selinux_fc=file_contexts.bin" "${b}_disable_sparse=true" >> "$1"
				python3 "$data_dir/target_files_inputs.py" avb-args "$b" "$dir/ota_payload/$b.img" >> "$1" || exit 1
				# the size of a dynamic partition is the size of its image, while the AVB footer of the
				# image of any other partition must be at the end of the partition
				if [[ $dynamic != *" $b "* ]]; then
					echo "${b}_size=$(stat -c %s -- "$dir/ota_payload/$b.img")" >> "$1"
				fi
			fi
		done

		# and the boot images and vbmeta, with the dtbo and pvmfw images taken as prebuilt ones that the
		# build adds a footer to
		cat "$outdir/boot_inputs/misc_info.txt" >> "$1"
		if test -e "$dir/ota_payload/dtbo.img"; then
			python3 "$data_dir/target_files_inputs.py" avb-args dtbo "$dir/ota_payload/dtbo.img" >> "$1" || exit 1
		fi
		if test -e "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw.img"; then
			echo has_pvmfw=true >> "$1"
			python3 "$data_dir/target_files_inputs.py" avb-args pvmfw "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw.img" >> "$1" || exit 1
		fi
		if test -n "$replace_boot"; then
			python3 "$data_dir/target_files_inputs.py" avb-args boot "$dir/ota_payload/boot.img" >> "$1" || exit 1
		fi
		check_vbmeta_partitions
		printf '%s\n' avb_building_vbmeta_image=true "avb_vbmeta_args=--padding_size 4096 $(get_avbtool_vbmeta_opts "$dir/ota_payload/vbmeta.img"|tr '\n' ' ')" >> "$1"
	fi
}

# check that vbmeta only verifies partitions that the signing builds the images of, as for a normal build
function check_vbmeta_partitions {
	if [[ $("$otatools/bin/avbtool" info_image --image "$dir/ota_payload/vbmeta.img") == *"Chain Partition descriptor"* ]]; then
		echo "vbmeta chains to other vbmeta images, which is not supported" >&2
		exit 1
	fi
	local p
	for p in $(get_avbtool_partitions "$dir/ota_payload/vbmeta.img"); do
		if ! [[ " $signed_images " == *" $p "* ]]; then
			echo "vbmeta verifies $p, which there is no way to build the image of" >&2
			exit 1
		fi
	done
}

# write the fs_config and file_contexts files that the images are going to be built with, so that the
# files have the metadata they have in the original images, and the metadata the built images are
# expected to have to $1
function make_fs_config {
	local args=() b
	for b in $image_parts; do
		if test -e "$outdir/fs_metadata/$b.json"; then
			args+=("$b" "$outdir/fs_metadata/$b.json")
		fi
	done
	python3 "$data_dir/target_files_inputs.py" fs-config "$outdir/target_files_intermediates" "$1" "${args[@]}"
}

function make_dynamic_partitions_info {
	cp "$dir"/ota_payload/META/dynamic_partitions_info.txt "$1"
}

function make_certs_mac {
	(shared=; cd "$outdir"/target_files_intermediates && find . -name '*mac_permissions.xml'|(while IFS= read -r f; do d="$(echo $f|sed -re 's,./([^/]*)/.*,\1,')"; grep --only-matching -E 'signature="[^"]*"><seinfo value="[^"]*"' "$f"|sed -re 's/^signature="([^"]*)".* value="([^"]*)"/\1 \2/'|while read i v; do k=""; case $v in base) if test -z "$shared"; then k=shared; shared=1; else k=testkey; fi;; network_stack) k=networkstack;; media) k=media;; platform) k=platform;; bluetooth) k=bluetooth;; esac; if test -n "$k"; then echo $(echo "$i"|xxd -p -r|sha256sum -|cut -d ' ' -f 1) "$i" "$k"; fi; done; done; true)|sort|uniq)>"$1" || exit 1
}

function make_certs {
	(
		cat "$outdir/certs_mac.txt"
		# TODO: any better way of getting the shared key?
		for k in testkey shared platform media networkstack bluetooth; do
			if ! grep -q "$k" "$outdir/certs_mac.txt"; then
				i="$(if test "$k" == testkey; then
					bsdtar -x -f "$outdir"/target_files_extracted/SYSTEM/etc/security/otacerts.zip -O keys/releasekey.x509.pem
				elif test "$k" == shared; then
					"$otatools/bin/apksigner" verify --print-certs-pem "$outdir"/target_files_extracted/PRODUCT/priv-app/Contacts/Contacts.apk
				else
					echo "Missing original key hash for $k in mac_permissions" >&2
					exit 1
				fi|openssl x509 -in /dev/stdin -inform PEM -outform DER|xxd -p -c 999999999)"
				test -n "$i" || exit 1
				echo "$(echo "$i"|xxd -p -r|sha256sum -|cut -d ' ' -f 1)" "$i" "$k"
			fi
		done
	)|sort|uniq>"$1" || exit 1
}

function make_product_security {
	while read h c k; do echo "$c"|xxd -p -r|openssl x509 -in /dev/stdin -inform DER -outform PEM > $1/$k.x509.pem; done < "$outdir"/certs.txt
}


function make_apk_keys {
	python3 "$data_dir/target_files_inputs.py" apk-keys "$outdir/target_files_extracted" "$outdir/certs.txt" "$1"
}

function make_otakeys {
	touch "$1"
}

function make_hardlink {
	rm -f "$1"
	ln "$2" "$1"
}

function make_update_engine_config {
	cat >"$1" <<EOF
PAYLOAD_MAJOR_VERSION=2
PAYLOAD_MINOR_VERSION=4
EOF
}

function make_copy {
	cp -- "$2" "$1"
}

# the public key of the payload of the virt APEX of the original images, which pvmfw has embedded to
# verify it with, and which the signing replaces with the key it signs the APEX with
function make_pvmfw_embedded_avbpubkey {
	local apex
	apex="$(find "$outdir/target_files_extracted" -regextype posix-extended -regex '.*/apex/com\.([^./]+\.)?android\.virt\.c?apex' -print -quit)"
	if test -z "$apex"; then
		echo "Failed to find the virt APEX, whose key pvmfw embeds" >&2
		exit 1
	fi
	if [[ $apex == *.capex ]]; then
		unzip -p "$apex" original_apex|bsdtar -x -O -f - apex_pubkey > "$1" || exit 1
	else
		unzip -p "$apex" apex_pubkey > "$1" || exit 1
	fi
}

function make_target_files_intermediates {
	make_dir "$outdir/target_files_intermediates" make_target_files_intermediates_base
	make_file "$outdir/certs_mac.txt" make_certs_mac
	make_file "$outdir/certs.txt" make_certs
	make_dir "$outdir/product_security" make_product_security
	mkdir -p "$outdir/target_files_intermediates/META"
	make_dir "$outdir/apk_keys" make_apk_keys
	for i in apkcerts.txt apexkeys.txt; do
		make_file "$outdir/target_files_intermediates/META/$i" make_hardlink "$outdir/apk_keys/$i"
	done
	make_file "$outdir/target_files_intermediates/META/dynamic_partitions_info.txt" make_dynamic_partitions_info
	make_file "$outdir/target_files_intermediates/META/otakeys.txt" make_otakeys
	make_file "$outdir/target_files_intermediates/META/update_engine_config.txt" make_update_engine_config
	mkdir -p "$outdir/target_files_intermediates/PREBUILT_IMAGES"
	for i in dtbo boot init_boot; do
		# unless it is built from the files of its ramdisk
		if test -e "$dir/ota_payload/$i.img" && ! test -e "$outdir/boot_inputs/target_files/${i^^}"; then
			if test "$i" == boot && test -n "$replace_boot"; then
				make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/$i.img" make_copy "$replace_boot"
			else
				make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/$i.img" make_hardlink "$dir/ota_payload/$i.img"
			fi
		fi
	done
	if test "$build_method" == rebuild; then
		cp -f "$dir/ota_meta/ab_partitions.txt" "$outdir/target_files_intermediates/META/ab_partitions.txt"
#	else
#		echo dummy_partition_name_so_resign_fails_to_build_images > "$outdir/target_files_intermediates/META/ab_partitions.txt"
	fi
	if test "$build_method" == resign; then
		make_dir "$outdir/fs_expected" make_fs_config
		# pvmfw may only be in the factory images, since it doesn't have to be updated by OTAs
		local pvmfw="$dir/ota_payload/pvmfw.img"
		if ! test -e "$pvmfw" && [[ " $(get_avbtool_partitions "$dir/ota_payload/vbmeta.img"|tr '\n' ' ') " == *" pvmfw "* ]]; then
			extract_factory_image
			pvmfw="$dir/factory_image/pvmfw.img"
		fi
		if test -e "$pvmfw"; then
			make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw.img" make_hardlink "$pvmfw"
			make_file "$outdir/target_files_intermediates/PREBUILT_IMAGES/pvmfw_embedded.avbpubkey" make_pvmfw_embedded_avbpubkey
		fi
	fi
	# after the prebuilt images, which it depends on
	make_file "$outdir/target_files_intermediates/META/misc_info.txt" make_misc_info
	touch "$1"
}

# zip the target files directory $2 into $1 with the files stored uncompressed, with soong_zip as a
# normal build does, which is several times faster than zip
function zip_target_files {
	local zip="$(realpath "$1")"
	rm -f "$zip"
	# the list of the files is read as a response file, in which a single quoted name can hold any
	# character
	(cd "$2" && find . -mindepth 1 -printf '%P\0'|sed -z "s/'/'\\\\''/g; s/^/'/; s/\$/'/"|tr '\0' '\n'|"$otatools/bin/soong_zip" -d -L 0 -o "$zip" -C . -r /dev/stdin)
}

function make_target_files_intermediates_zip {
	make_file "$outdir/target_files_intermediates.done" make_target_files_intermediates
	discard "$outdir/target_files_extracted"

	zip_target_files "$1" "$outdir/target_files_intermediates"
}

function make_target_files_signed_zip {
	function go {
		make_file "$outdir/target_files_intermediates.zip" make_target_files_intermediates_zip
		discard "$outdir/target_files_intermediates"

		if test "$build_method" == vbmeta; then
			rm -f "$2"
			ln "$outdir/target_files_intermediates.zip" "$2"
		else
			from="$(realpath "$outdir/target_files_intermediates.zip")"
			to="$(realpath "$2")"
			mkdir -p "$1/build/make/target/product"
			ln -s "$(realpath "$outdir/product_security")" "$1/build/make/target/product/security"
			ln -s "$(realpath "$key_dir")" "$1/keys"
			cd "$1"
			key_map="-k build/make/target/product/security/bluetooth=keys/bluetooth"
			generate_release_sh="$aosp/script/generate-release.sh"
			if ! test -e "$generate_release_sh"; then
				generate_release_sh="$aosp/script/release.sh"
			fi

			(sed -nre '/^sign_target_files_apks/h; x; /./ {x; /\\$/p; /\\$/! s/.*//;}; x' "$generate_release_sh"|sed -re 's/(-d "\$KEY_DIR")/\1 $KEY_MAP/'; echo '"$RESIGN_FROM" "$RESIGN_TO"')|RESIGN_FROM="$from" RESIGN_TO="$to" KEY_DIR=keys AVB_ALGORITHM="$(get_avb_algorithm)" PYTHONUNBUFFERED=1 KEY_MAP="$key_map" bash -x || exit 1
		fi
	}
	with_temp_dir "$outdir/sign_target_files" go "$@"
}

function install_magisk {
	make_dir "$outdir/magisk" do_unzip "$magisk"

	echo "Magisk installation support in this script has not been written yet, use the official Magisk app and --replace-boot instead to install Magisk manually" >&2
	exit 1
}

function make_target_files_signed {
	make_file "$outdir/target_files_intermediates.zip" make_target_files_intermediates_zip
	make_file "$outdir/target_files_signed.zip" make_target_files_signed_zip

	# only what is taken from the signed target files, rather than the gigabytes of the files the
	# images are built from, and each image, which the signing compressed, in a process of its own
	local zip="$outdir/target_files_signed.zip"
	unzip -q -o "$zip" 'META/*' '*/build.prop' -d "$1" || exit 1
	unzip -Z1 "$zip" 'IMAGES/*'|xargs -d '\n' -P "$(nproc)" -I {} unzip -q -o "$zip" {} -d "$1"
}

# make the compat change with ID $2 enabled only for the apps targeting SDK version $3 or later, in
# whichever compat config of the target files directory $1 declares it, which is not always the same
# one, nor always with the same attributes
function set_compat_change_sdk {
	local configs=()
	mapfile -t configs < <(grep -lE "<compat-change [^>]*id=\"$2\"" "$1"/SYSTEM/etc/compatconfig/*.xml)
	if test "${#configs[@]}" == 0; then
		echo "No compat config declares the compat change $2" >&2
		exit 1
	fi
	sed -i -re "s|(<compat-change\s+(description=\"[^\"]*\"\s+)?enableSinceTargetSdk=\")[0-9]+(\"\s+id=\"$2\")|\1$3\3|" "${configs[@]}"
	if ! grep -qE "enableSinceTargetSdk=\"$3\"\s+id=\"$2\"" "${configs[@]}"; then
		echo "Failed to make the compat change $2 in ${configs[*]} enabled since SDK version $3" >&2
		exit 1
	fi
}

# make the changes that the options ask for to the files in the target files directory $1
function apply_modifications {
	# the signing appends a newline to the build.prop files, so they are left with a single one for
	# them to end with the empty line they end with in the original images
	find "$1" \( -name build.prop -o -name prop.default \) -type f -print0|xargs -0 sed -i -z -re 's/\n*$/\n/'
	# don't set it in the ramdisk, since it causes it to launch a root shell instead of running the recovery normally
	# grep -vz BOOT|
	prop_sed=""
	if test "$out_build" != "$build"; then
		# the build number appears both on its own and inside the fingerprints
		prop_sed="$prop_sed; s/\b$build\b/$out_build/g"

		# the updater only offers an update whose timestamp is greater than ro.build.date.utc of the
		# running build (and update_engine and the recovery refuse to install an older one), so the
		# timestamp must be replaced with the one synthesized for the version
		prop_sed="$prop_sed; s/^([a-z0-9_.]*\.date\.utc)=.*/\1=$build_date_utc/; s/^([a-z0-9_.]*\.date)=.*/\1=$(date -u -d "@$build_date_utc")/"
	fi
	if test -n "$ro_debuggable"; then
		prop_sed="$prop_sed; s/^ro.debuggable=.*/ro.debuggable=$ro_debuggable/"
	fi
	if test -n "$ro_secure"; then
		prop_sed="$prop_sed; s/^ro.secure=.*/ro.secure=$ro_secure/"
	fi
	if test -n "$adb_any_key"; then
		# let adbd accept any host key with no on-screen authorization, the way an eng build does: it
		# demands an authorized key only while ro.adb.secure is set, so clear it. The property is
		# checked for so that its absence, or a rename, doesn't silently leave authorization on
		if test -z "$(find "$1" \( -name build.prop -o -name prop.default \) -exec grep -l '^ro\.adb\.secure=' {} +)"; then
			echo "Warning: no build.prop sets ro.adb.secure, so --adb-at-boot-any-key-INSECURE may not disable ADB key authorization" >&2
		fi
		prop_sed="$prop_sed; s/^ro.adb.secure=.*/ro.adb.secure=0/"
	fi
	if test -n "$prop_sed"; then
		find "$1" \( -name build.prop -o -name prop.default \) -type f -print0|xargs -0 sed -i -re "$prop_sed"
	fi
	sepolicy="$(mktemp)"
	su=
	if test -n "$recovery_adb_root"; then
		# replace all calls to __android_log_is_debuggable with the constant 1
		own_file "$1/VENDOR_BOOT/RAMDISK/system/bin/adbd"
		patch_adbd {,}"$1/VENDOR_BOOT/RAMDISK/system/bin/adbd"
	fi

	if test -n "$adb_root"; then
		echo '(allow adbd adbd (process (setcurrent)))' >> "$sepolicy"
		su=1
	fi

	if false; then
		#echo '(typetransition dumpstate su_exec process su)' >> "$sepolicy"

		# this would be needed to let shell su to root if we supported a "su" binary, in addition to actually adding the binary
		echo '(typetransition shell su_exec process su)' >> "$sepolicy"

		su=1
	fi

	if test -n "$su"; then
		# su.cil generated like this starting from userdebug target_files from ci.android.com
		# sed -re 's/(expandtypeattribute .* )true/\1false/' SYSTEM/etc/selinux/plat_sepolicy.cil > plat_sepolicy_noexpand.cil
		# secilc -G -N -m plat_sepolicy_noexpand.cil -o plat_sepolicy_noexpand.policy && checkpolicy -C -M -b plat_sepolicy_noexpand.policy -o dis.cil
		# grep -w su dis.cil|sed -re 's/^(\(typeattributeset [^ ]*) .*\)$/\1 (su))/'|grep -v 'su_exec process su' > su.cil

		# TODO: we are filtering some permissions arbitrarily, we should use a better way to filter them
		sed -e 's/ nlmsg_getneigh//; s/ get_attestation_key//; s/ migrate_any_key//; s/ su_userfaultfd//' "$data_dir/su.cil"|grep -v '\[userfaultfd\]' >> "$sepolicy"
	fi
	if test -n "$allowbackup"; then
		# IGNORE_ALLOW_BACKUP_IN_D2D and IGNORE_FULL_BACKUP_CONTENT_IN_D2D
		set_compat_change_sdk "$1" 183147249 1
		set_compat_change_sdk "$1" 180523564 1
	fi
	if test -n "$adb_backup"; then
		# RESTRICT_ADB_BACKUP
		set_compat_change_sdk "$1" 171032338 99
	fi
	if test -n "$hosts_url"; then
		own_file "$1/SYSTEM/etc/hosts"
		curl "$hosts_url"|sed -nre '/^127\.0\.0\.1 [0-9.]*[a-zA-Z][0-9a-zA-Z.]*$/p'|grep -vE '^127\.0\.0\.1 \.*localhost\.*$' >> "$1/SYSTEM/etc/hosts"
	fi
	if test "$(wc -l < "$sepolicy")" != 0; then
		own_file "$1/SYSTEM/etc/selinux/plat_sepolicy_and_mapping.sha256"
		echo "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" > "$1/SYSTEM/etc/selinux/plat_sepolicy_and_mapping.sha256"

		# we remove all neverallows because they have no runtime effect after policy compilation (unless validation fails, but in that case the device fails to boot), and it's too hard to fix them
		# TODO: fix the neverallows...
		sed -i -re '/^\(neverallow /d' "$1/SYSTEM/etc/selinux/plat_sepolicy.cil"

		# we must filter out rules for types that don't exist in the policy
		declare -A se_types
		while read i; do
			se_types["$i"]=1
		done < <(sed -nre 's/^\((type|typeattribute|role) ([^ )]*).*\)$/\2/p' "$1/SYSTEM/etc/selinux/plat_sepolicy.cil" |sort|uniq)

		sed -re 'h; s/[()]//g; s/\S* (\S*) (\S*).*/\1|\2|/; /\|/! s/.*/||/; G; s/\n//;' "$sepolicy"|while IFS='|' read a b r; do
			ok=1
			for i in $a $b; do
				if test "$i" != su && test "$i" != self && test -z "${se_types[$i]:-}"; then
					ok=
				fi
			done
			if test -n "$ok"; then
				echo "$r"
			fi
		done >> "$1/SYSTEM/etc/selinux/plat_sepolicy.cil"

		# check the policy
		secilc -m -M true -G -N -c 32 "$1/SYSTEM/etc/selinux/plat_sepolicy.cil" -o /dev/null -f /dev/null
	fi

	if test -n "$magisk"; then
		install_magisk "$1"
	fi
}

function make_target_files_base {
	if test "$build_method" == resign; then
		make_dir "$outdir/target_files_signed" make_target_files_signed
		discard "$outdir/target_files_signed.zip"

		cp -a "$outdir/target_files_signed/META" "$1/META"

		outr="$(realpath "$1")"
		(cd "$outdir/target_files_signed" && find . -name build.prop -print0|xargs -0 cp -a --parents --target-directory="$outr") || exit 1

		ls -1 "$dir/ota_meta"|while read i; do
			if test "$i" != dynamic_partitions_info.txt && test "$i" != misc_info.txt; then
				ln -f "$dir/ota_meta/$i" "$1/META/$i"
			fi
		done

		rm -f "$1/META/care_map.pb"
	else
		echo "Should not have called make_target_files" >&2
		exit 1
	fi
}

# vbmeta: ota_payload -> [copy ota_payload images and make new vbmeta] -> target_files_intermediate -> target_files_intermediate.zip -> [ln] -> target_files_signed.zip -> [ln] -> target_files.zip
# resign: ota_payload -> [extract files and their metadata from images, modify] -> target_files_intermediate -> target_files_intermediate.zip -> [sign and build images] -> target_files_signed.zip -> [integrate with the other ota_payload images] -> target_files -> target_files.zip
# rebuild: ota_payload -> [unpack all images] -> target_files_intermediate -> target_files_intermediate.zip -> [sign] -> target_files_signed.zip -> [rename] -> target_files.zip

function read_prop {
	local i
	for i in "" /etc; do
		local p="$1$i/build.prop"
		if test -e "$p"; then
			while IFS== read k v; do
				if test "$k" == "$2"; then
					echo "$v"
					exit 0
				fi
			done < "$p"
		fi
	done
	exit 1
}

function make_care_map {
	care_map_txt="$(mktemp)"
	while read b; do
		ok=
		for i in $image_parts; do
			if test "$b" == "$i"; then
				ok=1
			fi
		done
		if test -n "$ok" && test -e "$outdir/target_files/IMAGES/$b.img"; then
			d="$(echo "$b"|tr a-z A-Z)"
			prop=
			print=
			for i in fingerprint thumbprint; do
				local p="ro.$b.build.$i"
				if print="$(read_prop "$outdir/target_files/$d" "$p")"; then
					prop="$p"
					break
				fi
			done

			if test -z "$prop"; then
				echo "Cannot find fingerprint for partition $b while building the care map" >&2
				prop=unknown
				print=unknown
			fi

			size="$("$otatools"/bin/avbtool info_image --image "$outdir/target_files/IMAGES/$b.img"|sed -nre 's/^\s*Original image size:\s*([0-9]+).*/\1/p')"
			blocks="$(($size / 4096))"

			echo "$b" >> "$care_map_txt"
			echo "2,0,$blocks" >> "$care_map_txt"
			echo "$prop" >> "$care_map_txt"
			echo "$print" >> "$care_map_txt"
		fi
	done < "$outdir/target_files/META/ab_partitions.txt"

	"$otatools/bin/care_map_generator" "$care_map_txt" "$1"
}

# take the image of partition $2 that the signing built, checking that it is made like the original one
function take_signed_image {
	local img="$outdir/target_files_signed/IMAGES/$2.img"
	local orig="$dir/ota_payload/$2.img"
	if test -e "$outdir/fs_expected/$2.json"; then
		python3 "$data_dir/target_files_inputs.py" fs-verify "$img" "$outdir/fs_expected/$2.json" || exit 1
	elif test -e "$outdir/boot_inputs/expected/$2.json"; then
		python3 "$data_dir/target_files_inputs.py" boot-verify "$img" "$outdir/boot_inputs/expected/$2.json" || exit 1
	elif test "$2" == vbmeta; then
		if ! diff <(get_avbtool_partitions "$orig"|sort) <(get_avbtool_partitions "$img"|sort) >&2 || test "$(get_avbtool_vbmeta_opts "$orig")" != "$(get_avbtool_vbmeta_opts "$img")"; then
			echo "The built vbmeta doesn't verify the same partitions with the same rollback index as the original one" >&2
			exit 1
		fi
	elif test "$2" == boot && test -n "$replace_boot"; then
		: # it is the one given with --replace-boot
	elif test "$2" == pvmfw; then
		: # the signing replaced the key embedded in it, and checked that it found the one to replace
	elif ! diff <(get_avb_info "$orig") <(get_avb_info "$img") >&2; then
		echo "The prebuilt $2.img was changed by adding a footer to it again" >&2
		exit 1
	fi
	ln "$img" "$1"
}

function make_target_files_zip {
	if test "$build_method" == resign; then
		make_dir "$outdir/target_files" make_target_files_base

		mkdir -p "$outdir/target_files/IMAGES"
		ls -1 "$dir/ota_payload"|while read i; do
			local done=
			for j in $signed_images; do
				if test "$i" == "$j.img"; then
					done=1
				fi
			done
			if test -z "$done" && test -f "$dir/ota_payload/$i"; then
				make_file "$outdir/target_files/IMAGES/$i" make_hardlink "$dir/ota_payload/$i"
			fi
		done || exit 1

		for b in $signed_images; do
			if test -e "$dir/ota_payload/$b.img" || test -e "$outdir/target_files_signed/IMAGES/$b.img"; then
				make_file "$outdir/target_files/IMAGES/$b.img" take_signed_image "$b"
			fi
		done

		discard "$outdir/target_files_signed"

		make_file "$outdir/target_files/META/care_map.pb" make_care_map

		zip_target_files "$1" "$outdir/target_files"
	else
		make_file "$outdir/target_files_signed.zip" make_target_files_signed_zip
		discard "$outdir/target_files_intermediates.zip"
		rm -f "$1"
		ln "$outdir/target_files_signed.zip" "$1"
	fi
}

# needs out_target_files.zip
function make_ota_unchecked {
	local extra_ota=()
	if [[ $device == @(rango|mustang|blazer|frankel) ]]; then
		extra_ota+=( "--disable_ublk" )
	fi
	ls -1 "$dir/ota_payload"|while read i; do
		if test -f "$dir/ota_payload/$i" && ! unzip -q -l "$outdir/target_files.zip" "IMAGES/$i" >/dev/null; then
			local b="$(basename "$f" .img)"
			extra_ota+=( "--custom-image" )
			extra_ota+=( "$b:$i" )
		fi
	done
	"$otatools/bin/ota_from_target_files" -k "$key_dir/releasekey" "${extra_ota[@]}" "$outdir/target_files.zip" "$1"
}

# make sure we have the correct key in recovery so that we can sideload another update, otherwise we can get locked out the device...
function check_images {
	local vendor_boot="$2"
	local system="$3"
	"$otatools/bin/unpack_bootimg" --boot_img "$vendor_boot" --out "$1/vendor_boot" >&2
	mkdir "$1/vendor_boot_ramdisk" >&2
	"$otatools/bin/lz4" -d "$1/vendor_boot/vendor_ramdisk00" -|(cd "$1/vendor_boot_ramdisk" && cpio -i) >&2
	mkdir "$1/recovery_otacerts" >&2
	unzip -x -d "$1/recovery_otacerts" "$1/vendor_boot_ramdisk/system/etc/security/otacerts.zip" >&2
	if ! cmp "$1/recovery_otacerts/keys/releasekey.x509.pem" "$key_dir/releasekey.x509.pem"; then
		echo "Recovery otacerts.zip has wrong key!!!" >&2
		exit 1
	fi
	echo "dump /system/etc/security/otacerts.zip $1/system_otacerts.zip"|"$debugfs" "$system" >&2
	mkdir "$1/system_otacerts" >&2
	unzip -x -d "$1/system_otacerts" "$1/system_otacerts.zip" >&2
	if ! cmp "$1/system_otacerts/keys/releasekey.x509.pem" "$key_dir/releasekey.x509.pem"; then
		echo "System otacerts.zip has wrong key!!!" >&2
		exit 1
	fi
	echo "CHECK SUCCESSFUL"
}

function check_ota {
	mkdir "$1/ota_payload"
	ota_payload_offset "$outdir/ota_unchecked.zip"
	"$otatools/bin/ota_extractor" -payload "$outdir/ota_unchecked.zip" -payload_offset "$ota_payload_offset" -output_dir "$1/ota_payload" -partitions vendor_boot,system >&2
	check_images "$1" "$1/ota_payload/vendor_boot.img" "$1/ota_payload/system.img"
}

function make_ota {
	make_file "$outdir/ota_unchecked.zip" make_ota_unchecked

	result="$(set -e; with_temp_dir "$outdir/check_ota" check_ota)"
	if test "$?" == 0 && test "$result" == "CHECK SUCCESSFUL"; then
		ln "$outdir/ota_unchecked.zip" "$1"
	else
		echo "OTA key check failed!!!"
		exit 1
	fi
}

function download_factory {
	mkdir -p "$factory_zip_dir"
	curl "$factory_url.zip" -C - -o "$factory_zip_dir/$factory_name.zip"
	curl "$factory_url.zip.sig" -C - -o "$factory_zip_dir/$factory_name.zip.sig"
	if test "$(head -n 1 "$factory_zip_dir/$factory_name.zip.sig")" == "-----BEGIN SSH SIGNATURE-----"; then
		if ! ssh-keygen -Y verify -f "$factory_allowed_signers" -I "$factory_identity" -n "factory images" -s "$factory_zip_dir/$factory_name.zip.sig" < "$factory_zip_dir/$factory_name.zip"; then
			echo "Failed to verify factory image signature of $factory_zip_dir/$factory_name.zip with ssh-keygen!" >&2
			exit 1
		fi
	else
		if ! ( cd "$factory_zip_dir" && $signify -Cqp "$factory_key" -x "$factory_name.zip.sig" ); then
			echo "Failed to verify factory image signature of $factory_zip_dir/$factory_name.zip with signify!" >&2
			exit 1
		fi
	fi
	touch "$1"
}

function do_unzip_img2simg {
	unzip -q -p "$3" "$4" > "$1"/img
	"$otatools/bin/img2simg" "$1"/img "$2" 4096
}

function do_ln_dir {
	ln "$2"/* "$1"
}

function extract_factory_image {
	if ! test -e "$dir/factory_image" || ! test -e "$dir/factory_image.list"; then
		if ! test -e "$dir/factory" || ! test -e "$dir/factory.list"; then
			make_file "$factory_zip_ok" download_factory

			make_dir "$dir/factory" do_unzip "$factory_zip_dir/$factory_name.zip"
			make_file "$dir/factory.list" do_unzip_list "$factory_zip_dir/$factory_name.zip"
			discard_download "$factory_zip_dir/$factory_name.zip"
		fi

		if test -n "$factory_optimized"; then
			make_dir "$dir/factory_image" do_ln_dir "$dir/factory/$factory_name"
		else
			make_dir "$dir/factory_image" do_unzip "$dir/factory/$factory_name/image-$device-$build.zip"
			make_file "$dir/factory_image.list" do_unzip_list "$dir/factory/$factory_name/image-$device-$build.zip"
			discard "$dir/factory/$factory_name/image-$device-$build.zip"
		fi
	fi
}

# needs out_target_files.zip
function make_factory_image {
	extract_factory_image

	local super_names=()
	local super_files=()

	if test -e "$dir/factory_image/super_1.img" || test -e "$dir/factory_image/super.img"; then
		"$otatools/bin/build_super_image" "$outdir/target_files.zip" "$1/super.img"
		# which only warns when it doesn't build it because an image of a partition in it is missing
		if ! test -e "$1/super.img"; then
			echo "build_super_image didn't build super.img" >&2
			exit 1
		fi

		if test -e "$dir/factory_image/super_1.img"; then
			simg2simg "$1/super.img" "$1/super" "$max_download_size"
			rm -f "$1/super.img"

			local super_count=0
			for f in "$1"/super.[0-9]*; do
				((super_count++))
			done

			for ((i = 1; i <= super_count; i++)); do
				mv "$1/super.$(($i - 1))" "$1/super_$i.img"
				super_names+=("super, $i/$super_count")
				super_files+=("super_$i.img")
			done
		else
			super_names=("super")
			super_files=("super.img")
		fi
	fi

	ls -1 "$dir/factory_image" | while read i; do
		if test "$i" == avb_pkmd.bin; then
			cp -a "$key_dir/avb_pkmd.bin" "$1"
		elif test "$i" == flash-all.sh; then
			{
				local super_inserted=
				while IFS= read -r line; do
					if [[ "${#super_files[@]}" != 0 && ( "$line" == "echo Flashing super"* || "$line" == "fastboot flash super super"* ) ]]; then
						if test -z "$super_inserted"; then
							for ((i = 0; i < ${#super_files[@]}; i++)); do
								echo "echo Flashing ${super_names[$i]}"
								echo "fastboot flash super ${super_files[$i]}"
							done
							super_inserted=1
						fi
					else
						echo "$line"
					fi
				done < "$dir/factory_image/$i"
			} > "$1/$i"
		elif test "$i" == flash-all.bat; then
			{
				local super_inserted= skip_errorlevel= skip_blank=
				while IFS= read -r line; do
					if [[ "${#super_files[@]}" != 0 && "$line" == "echo Flashing super"* ]]; then
						if test -z "$super_inserted"; then
							for ((i = 0; i < ${#super_files[@]}; i++)); do
								echo "echo Flashing ${super_names[$i]}"
								echo "fastboot flash super ${super_files[$i]}"
								echo "if %errorlevel% neq 0 call:pakExit"
								echo
							done
							super_inserted=1
						fi
						continue
					fi
					if [[ "${#super_files[@]}" != 0 && "$line" == "fastboot flash super super"* ]]; then
						skip_errorlevel=1
						continue
					fi
					if test -n "$skip_errorlevel" && [[ "$line" == *"errorlevel"* ]]; then
						skip_errorlevel=
						skip_blank=1
						continue
					fi
					if test -n "$skip_blank" && [[ "$line" =~ ^[[:space:]]*$ ]]; then
						skip_blank=
						continue
					fi
					echo "$line"
				done < "$dir/factory_image/$i"
			} > "$1/$i"
		elif test "$i" == script.txt; then
			{
				local super_inserted=
				while IFS= read -r line; do
					if [[ "${#super_files[@]}" != 0 && "$line" == flash\ super\ super* ]]; then
						if test -z "$super_inserted"; then
							for ((i = 0; i < ${#super_files[@]}; i++)); do
								echo "flash super ${super_files[$i]}"
							done
							super_inserted=1
						fi
					else
						echo "$line"
					fi
				done < "$dir/factory_image/$i"
			} > "$1/$i"
		elif unzip -q -l "$outdir/target_files.zip" "IMAGES/$i" >/dev/null; then
			simg=
			for j in $image_parts; do
				if test "$i" == "$j.img"; then
					simg=1
				fi
			done
			if test -n "$simg"; then
				with_temp_dir "$outdir/target_files-img-$i" do_unzip_img2simg "$1/$i" "$outdir/target_files.zip" "IMAGES/$i"
			else
				unzip -q -p "$outdir/target_files.zip" "IMAGES/$i" > "$1/$i"
			fi
		elif [[ "${#super_files[@]}" != 0 && $i == super*.img ]]; then
			: # already done before
		else
			ln "$dir/factory_image/$i" "$1/$i"
		fi
	done

}

function make_factory_unchecked {
	local out="$1/$out_factory_name"
	mkdir "$out"
	shift 1

	make_dir "$outdir/factory_image" make_factory_image
	# NOTE: only OK if we make OTA first
	if test "$#" != 0 && test "$1" == "--discard"; then
		discard "$outdir/target_files.zip"
	fi

	if test -n "$factory_optimized"; then
		ln "$outdir/factory_image"/* "$out"
	else
		local zip="$(realpath "$out/image-$device-$out_build.zip")"
		# files in the zip must be in the proper order
		factory_image_entries="$(<$dir/factory_image.list)"
		(cd "$outdir/factory_image"; zip -q "$zip_opt" "$zip" $factory_image_entries) || exit 1

		ls -1 "$dir/factory/$factory_name"|while read i; do
			if test "$i" == avb_pkmd.bin; then
				cp -a "$key_dir/avb_pkmd.bin" "$out"
			elif test "$i" == "image-$device-$build.zip"; then
				:
			else
				ln "$dir/factory/$factory_name/$i" "$out"
			fi
		done
	fi

	if test "$out_build" != "$build"; then
		# the flashing scripts refer to the build number, e.g. in the image zip name
		# (sed -i replaces the file, so the linked originals are unaffected)
		for i in flash-all.sh flash-all.bat script.txt; do
			if test -e "$out/$i"; then
				sed -i -e "s/$build/$out_build/g" "$out/$i"
			fi
		done
	fi
}

function make_factory {
	make_dir "$outdir/factory_unchecked" make_factory_unchecked

	result="$(set -e; with_temp_dir "$outdir/check_factory" check_factory)"
	if test "$?" == 0 && test "$result" == "CHECK SUCCESSFUL"; then
		mkdir -p "$1/$out_factory_name"
		ln --target-directory="$1/$out_factory_name" "$outdir/factory_unchecked/$out_factory_name"/*
	else
		echo "Factory key check failed!!!"
		exit 1
	fi
}

function check_factory {
	mkdir "$1"/factory_image >&2
	if test -n "$factory_optimized"; then
		ln "$outdir/factory_unchecked/$out_factory_name"/* "$1/factory_image"
		if test -e "$1/factory_image/super_1.img"; then
			"$otatools/bin/simg2img" $(ls -1 "$1/factory_image"/super_*.img|sort -V) "$1/super.img" >&2
		else
			"$otatools/bin/simg2img" "$1/factory_image/super.img" "$1/super.img" >&2
		fi
		mkdir "$1/lpunpack"
		"$otatools"/bin/lpunpack -p system_a "$1/super.img" "$1/lpunpack" >&2
		mv "$1/lpunpack/system_a.img" "$1/system.img"
	else
		unzip -x -d "$1/factory_image" "$outdir/factory_unchecked/$out_factory_name/image-$device-$out_build.zip" system.img vendor_boot.img >&2
		"$otatools/bin/simg2img" "$1/factory_image/system.img" "$1/system.img"  >&2
	fi
	
	check_images "$1" "$1/factory_image/vendor_boot.img" "$1/system.img"
}


function make_factory_zip {
	make_dir "$outdir/factory" make_factory
	discard "$outdir/factory_image"

	local zip="$(realpath "$1")"
	rm -f "$zip"

	factory_entries="$(
		local super_inserted=
		while IFS= read -r entry; do
			local base
			# the build number appears in the directory name and in the image zip name
			entry="${entry//"$build"/"$out_build"}"
			base="$(basename "$entry")"
			if [[ -e "$outdir/factory/$out_factory_name"/super_1.img || -e "$outdir/factory/$out_factory_name"/super.img ]] && [[ "$base" == super*.img ]]; then
				if test -z "$super_inserted"; then
					(cd "$outdir/factory" && ls -1 "$out_factory_name"/super*.img 2>/dev/null | grep -vE '/super_empty.img$' | sort -V)
					super_inserted=1
				fi
			else
				echo "$entry"
			fi
		done < "$dir/factory.list"
	)"

	(cd "$outdir/factory"; zip -q "$zip_opt" "$zip" $factory_entries) || exit 1
}

function make_factory_zip_sig {
	local key="$(realpath "$key_dir/factory.sec")"
	if test "$sign_factory_images" == signify; then
		(cd "$outdir/out"; sha256sum --tag "$out_factory_name.zip"|$signify -S -s "$key" -e -m - -x "$1") || exit 1
	elif test "$sign_factory_images" == ssh-keygen; then
		ssh-keygen -Y sign -n "factory images" -f "$key_dir/id_ed25519" < "$out_factory" > "$1" || exit 1
	fi
}


out_ota="$outdir/out/$device-ota_update-$out_build.zip"
out_factory="$outdir/out/$out_factory_name.zip"

if ! test -e "$out_ota" || ! test -e "$out_factory"; then
	mkdir -p "$outdir/out"
	if test -n "$parallel"; then
		make_file "$factory_zip_ok" download_factory &
	fi

	make_file "$outdir/target_files.zip" make_target_files_zip
	discard "$outdir/target_files" "$outdir/target_files_signed.zip"

	if test -n "$parallel"; then
		# kill the download, we'll just resume it in parallel with making the OTA image
		kill %1
		wait

		make_file "$out_ota" make_ota &
		make_file "$out_factory" make_factory_zip &
		wait
		if ! test -e "$out_ota" || ! test -e "$out_factory"; then
			echo "Parallel build failed" >&2
			exit 1
		fi
		discard "$dir/ota_payload"
	else
		if test -n "$build_ota"; then
			make_file "$out_ota" make_ota
			discard "$dir/ota_payload"
		fi
		if test -n "$build_factory"; then
			make_dir "$outdir/factory" make_factory
		fi
		if test -n "$build_factory_zip"; then
			make_file "$out_factory" make_factory_zip --discard
		fi
	fi
fi
discard "$outdir/target_files.zip"
discard "$outdir/factory"

if test -n "$build_factory_zip" && test -n "$sign_factory_images"; then
	make_file "$out_factory.sig" make_factory_zip_sig
fi

if test -n "$build_ota"; then
	function make_metadata {
		ln "$out_ota" "$1/ota.zip"
		generate_metadata="$aosp/script/generate-metadata"
		if ! test -e "$generate_metadata"; then
			generate_metadata="$aosp/script/generate-metadata.py"
		fi
		if ! test -e "$generate_metadata"; then
			generate_metadata="$aosp/script/generate_metadata.py"
		fi
		"$generate_metadata" "$1/ota.zip" || exit 1
		rm -f "$1/ota.zip"
	}

	make_dir "$outdir/out_meta" make_metadata

	ls -1 "$outdir/out_meta"|while read i; do
		if ! test -e "$outdir/out/$i"; then
			ln "$outdir/out_meta/$i" "$outdir/out/$i"
		fi
	done
fi
