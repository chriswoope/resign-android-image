# download to $1 the artifact $2 of that build, which is only looked for when an artifact isn't downloaded yet,
# telling to put the artifact at $3 if there is no such build
function download_ci_artifact {
	local bid
	bid="$(python3 -c '
import json, re, sys, urllib.error, urllib.parse, urllib.request
ci, branch, target, version, artifact, dest = sys.argv[1:]
def get(path, *parts):
    with urllib.request.urlopen(ci + path.format(*(urllib.parse.quote(p, safe="") for p in parts))) as f:
        return f.read().decode()
# the builds of the branch, newest first, in pages that start from the last build of the previous one
start = json.loads(get("/branch/{}/last-build-id", branch))["last_build_id"]
seen = set()
while ids := [i for i in json.loads(get("/branch/{}/build-ids/between/{}/1?", branch, start))["ids"] if i not in seen]:
    for bid in ids:
        seen.add(bid)
        try:
            prop = get("/submitted/{}/{}/latest/raw/build.prop", bid, target)
        except urllib.error.HTTPError as e:
            # a build that failed for the target
            if e.code == 404:
                continue
            raise
        props = dict(re.findall(r"^([^#=\n]+)=(.*)$", prop, re.M))
        if props["ro.system.build.version.release"] + "-" + props["ro.system.build.id"].split(".")[0] == version:
            if not re.fullmatch(r"[0-9]+", bid):
                sys.exit(f"Unexpected build ID {bid!r} on the Android CI")
            print(bid)
            sys.exit()
    start = ids[-1]
sys.exit(f"There is no build of Android {version} on {branch} on the Android CI: put the {artifact} of it at {dest}")
' "$android_ci" "$android_ci_branch" "$android_ci_target" "$android_version" "$2" "$3")"
	download "$1" "$android_ci/submitted/$bid/$android_ci_target/latest/raw/$2"
}

