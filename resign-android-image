# discard the download $1, along with the file marking it as verified, so that it is downloaded again if what
# was extracted from it is discarded as well and needed again
function discard_download
{
	if test -z "$download_cache"; then
		discard "$1" "$1.ok"
	fi
}

# download the OTA, or the rest of it
function curl_ota
{
	curl --fail "$ota_url.zip" -C - -o "$ota_zip"
}

# remove a download that turned out not to be the file it is for, which the next run would otherwise resume
# downloading after rather than download again
function remove_bad_download
{
	echo "Removing $* for the next run to download again" >&2
	rm -f -- "$@"
}

# run the command that follows the file $1 while holding a lock on it, so that making it again, in parallel in
# this run or in another run sharing it, waits for the one in progress to be done rather than writing to the same
# file along with it, as downloading it again would, appending to it
function with_lock
{
	local fd
	exec {fd}>>"$1.lock"
	if ! flock -n "$fd"; then
		echo "Waiting for another run to be done with $1" >&2
		flock "$fd"
	fi
	"${@:2}"
	exec {fd}>&-
}

# the Android version and quarterly platform release of the build, which is the prefix of its build ID (like CP2A
# in CP2A.260705.006 of Android 17), from the fingerprint in the metadata of its OTA, where it was extracted or else
# in the OTA itself, which is downloaded already for this before it is verified with the otatools chosen by it
ota_metadata_file="$dir/ota/META-INF/com/android/metadata"
if test -e "$ota_metadata_file"; then
	ota_metadata="$(< "$ota_metadata_file")"
else
	if ! test -e "$ota_zip.ok"; then
		with_lock "$ota_zip" curl_ota
	fi
	if ! ota_metadata="$(unzip -p "$ota_zip" META-INF/com/android/metadata)"; then
		echo "$ota_zip is not an OTA zip" >&2
		remove_bad_download "$ota_zip" "$ota_zip.ok"
		exit 1
	fi
fi
post_build_re=$'(^|\n)post-build=[^:\n]*:([0-9.]+)/([0-9A-Z]+)\\.'
if ! [[ $ota_metadata =~ $post_build_re ]]; then
	echo "There is no Android version and build ID in the metadata of the OTA" >&2
	exit 1
fi
android_version="${BASH_REMATCH[2]}-${BASH_REMATCH[3]}"

# a device running the build that the version is made from would refuse it if its build timestamp were earlier
if test -n "$build_date_utc"; then
	post_timestamp_re=$'(^|\n)post-timestamp=([0-9]+)(\n|$)'
	if ! [[ $ota_metadata =~ $post_timestamp_re ]]; then
		echo "There is no build timestamp in the metadata of the OTA" >&2
		exit 1
	fi
	if test "$build_date_utc" -lt "${BASH_REMATCH[2]}"; then
		echo "Version $out_build would have an earlier build timestamp than build $build, $(date -u -d "@${BASH_REMATCH[2]}"), so a device running build $build would refuse it" >&2
		exit 1
	fi
fi

