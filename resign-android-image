# the jar isn't signed, so it is checked against the SHA-256 of the one on Maven, which was checked against
# the SHA-1 that Maven publishes next to it
function download_aapt2 {
	local digest
	curl --fail -C - -o "$otatools.aapt2.zip" https://dl.google.com/dl/android/maven2/com/android/tools/build/aapt2/8.3.0-10880808/aapt2-8.3.0-10880808-linux.jar
	read -r digest _ < <(sha256sum < "$otatools.aapt2.zip")
	if test "$digest" != d5c7a4bbf71f483c99f808c7ce74e4f1bc859e71a9411dfd33cf5de6e5a2dcfa; then
		echo "$otatools.aapt2.zip is not the aapt2 that was published on Maven" >&2
		remove_bad_download "$otatools.aapt2.zip"
		exit 1
	fi
	bsdtar -O -x -f "$otatools.aapt2.zip" aapt2 > "$1"
	chmod +x "$1"
}

function make_aapt2_wrapper {
	cat - > "$1" <<"EOF"
#!/bin/bash
aapt2="$(dirname "$0")/aapt2.maven"
if test "$1" == dump && test "$2" == badging; then
	exec "$aapt2" "$@"|sed -re 's/^minS(dkVersion:.*)/s\1\nminS\1/'
else
	exec "$aapt2" "$@"
fi
EOF
	chmod +x "$1"
