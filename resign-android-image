#!/bin/bash
set -o nounset
set -o pipefail
set -e
# in command substitutions as well
shopt -s inherit_errexit

# TODO: build updater with changed url
# TODO: build backup service with changed allowbackup first API version

data_dir="$(realpath -- "$(dirname -- "$0")")"
# absolute, since the files in it that are shared by all the runs are told apart by their path
var_dir="$HOME/.resign-android-image"
mkdir -p "$var_dir"
var_dir="$(realpath -- "$var_dir")"

if test "$#" -lt 5; then
	echo "Usage: $0 <work directory> <key directory> <os> <device> <build> [--ota] [--factory-image] [--factory-zip] <options>" >&2
	exit 1
fi
# absolute, since it is also used from other directories, such as the one the signing runs in
dir="$(realpath -m -- "$1")"
key_dir="$2"
os="$3"
device="$4"
build="$5"
shift 5

signify=signify-openbsd

args=("$@")

# vbmeta: only resign vbmeta
# resign: resign apks and rebuild the images from their files as a normal build does
# rebuild: rebuild images

image_parts="system vendor product system_ext odm vendor_dlkm odm_dlkm system_dlkm"

build_factory=
build_factory_zip=
factory_optimized=
build_ota=
want_discard=1
reuse_changed_options=
parallel=
keep_tmp=
ro_debuggable=
ro_secure=
adb_root=
recovery_adb_root=
adb_keys=()
adb_at_boot=
adb_any_key=
allowbackup=
adb_backup=
cross_profile_localhost=
always_screenshot=
always_screenshot_surfaceview=
no_location_ismock=
record_anything=
zip_opt="-6"
dev_fast_sign=
build_method=resign
replace_boot=
replace_boot_allow_change=()
replace_boot_allow_new_files=
generate_keys=
magisk=
hosts_url=
version=
sign_factory_images=ssh-keygen
# must be as long as the original update URL
orig_update_url="https://releases.grapheneos.org/"
# the one given with --update-url, if any
update_url=
unshare=1
unshared=
download_cache=
timing=
threads=
dex2oat=1
otatools_only=

# check that the option $1 is followed by its value
function check_option_value {
	if test "$#" -lt 2; then
		echo "$1 must be followed by a value" >&2
		exit 1
	fi
}

while test "$#" != 0; do
	if test "$1" == "-v"; then
		set -x
	elif test "$1" == "--parallel"; then
		parallel=1
	elif test "$1" == "--keep"; then
		want_discard=
	elif test "$1" == "--reuse-with-changed-options"; then
		reuse_changed_options=1
	elif test "$1" == "--keep-tmp"; then
		keep_tmp=1
	elif test "$1" == "--timing"; then
		timing=1
	elif test "$1" == "--no-unshare"; then
		unshare=
	elif test "$1" == "--download-cache"; then
		check_option_value "$@"
		download_cache="$2"
		shift
	elif test "$1" == "--threads"; then
		check_option_value "$@"
		threads="$2"
		shift
	elif test "$1" == "--no-dex2oat"; then
		dex2oat=
	elif test "$1" == "--otatools-only"; then
		otatools_only=1
	elif test "$1" == "--unshared"; then
		# internal, passed to the script rerun in its own mount namespace
		unshared=1

# functionality modifications
	elif test "$1" == "--update-url"; then
		check_option_value "$@"
		update_url="$2"
		shift
	elif test "$1" == "--version"; then
		check_option_value "$@"
		version="$2"
		shift
	elif test "$1" == "--adb-root"; then
		adb_root=1
	elif test "$1" == "--recovery-adb-root"; then
		recovery_adb_root=1
	elif test "$1" == "--adb-key"; then
		check_option_value "$@"
		adb_keys+=("$2")
		shift 1
	elif test "$1" == "--adb-at-boot"; then
		adb_at_boot=1
	elif test "$1" == "--adb-at-boot-any-key-INSECURE"; then
		adb_at_boot=1
		adb_any_key=1
	elif test "$1" == "--allowbackup"; then
		allowbackup=1
	elif test "$1" == "--adb-backup"; then
		adb_backup=1
	elif test "$1" == "--cross-profile-localhost"; then
		cross_profile_localhost=1
	elif test "$1" == "--always-screenshot"; then
		always_screenshot=1
	elif test "$1" == "--always-screenshot-surfaceview"; then
		always_screenshot_surfaceview=1
	elif test "$1" == "--no-location-ismock"; then
		no_location_ismock=1
	elif test "$1" == "--record-anything"; then
		record_anything=1
	elif test "$1" == "--replace-boot"; then
		check_option_value "$@"
		replace_boot="$2"
		shift 1
	elif test "$1" == "--replace-boot-allow-change"; then
		check_option_value "$@"
		# Space-separated literal paths, without shell glob expansion.
		IFS=' ' read -r -d '' -a paths < <(printf '%s\0' "$2")
		replace_boot_allow_change+=("${paths[@]}")
		shift 1
	elif test "$1" == "--replace-boot-allow-new-files"; then
		replace_boot_allow_new_files=1
	elif test "$1" == "--hosts-url"; then
		check_option_value "$@"
		hosts_url="$2"
		shift 1
	elif test "$1" == "--adaway"; then
		hosts_url=https:"//adaway.org/hosts.txt"
	elif test "$1" == "--magisk"; then
		echo "Magisk installation support in this script has not been written yet, use the official Magisk app and --replace-boot instead to install Magisk manually" >&2
		exit 1

	elif test "$1" == "--ro-debuggable"; then
		echo "It's not recommended to use --ro-debuggable if you just want ADB root; use --adb-root instead that will fix selinux policy and only make adbd believe that the build is debuggable" >&2
		ro_debuggable=1
	elif test "$1" == "--ro-secure0"; then
		echo "It's not recommended to use --ro-secure" >&2
		ro_secure=0
	elif test "$1" == "--vbmeta-only"; then
		build_method=vbmeta
	elif test "$1" == "--factory-image"; then
		build_factory=1
	elif test "$1" == "--factory-zip"; then
		build_factory_zip=1
	elif test "$1" == "--ota"; then
		build_ota=1
	elif test "$1" == "--rebuild"; then
		build_method=rebuild
		echo "--rebuild is incomplete and broken" >&2
	elif test "$1" == "--zip-opt"; then
		check_option_value "$@"
		zip_opt="-$2"
		shift 1
	elif test "$1" == "--generate-keys"; then
		generate_keys=1
	elif test "$1" == "--sign-factory-images"; then
		check_option_value "$@"
		sign_factory_images="$2"
		shift
	elif test "$1" == "--dev-fast-sign"; then
		# remove all APEXes, CAPEXes and APKs to make signing very fast during development of this script
		dev_fast_sign=1
	else
		echo "Error: unrecognized parameter $1" >&2
		exit 1
	fi
	shift 1
done

# checked before the dependencies are installed and the script is run again in its own mount namespace
if test "$os" != grapheneos; then
	echo "Unsupported OS: $os" >&2
	exit 1
fi

if test -z "$threads"; then
	threads="$(nproc)"
elif ! [[ $threads =~ ^[1-9][0-9]*$ ]]; then
	echo "The number of threads must be a positive integer, but is $threads" >&2
	exit 1
fi

# checked now rather than when the factory zip is signed at the end of the build
if ! [[ $sign_factory_images == @(|signify|ssh-keygen) ]]; then
	echo "--sign-factory-images must be signify, ssh-keygen or empty for no signature, but is $sign_factory_images" >&2
	exit 1
fi

# check that $2, the $1, is a build number
function check_build_number {
	if ! [[ $2 =~ ^[0-9]{10}$ ]]; then
		echo "The $1 must be a build number in the YYYYMMDDXX form, but is $2" >&2
		exit 1
	fi
}
# which is compared as a number with the builds that changed what is done
check_build_number build "$build"
# the builds before 2023062300 have no signed tag in the repositories that the signing scripts of the build are
# taken from, which are only trusted as the tag of the build signed by the OS (and those before Android 13 have
# no bluetooth key either, which the key mapping and the signing expect)
if test "$build" -lt 2023062300; then
	echo "Build $build is from before 2023062300, whose sources have no signed tag, which isn't supported" >&2
	exit 1
fi
if test -n "$version"; then
	check_build_number version "$version"
fi

out_build="${version:-$build}"
build_date_utc=
if test "$out_build" != "$build"; then
	# GrapheneOS build timestamps are the wall clock time of the release build run (the same for all
	# devices of a release) and are not derived from the build number, so a version that was never
	# built upstream has no timestamp to use and we have to synthesize one: use the last 100 seconds
	# of the day of the version, one second per unit of its last two digits. This way timestamps are
	# ordered like the build numbers they come from, are always later than those of the real releases
	# of the same day or an earlier one, which are built during their own day, and always earlier
	# than those of the real releases of a later day, which can thus always still be installed.
	# The day must be taken in UTC because that's the timezone build numbers are assigned in (build
	# 2026081300 was built at 03:27:33 UTC, 2025012701 at 04:48:18 UTC and 2025021000 at 06:01:10
	# UTC, all on the day of their own build number, while in the local time of the GrapheneOS
	# developers the first two would have belonged to the previous day). This makes being earlier
	# than any later release exact rather than just likely, since a release built on a later day
	# always has a timestamp past the end of the day of our version, no matter at what time of the
	# day releases happen to be built; only being later than the release of the same day relies on
	# no release ever being built in the last 100 seconds of a day, which leaves about 18 hours of
	# margin at the times of the day at which releases are currently built.
	if ! build_date_utc="$(date -u -d "${out_build:0:4}-${out_build:4:2}-${out_build:6:2}" +%s)"; then
		echo "Version $out_build does not start with a valid YYYYMMDD date" >&2
		exit 1
	fi
	build_date_utc="$((build_date_utc + 86400 - 100 + 10#${out_build:8}))"
	# and a device refuses an OTA older than the build it runs, both from the updater and when sideloading
	# it, so a version of a day still to come would leave it refusing every release up to that day
	TZ=UTC printf -v today '%(%Y%m%d)T' -1
	if test "${out_build:0:8}" -gt "$today"; then
		echo "Version $out_build is of a day after today, $today UTC, so a device running it would refuse every release up to that day" >&2
		exit 1
	fi
	# while the releases of today may not all be built yet
	if test "${out_build:0:8}" == "$today"; then
		echo "Warning: a device running version $out_build will refuse the releases built later today, whose build timestamps are earlier than its one, the end of the day, unless they are resigned with a higher --version" >&2
	fi
fi

# the changes that the options ask for to the properties of every build.prop and prop.default
prop_sed=""
# and the one of them that is also made to the AVB properties of the images, whose fingerprints have the
# build number too
build_number_sed=""
if test "$out_build" != "$build"; then
	# the build number appears both on its own and inside the fingerprints
	build_number_sed="s/\b$build\b/$out_build/g"
	prop_sed="$prop_sed; $build_number_sed"

	# the updater only offers an update whose timestamp is greater than ro.build.date.utc of the
	# running build (and update_engine and the recovery refuse to install an older one), so the
	# timestamp must be replaced with the one synthesized for the version, and the date shown with it written in
	# the format of the build rather than in the one of the locale
	prop_sed="$prop_sed; s/^([a-z0-9_.]*\.date\.utc)=.*/\1=$build_date_utc/; s/^([a-z0-9_.]*\.date)=.*/\1=$(LC_ALL=C date -u -d "@$build_date_utc")/"
fi
if test -n "$ro_debuggable"; then
	prop_sed="$prop_sed; s/^ro.debuggable=.*/ro.debuggable=$ro_debuggable/"
fi
if test -n "$ro_secure"; then
	prop_sed="$prop_sed; s/^ro.secure=.*/ro.secure=$ro_secure/"
fi
if test -n "$adb_any_key"; then
	# let adbd accept any host key with no on-screen authorization, the way an eng build does: it
	# demands an authorized key only while ro.adb.secure is set, so clear it
	prop_sed="$prop_sed; s/^ro.adb.secure=.*/ro.adb.secure=0/"
fi

# the keys given with --adb-key, read here rather than after a long build so that a bad file fails now
adb_keys_content=
for i in "${adb_keys[@]}"; do
	while IFS= read -r k || test -n "$k"; do
		if test -n "$k"; then
			# an ADB public key is the base64 of the key, optionally followed by a comment naming the
			# host: refuse anything else rather than baking in a file adbd will silently ignore, which
			# is what an SSH public key or a private key would be
			if ! [[ $k =~ ^[A-Za-z0-9+/]+=*( .*)?$ ]]; then
				echo "$i is not an ADB public key file like the ~/.android/adbkey.pub of an ADB host: $k" >&2
				exit 1
			fi
			adb_keys_content="$adb_keys_content$k"$'\n'
		fi
	done < "$i"
done

if test -n "$adb_at_boot" && test -z "$adb_keys_content$adb_any_key"; then
	echo "--adb-at-boot without --adb-key leaves you having to authorize the host on the screen, which is impossible if the point is debugging a boot that doesn't get there; use --adb-at-boot-any-key-INSECURE to instead accept any host key with no authorization at all" >&2
fi

# the options that change the files in the images, and the variables they set, which only resign rebuilds
# the images with, while the other build methods would silently ignore them
declare -A image_option_vars=([--update-url]=update_url [--version]=version [--adb-root]=adb_root [--recovery-adb-root]=recovery_adb_root
	[--adb-key]=adb_keys_content [--adb-at-boot]=adb_at_boot
	[--adb-at-boot-any-key-INSECURE]=adb_any_key [--allowbackup]=allowbackup [--adb-backup]=adb_backup
	[--cross-profile-localhost]=cross_profile_localhost [--always-screenshot]=always_screenshot
	[--always-screenshot-surfaceview]=always_screenshot_surfaceview [--no-location-ismock]=no_location_ismock
	[--record-anything]=record_anything [--replace-boot]=replace_boot [--hosts-url or --adaway]=hosts_url
	[--ro-debuggable]=ro_debuggable [--ro-secure0]=ro_secure)
if test "$build_method" != resign; then
	for i in "${!image_option_vars[@]}"; do
		if test -n "${!image_option_vars[$i]}"; then
			echo "$i changes the images, which $build_method doesn't rebuild" >&2
			exit 1
		fi
	done
fi

# which is replaced even when none is given, so that the updater doesn't download updates it can't install from
# the official update server
update_url="${update_url:-https://noupdateurlset.invalid./}"

# the update URL is replaced byte for byte in resources that also hold its length in characters, which only
# stay right for printable ASCII characters, all that a URL is made of anyway, which are a byte each
if [[ $update_url == *[!\ -~]* ]]; then
	echo "The update URL must be made of printable ASCII characters, but is $update_url" >&2
	exit 1
fi
if test "${#update_url}" != "${#orig_update_url}"; then
	echo "Currently update URL must be exactly ${#orig_update_url} characters long since we binary patch it, but is ${#update_url} characters long: create a shorter CNAME on your host to shorten, or use repeated dots to lengthen" >&2
	exit 1
fi


if test -z "$build_ota" || test -n "$build_factory" || test -z "$build_factory_zip"; then
	parallel=
fi

# install the dependencies and rerun the script in a mount namespace of its own, unless that is where
# it already runs
if test -z "$unshared"; then
	deb=()

	if ! which zip >/dev/null; then
		deb+=(zip)
	fi

	if ! which unzip >/dev/null; then
		deb+=(unzip)
	fi

	# used internally by some tool
	if ! which cgpt >/dev/null; then
		deb+=(cgpt)
	fi

	if ! which cpio >/dev/null; then
		deb+=(cpio)
	fi

	if ! which openssl >/dev/null; then
		deb+=(openssl)
	fi

	if ! which java >/dev/null; then
		deb+=(default-jre-headless)
	fi

	if ! which "$signify" >/dev/null; then
		deb+=(signify-openbsd)
	fi

	if ! which git >/dev/null; then
		deb+=(git)
	fi

	# which the tags of the sources and the factory images are verified with
	if ! which ssh-keygen >/dev/null; then
		deb+=(openssh-client)
	fi

	if ! which python3 >/dev/null; then
		deb+=(python3)
	fi

	if ! which python >/dev/null; then
		deb+=(python-is-python3)
	fi

	if ! test -e /usr/lib/python3/dist-packages/google/protobuf; then
		deb+=(python3-protobuf)
	fi

	if ! which unshare >/dev/null || ! which flock >/dev/null; then
		deb+=(util-linux)
	fi

	if ! which bsdtar >/dev/null; then
		deb+=(libarchive-tools)
	fi

	if ! test -e /sbin/debugfs; then
		deb+=(e2fsprogs)
	fi

	if ! which gcc >/dev/null; then
		deb+=(gcc)
	fi

	if ! test -e /usr/include/errno.h; then
		deb+=(libc6-dev)
	fi

	if ! which llvm-objdump >/dev/null; then
		deb+=(llvm)
	fi

	if ! which curl >/dev/null; then
		deb+=(curl)
	fi

	if ! which wget >/dev/null; then
		deb+=(wget)
	fi

	if ! which xzcat >/dev/null; then
		deb+=(xz-utils)
	fi

	if ! which xxd >/dev/null; then
		deb+=(xxd)
	fi

	if ! which simg2simg >/dev/null; then
		deb+=(android-sdk-libsparse-utils)
	fi

	if test "${#deb[@]}" != 0; then
		sudo apt-get -y install "${deb[@]}"
	fi

	if test -n "$unshare"; then
		# as the user by its ID, since $USER isn't always set, and with the PATH and HOME of the user, which sudo
		# would reset, for it to find the same tools and ~/.resign-android-image
		exec sudo unshare -m -- sudo -u "#$(id -u)" env PATH="$PATH" HOME="$HOME" "$0" "$dir" "$key_dir" "$os" "$device" "$build" --unshared "${args[@]}"
	fi
fi

mkdir -p "$dir/tmp"
if test -n "$unshare"; then
	# this is mainly why we unshare the mount namespace
	sudo chown root: "$dir/tmp"
	sudo chmod 1777 "$dir/tmp"
	sudo mount --bind "$dir/tmp" /tmp
	sudo mount --bind "$dir/tmp" /var/tmp
else
	# only the tools that take the temporary directory from TMPDIR put their temporary files there then
	export TMPDIR="$dir/tmp"
fi

# the files in the work directory are only made when missing, so files made with other options would end up
# in the images made with these ones: the options that change what is made are recorded there to refuse others
replace_boot_digest=
if test -n "$replace_boot"; then
	replace_boot_digest="$(sha256sum < "$replace_boot")"
fi
# absolute, since the keys are also used from other directories, such as the one the signing runs in
key_dir="$(realpath -m -- "$key_dir")"
key_dir_path="$key_dir"
options="$(declare -p os device build key_dir_path version update_url dex2oat dev_fast_sign sign_factory_images adb_root recovery_adb_root adb_keys_content adb_at_boot adb_any_key allowbackup adb_backup cross_profile_localhost always_screenshot always_screenshot_surfaceview no_location_ismock record_anything replace_boot_digest replace_boot_allow_change replace_boot_allow_new_files hosts_url magisk ro_debuggable ro_secure)"
if test -e "$dir/options" && test "$(< "$dir/options")" != "$options" && test -z "$reuse_changed_options"; then
	echo "$dir was used with other options, and what was made with them would be used in place of what these ones make:" >&2
	diff "$dir/options" <(printf '%s\n' "$options") >&2 || true
	echo "Use another work directory, or --reuse-with-changed-options once what the changed options affect is removed from it" >&2
	exit 1
fi
printf '%s\n' "$options" > "$dir/options"

# run a command in the background, for wait_background to wait for it: a function using these
# declares background_pids as local, so that it only waits for the commands it ran itself, and may
# declare background_limit as local too, so that at most that many of them run at the same time
function background
{
	local pid i status=0
	if test -n "${background_limit:-}" && test "${#background_pids[@]}" -ge "$background_limit"; then
		# the command takes the place of the first one to be done
		wait -n -p pid "${background_pids[@]}" || status=$?
		for i in "${!background_pids[@]}"; do
			if test "${background_pids[i]}" == "$pid"; then
				unset 'background_pids[i]'
			fi
		done
		# and isn't run if that one failed: the others are waited for, as wait_background does, and it fails
		if test "$status" != 0; then
			wait_background
			exit 1
		fi
	fi
	"$@" &
	background_pids+=("$!")
}

# wait for the commands run by background, failing if any of them failed, which a wait for all of them
# doesn't do: all of them are waited for even then, since killing one wouldn't stop the processes it
# started, which would go on writing into the work directory after the script is done
function wait_background
{
	local pid failed=
	for pid in "${background_pids[@]}"; do
		if ! wait "$pid"; then
			failed=1
		fi
	done
	background_pids=()
	if test -n "$failed"; then
		exit 1
	fi
}

function with_temp
{
	local path="$1"
	local mktemp="$2"
	local complete="$3"
	local func="$4"
	shift 4

	local tmp="$($mktemp "$path.XXXXXX.tmp")"
	# protect against wild rm -rf in case of mktemp being broken
	case "$tmp" in
		"$path".*)
			if test -z "$keep_tmp"; then
				trap "rm -rf -- ${tmp@Q}" EXIT
			fi
			# run outside of a condition, where bash would ignore set -e for all of it
			set +e
			( set -e; "$func" "$tmp" "$@" )
			local status="$?"
			set -e
			if test "$status" != 0; then
				echo "Failed to run: $func $tmp $@" >&2
				exit 1
			fi
			if test "$complete" == mv; then
				if ! test -e "$tmp"; then
					echo "Failed to produce output file: $func $tmp $@" >&2
					exit 1
				fi
				# which fails rather than moving the directory into one that another run made in the meantime
				mv -T "$tmp" "$path"
			elif test -n "$complete"; then
				$complete "$tmp"
			fi
			trap - EXIT
			;;
		*)
			echo "$mktemp returned unexpected path: $tmp" >&2
			exit 1
			;;
	esac
}

make_indent=
function make_any
{
	# the files shared by all the runs are made by one run at a time, for the others to wait for it and use what
	# it made rather than make them again at the same time
	if ! test -e "$1" && [[ $1 == "$var_dir"/* ]]; then
		with_lock "$1" make_any_unlocked "$@"
	else
		make_any_unlocked "$@"
	fi
}

function make_any_unlocked
{
	local path="$1"
	local mktemp="$2"
	local func="$3"
	shift 3

	if ! test -e "$path"; then
		echo "${make_indent}MAKING $path with $func" >&2
		# in microseconds, taking only the digits since the decimal separator depends on the locale
		local start="${EPOCHREALTIME//[!0-9]/}"
		make_indent="$make_indent"$'\t'
		with_temp "$path" "$mktemp" mv "$func" "$@"
		make_indent="${make_indent:0:-1}"
		local took=
		if test -n "$timing"; then
			local us="$((${EPOCHREALTIME//[!0-9]/} - start))"
			printf -v took ' in %d.%03ds' "$((us / 1000000))" "$((us % 1000000 / 1000))"
		fi
		echo "${make_indent}MADE $path with $func$took" >&2
	fi
}

function make_dir
{
	local path="$1"
	shift
	make_any "$path" "mktemp -d" "$@"
}

function make_file
{
	local path="$1"
	shift
	make_any "$path" "mktemp -u" "$@"
}

function with_temp_dir
{
	local path="$1"
	shift
	local cleanup="rm -rf"
	if test -n "$keep_tmp"; then
		cleanup=
	fi
	with_temp "$path" "mktemp -d" "$cleanup" "$@"
}

function discard
{
	echo "${make_indent}DISCARD: $@" >&2
	if test -n "$want_discard"; then
		rm -rf "$@"
	fi
}

# make a file that is about to be written in place a copy of its own, rather than one of the hard links
# that the target files share with the files extracted from the images, which would be written too
function own_file
{
	cp -a -- "$1" "$1.own"
	mv -f -- "$1.own" "$1"
}

function do_unzip
{
	unzip -q -d "$1" "$2"
}

function do_unzip_list
{
	bsdtar -tf "$2" > "$1"
}

function do_git_init
{
	git init -q --bare "$1"
}

# fetch the tag $3 of the repository at the URL $2 into the repository $4, as refs/fetched/$3, and put its files
# into $1 once it is checked to be the tag $3 signed with the key of the OS, since its files are run along with the
# keys, all while holding the lock on the repository, since another run can fetch the tag again meanwhile
function git_fetch_checkout
{
	local name
	git -C "$4" fetch -q --no-tags --force "$2" "+refs/tags/$3:refs/fetched/$3"
	# which prints the name of the tag only if it is signed with a key of the allowed signers
	if ! name="$(git -C "$4" -c gpg.ssh.allowedSignersFile="$allowed_signers" verify-tag --format='%(tag)' "refs/fetched/$3")" || test "$name" != "$3"; then
		echo "The tag $3 of $2 is not signed with the key of the OS as tag $3" >&2
		exit 1
	fi
	git -C "$4" archive "refs/fetched/$3"|tar -x -C "$1"
}

# put into $1 the files of the tag $3 of the repository at the URL $2, which is fetched into a repository with no
# checkout of its own, shared by all the runs, so that runs of different builds don't check out each other's
function do_git_checkout
{
	local repo="$var_dir/git-$os/${2##*/}.git"
	make_dir "$repo" do_git_init
	with_lock "$repo" git_fetch_checkout "$@" "$repo"
}

