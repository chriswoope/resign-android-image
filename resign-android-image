function deapexer {
	"$otatools/bin/deapexer" --blkid_path "$blkid" --debugfs_path "$debugfs" --fsckerofs_path "$fsckerofs" "$@"
}

# remove from an extracted APEX payload the files that apexer adds back itself when it builds one
function remove_apex_manifests {
	local i
	for i in apex_manifest.pb apex_manifest.json lost+found; do
		if test -d "$1/$i"; then
			rmdir "$1/$i"
		else
			rm -f "$1/$i"
		fi
